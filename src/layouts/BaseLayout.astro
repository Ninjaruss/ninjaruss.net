---
import { ClientRouter } from 'astro:transitions';
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/typography.css';
import '../styles/bento.css';
import '../styles/transitions.css';

interface Props {
  title: string;
  /** Replaces the default `${title} — ninjaruss` <title>. The homepage uses
   *  this so its tagline can lead without the site name being lost, and so the
   *  layout never has to special-case a magic title string. */
  displayTitle?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
}

const {
  title,
  displayTitle,
  description = 'ninjaruss.net – a personal site with notes, media logs, and projects',
  ogImage,
  ogType = 'website',
} = Astro.props;
const siteTitle = 'ninjaruss';
const fullTitle = displayTitle ?? `${title} — ${siteTitle}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site || 'https://ninjaruss.net');
/* Raster on purpose: X/Facebook/LinkedIn/Slack/Discord/iMessage all refuse SVG
   for og:image, so the SVG source would render as no preview image at all.
   social-default.png is generated from social-default.svg by
   `node scripts/build-og-image.mjs`. */
const resolvedOgImage = ogImage ?? '/social-default.png';
const ogImageUrl = new URL(resolvedOgImage, Astro.site || 'https://ninjaruss.net').href;
const ogImageIsRaster = /\.(png|jpe?g|webp)$/i.test(resolvedOgImage);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="alternate" type="application/rss+xml" title="Ninjaruss — Writing" href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />

    <!-- Fonts are self-hosted (public/fonts, @font-face in styles/fonts.css,
         regenerate with `node scripts/build-fonts.mjs`). They used to be served
         by Google, which meant the browser could not discover a single woff2
         URL until a render-blocking third-party stylesheet came back, and then
         had to open a connection to a *second* third-party origin to fetch
         them. Same files, same glyphs — one origin, and no round trip spent
         learning the URLs.

         Metric-matched fallback faces still live in typography.css so the
         `display: swap` does not move the layout. Syne 800 is deliberately
         absent — it is unused.

         Only the two faces that paint above the fold on every page are
         preloaded: Syne 400 (body) and Archivo Black (every heading). Other
         weights and the latin-ext subsets are left to unicode-range and normal
         discovery, so a visitor who never renders them never fetches them. -->
    <link rel="preload" href="/fonts/syne-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/archivo-black-400-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:image" content={ogImageUrl} />
    {ogImageIsRaster && <meta property="og:image:width" content="1200" />}
    {ogImageIsRaster && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={`${siteTitle} — ${description}`} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={`${siteTitle} — ${description}`} />

    <ClientRouter />
  </head>
  <body>
    <div id="cursor" aria-hidden="true" transition:persist></div>
    <canvas id="transition-canvas" aria-hidden="true" transition:persist></canvas>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <main id="main-content" class="page">
      <slot />
    </main>

    <script>
      import '../scripts/cursor';
    </script>
    <script>
      import '../scripts/transition';
    </script>
  </body>
</html>

<style is:global>
  /* Page transition smoothness. Gated on no-preference: smooth-scrolling a long
     page (the /novel desk anchors, the /shelf legacy #section-* links) is exactly
     the motion someone who asked for less motion does not want. SplitView's
     scrollIntoView calls inherit this value, so gating it here covers them too. */
  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
  }

  /* Skip to content link for accessibility */
  .skip-link {
    position: absolute;
    top: -100%;
    left: var(--space-md);
    z-index: 9999;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-sm) var(--space-md);
    background: var(--color-gold);
    color: var(--color-black);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: top 0.2s ease;
  }

  .skip-link:focus {
    top: var(--space-md);
    outline: 2px solid var(--color-gold);
    outline-offset: 2px;
  }

  /* Hold the black text through the link's only visible state — focus. Any
     generic link-colour rule would otherwise leave gold-orange on gold. */
  .skip-link:focus,
  .skip-link:focus-visible {
    color: var(--color-black);
  }

  @media (prefers-reduced-motion: reduce) {
    /* The slide-down goes; the link still moves into view on focus. */
    .skip-link {
      transition: none;
    }
  }
</style>
