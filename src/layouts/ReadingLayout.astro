---
import BaseLayout from './BaseLayout.astro';
import NavPill from '../components/NavPill.astro';
interface Props { title: string; description: string; image?: string; article?: boolean; wide?: boolean }
const { title, description, image, article, wide = false } = Astro.props;
---
<BaseLayout title={title} description={description} ogImage={image} ogType={article ? 'article' : undefined}>
  <NavPill />
  <div class:list={['reading-page', 'container', { 'reading-page--wide': wide }]}><slot /></div>
</BaseLayout>
<style is:global>
  .reading-page { max-width: 780px; padding-top: var(--space-lg); padding-bottom: calc(var(--nav-clearance, 80px) + var(--space-2xl)); overflow-wrap: anywhere; }
  .reading-page--wide { max-width: 1100px; }
  .reading-page h1 { display: block; font-size: clamp(2.2rem, 6vw, 4rem); line-height: 1.12; margin: var(--space-md) 0; }
  .reading-header { padding-bottom: var(--space-lg); margin-bottom: var(--space-xl); border-bottom: 2px solid var(--color-gold); }
  .reading-description { color: var(--color-text-muted); max-width: 58ch; line-height: 1.7; }
  .reading-page .writing-links { display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-lg); }
  .reading-page .writing-links a { min-height: 44px; display: inline-flex; align-items: center; }
  .reading-page .writing-dates { color: var(--color-text-muted); font: .85rem/1.8 var(--font-mono); margin-top: var(--space-md); }
  .reading-page .prose { font-size: 1.125rem; line-height: 1.85; }
  .reading-page .prose h2 { font-size: clamp(1.35rem, 3vw, 1.8rem); line-height: 1.35; }
  .reading-page .prose h3 { font-size: 1.2rem; line-height: 1.4; }
  .reading-page .prose :is(h2,h3) { scroll-margin-top: var(--space-xl); }
  .reading-page a:focus-visible { outline: 3px solid var(--color-gold); outline-offset: 4px; }
  .reading-neighbors { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: var(--space-lg); border-top: 1px solid var(--color-border); margin-top: var(--space-2xl); padding-top: var(--space-lg); }
  .reading-neighbors a { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; min-height: 60px; padding: var(--space-sm) 0; text-decoration: none; line-height: 1.5; }
  .reading-neighbors a span { font-size: .8rem; color: var(--color-text-muted); }
  .reading-neighbors a strong { color: var(--color-gold); font-weight: 600; }
  .reading-footer { border-top: 1px solid var(--color-border); padding-top: var(--space-lg); margin-top: var(--space-xl); }
  .reading-list { list-style: none; padding: 0; margin: 0; }
  .reading-list li { border-bottom: 1px solid var(--color-border); }
  .reading-list a { display: grid; grid-template-columns: 120px minmax(0,1fr); gap: var(--space-lg); align-items: baseline; padding: var(--space-lg) var(--space-sm); color: var(--color-text); text-decoration: none; min-height: 60px; }
  .reading-list a:hover { background: var(--color-bg-elevated); }
  .reading-list a:hover :is(h2,h3) { color: var(--color-gold); }
  .reading-list :is(h2,h3) { margin: 0; font: 1.1rem/1.45 var(--font-display); }
  .reading-list time, .reading-list .undated { color: var(--color-text-muted); font: .8rem/1.7 var(--font-mono); }
  @media (max-width:600px) {
    .reading-page { padding-top: var(--space-sm); }
    .reading-page .prose { font-size: 1.0625rem; line-height: 1.8; }
    .reading-list a { grid-template-columns: minmax(0,1fr); gap: var(--space-xs); padding-inline: 0; }
    .reading-neighbors { grid-template-columns: minmax(0,1fr); gap: var(--space-sm); }
  }
</style>
