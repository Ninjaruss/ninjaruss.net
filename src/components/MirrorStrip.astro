---
/* MirrorStrip — button-based mirror loop on /status.
   Live site: owner-only. The strip is hidden by default; a standalone MIRROR
   kicker (just a label unless you know) unlocks it — 3 taps within 2s →
   mirror-key prompt → stored in localStorage → strip reveals (per-device,
   one-time). start/done lines append to localStorage ('mirror-log', exact
   mirror-log.md line format); the owner drawer builds the DeepSeek prompt
   client-side (pure utils + quest file embedded at build time) and imports
   the reply against /api/mirror/import (Bearer mirror-key → GitHub commits).
   Dev server: always visible, no key; lines POST straight to /api/mirror/log
   (mirror-log.md) and the dev drawer drives merge-paste / copy-prompt /
   import-reply. Each drawer is conditionally rendered server-side, so
   production HTML never contains the dev one and vice versa. */
import { readFileSync } from 'fs';
import { join } from 'path';

const dev = import.meta.env.DEV;
const questRaw = readFileSync(join(process.cwd(), 'src/content/sessions/_quests.md'), 'utf-8');
/* <-escape so no quest text can ever close the JSON script block early. */
const questJson = JSON.stringify(questRaw).replace(/</g, '\\u003c');
---

{!dev && (
  <span class="mirror-unlock" id="mirror-unlock">
    <span class="p4g-tab">Mirror</span>
  </span>
)}

<section class="mirror-strip" id="mirror-strip" aria-label="Mirror session log" hidden={!dev}>
  <div class="mirror-strip__head">
    <span class="p4g-tab">Mirror</span>
    <p class="mirror-strip__msg" id="mirror-msg" aria-live="polite"></p>
  </div>

  <div class="mirror-strip__row">
    <button class="mirror-btn" id="mirror-start" type="button">▶ set intention</button>
    <button class="mirror-btn" id="mirror-done" type="button">★ session complete</button>
    <button class="mirror-btn" id="mirror-copy" type="button">⧉ copy log</button>
    <button class="mirror-btn mirror-btn--quiet" id="mirror-clear" type="button" hidden>clear log</button>
  </div>

  {dev && (
    <details class="mirror-dev">
      <summary>local mirror (dev)</summary>
      <div class="mirror-dev__body">
        <label class="mirror-dev__field">
          <span>paste phone log</span>
          <textarea id="mirror-paste-log" rows="3" placeholder="- 2026-07-29 14:00 | done | ..."></textarea>
        </label>
        <div class="mirror-dev__actions">
          <button class="mirror-btn" id="mirror-merge" type="button">merge pasted log</button>
          <button class="mirror-btn" id="mirror-prompt" type="button">⧉ copy DeepSeek prompt</button>
        </div>
        <label class="mirror-dev__field">
          <span>model reply</span>
          <textarea id="mirror-reply" rows="4" placeholder='{"sessions": [...]}'></textarea>
        </label>
        <div class="mirror-dev__actions">
          <button class="mirror-btn" id="mirror-import" type="button">import reply</button>
        </div>
        <ul class="mirror-dev__results" id="mirror-results"></ul>
      </div>
    </details>
  )}

  {!dev && (
    <details class="mirror-dev">
      <summary>mirror (owner)</summary>
      <div class="mirror-dev__body">
        <div class="mirror-dev__actions">
          <button class="mirror-btn" id="mirror-prompt-live" type="button">⧉ copy DeepSeek prompt</button>
        </div>
        <label class="mirror-dev__field">
          <span>model reply</span>
          <textarea id="mirror-reply-live" rows="4" placeholder='{"sessions": [...]}'></textarea>
        </label>
        <div class="mirror-dev__actions">
          <button class="mirror-btn" id="mirror-import-live" type="button">import reply</button>
        </div>
        <ul class="mirror-dev__results" id="mirror-results-live"></ul>
      </div>
    </details>
  )}

  <script type="application/json" id="mirror-quests" is:inline set:html={questJson}></script>

  <div class="mirror-strip__sweep" id="mirror-sweep" aria-hidden="true"></div>
</section>

<script>
  import { formatLogLine, parseLogLines, linesNotIn, type LogKind, type LogLine } from '../utils/mirror/log';
  import { buildMirrorPrompt } from '../utils/mirror/prompt';

  const IS_DEV = import.meta.env.DEV;
  const STORAGE_KEY = 'mirror-log';
  const KEY_STORAGE = 'mirror-key';
  const EXPORT_STORAGE = 'mirror-exported';

  /* localStorage wrapped in try/catch — Safari private mode throws. */
  function readItem(key: string): string {
    try { return localStorage.getItem(key) ?? ''; } catch { return ''; }
  }
  function writeItem(key: string, value: string): boolean {
    try { localStorage.setItem(key, value); return true; } catch { return false; }
  }
  function removeItem(key: string): boolean {
    try { localStorage.removeItem(key); return true; } catch { return false; }
  }
  const readLog = (): string => readItem(STORAGE_KEY);
  const writeLog = (value: string): boolean => writeItem(STORAGE_KEY, value);
  const clearLog = (): boolean => removeItem(STORAGE_KEY);

  /** Quest file text embedded at build time — the only source of quests. */
  function readQuests(): string {
    try {
      return JSON.parse(document.getElementById('mirror-quests')?.textContent ?? '""');
    } catch { return ''; }
  }

  const rawLine = (l: LogLine): string => `- ${l.ts} | ${l.kind} | ${l.text}`;

  /* WebAudio rank-up flourish — created lazily on user gesture, no asset. */
  let audioCtx: AudioContext | null = null;
  function playFlourish(): void {
    try {
      audioCtx ??= new AudioContext();
      if (audioCtx.state === 'suspended') void audioCtx.resume();
      const now = audioCtx.currentTime;
      // Short rising arpeggio: C5 → E5 → G5 over ~0.4s.
      [523.25, 659.25, 783.99].forEach((freq, i) => {
        const t = now + i * 0.11;
        const osc = audioCtx!.createOscillator();
        const gain = audioCtx!.createGain();
        osc.type = 'triangle';
        osc.frequency.value = freq;
        gain.gain.setValueAtTime(0.0001, t);
        gain.gain.exponentialRampToValueAtTime(0.12, t + 0.02);
        gain.gain.exponentialRampToValueAtTime(0.0001, t + 0.24);
        osc.connect(gain).connect(audioCtx!.destination);
        osc.start(t);
        osc.stop(t + 0.26);
      });
    } catch { /* sound is a garnish — never let it break the log */ }
  }

  function initMirrorStrip(): void {
    const strip = document.getElementById('mirror-strip');
    if (!strip || strip.dataset.mirrorBound) return;
    strip.dataset.mirrorBound = 'true';

    const msgEl = document.getElementById('mirror-msg')!;
    const clearBtn = document.getElementById('mirror-clear') as HTMLButtonElement | null;
    const sweepEl = document.getElementById('mirror-sweep');
    const setMsg = (text: string, isError = false): void => {
      msgEl.textContent = text;
      msgEl.classList.toggle('is-error', isError);
    };
    const renderList = (el: HTMLElement | null, items: string[], isError = false): void => {
      if (!el) return;
      el.textContent = '';
      for (const item of items) {
        const li = document.createElement('li');
        li.textContent = item;
        if (isError) li.classList.add('is-error');
        el.appendChild(li);
      }
    };

    function fireSweep(): void {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      strip!.classList.add('is-sweeping');
      const settle = (): void => strip!.classList.remove('is-sweeping');
      sweepEl?.addEventListener('animationend', settle, { once: true });
      // Backstop: a hidden tab freezes the animation clock and animationend
      // never fires — don't let the class linger past the sweep's lifetime.
      setTimeout(settle, 1000);
    }

    async function logLine(kind: LogKind): Promise<void> {
      const raw = window.prompt(kind === 'start' ? 'Intention for this session?' : 'What did you do?');
      const text = raw?.trim();
      if (!text) return;

      // Celebration cues fire on the gesture itself — the write is bookkeeping.
      if (kind === 'done') { playFlourish(); fireSweep(); }
      const successMsg = kind === 'done' ? '★ recorded. celebrate for real.' : '▶ intention set. go.';

      if (IS_DEV) {
        try {
          const res = await fetch('/api/mirror/log', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ kind, text }),
          });
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          setMsg(successMsg);
          return;
        } catch {
          const line = formatLogLine(kind, text, new Date());
          const saved = writeLog(readLog() + line + '\n');
          setMsg(saved
            ? 'dev api unreachable — saved to localStorage instead.'
            : 'dev api unreachable and localStorage failed. line lost.', !saved);
          return;
        }
      }

      const line = formatLogLine(kind, text, new Date());
      if (writeLog(readLog() + line + '\n')) setMsg(successMsg);
      else setMsg('could not save — localStorage unavailable.', true);
    }

    async function copyLog(): Promise<void> {
      const log = readLog();
      const count = log.split('\n').filter(l => l.trim()).length;
      if (count === 0) { setMsg('log is empty — nothing to copy.'); return; }
      try {
        await navigator.clipboard.writeText(log);
        setMsg(`⧉ ${count} line${count === 1 ? '' : 's'} on clipboard.`);
        if (clearBtn) clearBtn.hidden = false;
      } catch {
        setMsg('clipboard blocked — copy from localStorage manually.', true);
      }
    }

    document.getElementById('mirror-start')?.addEventListener('click', () => void logLine('start'));
    document.getElementById('mirror-done')?.addEventListener('click', () => void logLine('done'));
    document.getElementById('mirror-copy')?.addEventListener('click', () => void copyLog());
    clearBtn?.addEventListener('click', () => {
      if (!window.confirm('Clear the local mirror log? Only do this after the lines are safely merged.')) return;
      clearLog();
      clearBtn.hidden = true;
      setMsg('log cleared.');
    });

    /* Dev-only panel — these elements exist only when import.meta.env.DEV,
       and this whole block is compiled out of the production bundle. */
    if (IS_DEV) {
      const pasteEl = document.getElementById('mirror-paste-log') as HTMLTextAreaElement | null;
      const replyEl = document.getElementById('mirror-reply') as HTMLTextAreaElement | null;
      const resultsEl = document.getElementById('mirror-results');

      const renderResults = (items: string[], isError = false): void =>
        renderList(resultsEl, items, isError);

      document.getElementById('mirror-merge')?.addEventListener('click', async () => {
        const paste = pasteEl?.value ?? '';
        if (!paste.trim()) { setMsg('paste some log lines first.'); return; }
        try {
          const res = await fetch('/api/mirror/log', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ paste }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error ?? `HTTP ${res.status}`);
          setMsg(`merged ${data.added} new line${data.added === 1 ? '' : 's'}.`);
          if (data.added > 0 && pasteEl) pasteEl.value = '';
        } catch (e) {
          setMsg(`merge failed: ${e instanceof Error ? e.message : 'unknown error'}`, true);
        }
      });

      document.getElementById('mirror-prompt')?.addEventListener('click', async () => {
        try {
          const res = await fetch('/api/mirror/export');
          const data = await res.json();
          if (!data.ok) { setMsg(data.error ?? 'export failed.', true); return; }
          await navigator.clipboard.writeText(data.prompt);
          setMsg(`prompt on clipboard (${data.lineCount} lines) — paste into DeepSeek.`);
        } catch (e) {
          setMsg(`export failed: ${e instanceof Error ? e.message : 'unknown error'}`, true);
        }
      });

      document.getElementById('mirror-import')?.addEventListener('click', async () => {
        const text = replyEl?.value ?? '';
        if (!text.trim()) { setMsg('paste the model reply first.'); return; }
        try {
          const res = await fetch('/api/mirror/import', { method: 'POST', body: text });
          const outcome = await res.json();
          if (outcome.ok) {
            setMsg(`✓ wrote ${outcome.written.length} session(s) — review with git diff.`);
            renderResults(outcome.written.map((f: string) => `src/content/sessions/${f}`));
            if (replyEl) replyEl.value = '';
          } else {
            setMsg('import rejected — nothing written.', true);
            renderResults([...outcome.warnings, ...outcome.errors], true);
          }
        } catch (e) {
          setMsg(`import failed: ${e instanceof Error ? e.message : 'unknown error'}`, true);
        }
      });
    }

    /* Prod-only: unlock gate + owner drawer. Compiled out of the dev bundle;
       the matching elements exist only when !import.meta.env.DEV. */
    if (!IS_DEV) {
      const unlockEl = document.getElementById('mirror-unlock');
      const reveal = (): void => {
        strip.hidden = false;
        if (unlockEl) unlockEl.hidden = true;
      };
      if (readItem(KEY_STORAGE)) reveal();

      /* 3 taps on a MIRROR kicker within 2s → key prompt. Bound to both the
         standalone label (locked state) and the strip's own kicker (re-enter
         after a wrong key) — a plain label to anyone who doesn't know. */
      let taps: number[] = [];
      const onKickerTap = (): void => {
        const now = Date.now();
        taps = taps.filter(t => now - t < 2000);
        taps.push(now);
        if (taps.length < 3) return;
        taps = [];
        const entered = window.prompt('mirror key')?.trim();
        if (!entered) return;
        if (!writeItem(KEY_STORAGE, entered)) {
          setMsg('could not store the key — localStorage unavailable.', true);
          return;
        }
        reveal();
      };
      unlockEl?.addEventListener('click', onKickerTap);
      strip.querySelector('.mirror-strip__head .p4g-tab')?.addEventListener('click', onKickerTap);

      const replyEl = document.getElementById('mirror-reply-live') as HTMLTextAreaElement | null;
      const resultsEl = document.getElementById('mirror-results-live');

      document.getElementById('mirror-prompt-live')?.addEventListener('click', async () => {
        const lines = parseLogLines(readLog());
        if (!lines.some(l => l.kind === 'done')) {
          setMsg('no completed sessions in the log yet — nothing to reflect.');
          return;
        }
        // Snapshot BEFORE the clipboard: the import step consumes exactly
        // these lines, so the handoff must be recorded even if copy fails.
        const snapshot = lines.map(rawLine).join('\n') + '\n';
        if (!writeItem(EXPORT_STORAGE, snapshot)) {
          setMsg('could not snapshot the export — localStorage unavailable.', true);
          return;
        }
        const prompt = buildMirrorPrompt(lines, readQuests());
        try {
          await navigator.clipboard.writeText(prompt);
          setMsg(`prompt on clipboard (${lines.length} line${lines.length === 1 ? '' : 's'}) — paste into DeepSeek.`);
        } catch {
          setMsg('clipboard blocked — lines snapshotted; try copying again.', true);
        }
      });

      document.getElementById('mirror-import-live')?.addEventListener('click', async () => {
        const text = replyEl?.value ?? '';
        if (!text.trim()) { setMsg('paste the model reply first.'); return; }
        try {
          const res = await fetch('/api/mirror/import', {
            method: 'POST',
            headers: { Authorization: `Bearer ${readItem(KEY_STORAGE)}` },
            body: text,
          });
          if (res.status === 401) {
            removeItem(KEY_STORAGE);
            setMsg('wrong key — tap MIRROR ×3 to re-enter', true);
            return;
          }
          const outcome = await res.json().catch(() => ({}));
          if (res.ok && outcome.ok) {
            // Consume exactly the exported snapshot — lines logged since the
            // copy survive in the local log, same semantics as fsOps.
            const remaining = linesNotIn(readLog(), readItem(EXPORT_STORAGE)).map(rawLine);
            if (remaining.length > 0) writeLog(remaining.join('\n') + '\n');
            else clearLog();
            removeItem(EXPORT_STORAGE);
            if (replyEl) replyEl.value = '';
            renderList(resultsEl, outcome.written.map((f: string) => `src/content/sessions/${f}`));
            setMsg('committed — site rebuilds in ~a minute.');
            return;
          }
          const problems = [
            ...(outcome.warnings ?? []),
            ...(outcome.errors ?? []),
            ...(outcome.error ? [String(outcome.error)] : []),
          ];
          if (res.status === 400) {
            setMsg('import rejected — nothing committed.', true);
          } else if (res.status === 502) {
            // Each session is its own commit, so earlier files may already be
            // committed — the raw error below says which write failed.
            setMsg('import failed mid-write — some sessions may have committed. error below.', true);
          } else {
            setMsg(`import failed (HTTP ${res.status}).`, true);
          }
          renderList(resultsEl, problems.length > 0 ? problems : [`HTTP ${res.status}`], true);
        } catch (e) {
          setMsg(`import failed: ${e instanceof Error ? e.message : 'unknown error'}`, true);
        }
      });
    }
  }

  initMirrorStrip();
  document.addEventListener('astro:page-load', initMirrorStrip);
</script>

<style>
  /* Standalone MIRROR kicker — the locked state's only trace. Reads as a
     plain section label: no cursor change, no focus ring, no hint. The
     transparent padding quietly gives the 3-tap gesture a 44px target
     (the hit area lives on this wrapper because .p4g-tab's clip-path
     would clip an expanded pseudo-element). */
  /* display declarations beat the UA [hidden] style — restate it, or the
     locked strip (and the spent unlock label) would render anyway. */
  .mirror-unlock[hidden],
  .mirror-strip[hidden] { display: none; }

  .mirror-unlock {
    display: inline-block;
    padding: 12px;
    margin: 2px 16px 0;
    -webkit-user-select: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  /* Quiet tool row in the mail-strip family — dark panel, gold hairline,
     left gold spine, corner-cut buttons. Sits under the objective strip. */
  .mirror-strip {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex-shrink: 0;
    margin: 14px 28px 0;
    padding: 12px 18px 14px;
    border: 1px solid rgba(255, 229, 44, 0.14);
    border-left: 3px solid var(--color-gold, #ffe52c);
    border-radius: var(--radius-sm, 3px);
    background: rgba(255, 229, 44, 0.03);
  }

  .mirror-strip__head {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 22px;
  }

  .mirror-strip__msg {
    margin: 0;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--color-gold-dim, #d4b82a);
  }
  .mirror-strip__msg.is-error { color: var(--color-live, #ff4040); }

  .mirror-strip__row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  /* Menu-command buttons: angular gold outline, gold-fill hover.
     clip-path would eat an outline ring, so (per the logo-tile precedent)
     the focus-visible treatment IS the gold fill — full hover parity. */
  .mirror-btn {
    min-height: 44px;
    padding: 8px 18px 8px 14px;
    border: 1px solid rgba(255, 229, 44, 0.55);
    background: rgba(10, 10, 16, 0.85);
    color: var(--color-gold, #ffe52c);
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    clip-path: polygon(0 0, 100% 0, calc(100% - var(--cut-sm, 6px)) 100%, 0 100%);
    outline: none;
    transition:
      background var(--animation-fast, 200ms) var(--animation-easing),
      color var(--animation-fast, 200ms) var(--animation-easing),
      border-color var(--animation-fast, 200ms) var(--animation-easing);
  }
  .mirror-btn:hover,
  .mirror-btn:focus-visible {
    background: var(--color-gold, #ffe52c);
    border-color: var(--color-gold, #ffe52c);
    color: var(--color-black, #0a0a0a);
  }

  .mirror-btn--quiet {
    border-color: rgba(255, 255, 255, 0.2);
    color: #8f8f8f;
  }
  .mirror-btn--quiet:hover,
  .mirror-btn--quiet:focus-visible {
    background: var(--color-live, #ff4040);
    border-color: var(--color-live, #ff4040);
    color: #fff;
  }

  /* Gold sweep — same family as .latest-tile__sweep: a skewed gold panel
     crossing the strip once when a session completes. */
  .mirror-strip__sweep {
    position: absolute;
    inset: -2px -12%;
    background: var(--color-gold, #ffe52c);
    transform: translateX(-120%) skewX(var(--skew-accent, -12deg));
    pointer-events: none;
    z-index: 2;
  }
  .mirror-strip.is-sweeping .mirror-strip__sweep {
    animation: mirror-sweep 600ms var(--animation-easing, cubic-bezier(0.16, 1, 0.3, 1)) forwards;
  }
  @keyframes mirror-sweep {
    from { transform: translateX(-120%) skewX(var(--skew-accent, -12deg)); }
    to   { transform: translateX(120%)  skewX(var(--skew-accent, -12deg)); }
  }

  /* Dev panel — quieter still; a workbench drawer, not part of the show. */
  .mirror-dev {
    border-top: 1px solid rgba(255, 229, 44, 0.12);
    padding-top: 8px;
  }
  .mirror-dev summary {
    cursor: pointer;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #8f8f8f;
  }
  .mirror-dev summary:hover,
  .mirror-dev summary:focus-visible { color: var(--color-gold, #ffe52c); }

  .mirror-dev__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 10px;
  }
  .mirror-dev__field {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8f8f8f;
  }
  .mirror-dev__field textarea {
    resize: vertical;
    padding: 8px 10px;
    border: 1px solid rgba(255, 229, 44, 0.18);
    border-radius: var(--radius-sm, 3px);
    background: #080810;
    color: var(--color-text, #f5f5f5);
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.74rem;
    line-height: 1.5;
  }
  .mirror-dev__field textarea:focus-visible {
    outline: 2px solid var(--color-gold, #ffe52c);
    outline-offset: 1px;
  }
  .mirror-dev__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .mirror-dev__results {
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.72rem;
    color: var(--color-gold-dim, #d4b82a);
  }
  .mirror-dev__results li { padding: 2px 0; }
  .mirror-dev__results li.is-error { color: var(--color-live, #ff4040); }

  @media (max-width: 480px) {
    .mirror-strip { margin: 14px 16px 0; }
    .mirror-strip__row { flex-direction: column; align-items: stretch; }
    .mirror-btn { text-align: left; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mirror-strip.is-sweeping .mirror-strip__sweep { animation: none; }
    .mirror-btn { transition: none; }
  }
</style>
