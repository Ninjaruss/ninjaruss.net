---
interface Props {
  backLink?: string;
  backLabel?: string;
}

interface NavSection {
  href: string;
  label: string;
  /** Path prefixes that mark this item current. */
  match: string[];
}

const { backLink, backLabel } = Astro.props;
const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';

/* Primary navigation introduces the person; creative work stays on Home/About. */
const SECTIONS: NavSection[] = [
  { href: '/', label: 'Home', match: ['/'] },
  { href: '/life', label: 'About', match: ['/life'] },
  { href: '/now', label: 'Now', match: ['/now'] },
  { href: '/shelf', label: 'Shelf', match: ['/shelf'] },
];

/* Keep the mobile location label accurate on destinations outside the main menu. */
const currentSection = [
  ...SECTIONS,
  { label: 'Projects', match: ['/showcase'] },
  { label: 'Remember Rain', match: ['/novel'] },
  { label: 'Guestbook', match: ['/traces'] },
  { label: 'Japanese journal', match: ['/japanese-journal'] },
].find(section => section.match.some(path => path !== '/' && (currentPath === path || currentPath.startsWith(`${path}/`))))?.label ?? 'Explore';

const isActive = (section: NavSection) =>
  section.href === '/'
    ? isHome
    : section.match.some(m => currentPath === m || currentPath.startsWith(`${m}/`));
---

{!isHome && (
  <nav class="nav-bar" aria-label="Site sections">
    <div class="nav-bar__shadow nav-bar__desktop">
      <div class="nav-bar__inner">
        {SECTIONS.map(section => (
          <a
            href={section.href}
            class:list={['nav-bar__item', { 'nav-bar__item--active': isActive(section) }]}
            aria-current={isActive(section) ? 'page' : undefined}
          >
            <span class="nav-bar__text">{section.label}</span>
          </a>
        ))}
        {backLink && backLabel && (
          <a href={backLink} class="nav-bar__item nav-bar__back">
            <span class="nav-bar__text">&larr; {backLabel}</span>
          </a>
        )}
      </div>
    </div>
    <details class="nav-bar__mobile">
      <summary><span>{currentSection}</span><span class="nav-bar__menu-label">Menu <span aria-hidden="true">☰</span></span></summary>
      <div class="nav-bar__menu">
        {SECTIONS.map(section => (
          <a href={section.href} class:list={['nav-bar__item', { 'nav-bar__item--active': isActive(section) }]} aria-current={isActive(section) ? 'page' : undefined}>
            <span class="nav-bar__text">{section.label}</span>
          </a>
        ))}
        {backLink && backLabel && <a href={backLink} class="nav-bar__item nav-bar__back">← {backLabel}</a>}
      </div>
    </details>
  </nav>
)}

<style>
  .nav-bar {
    position: fixed;
    bottom: var(--space-md);
    left: var(--space-md);
    z-index: 100;
  }

  /* clip-path clips box-shadow — hard gold shadow lives on a drop-shadow wrapper */
  .nav-bar__shadow {
    filter: drop-shadow(4px 4px 0 rgba(var(--color-gold-rgb), 0.3));
  }

  .nav-bar__inner {
    display: flex;
    align-items: stretch;
    background: var(--color-black);
    border: var(--border-medium) solid var(--color-gold);
    clip-path: polygon(
      var(--cut-md) 0,
      100% 0,
      100% calc(100% - var(--cut-md)),
      calc(100% - var(--cut-md)) 100%,
      0 100%,
      0 var(--cut-md)
    );
  }

  .nav-bar__item {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: var(--space-xs) var(--space-md);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-text-muted);
    text-decoration: none;
    overflow: hidden;
    transition: color var(--transition-fast);
  }

  .nav-bar__item + .nav-bar__item {
    border-left: 1px solid rgba(var(--color-gold-rgb), 0.18);
  }

  .nav-bar__text {
    position: relative;
    z-index: 1;
    display: inline-block;
    transform: skewX(var(--skew-display));
    white-space: nowrap;
  }

  /* P4G diagonal gold sweep on hover/focus */
  .nav-bar__item::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-gold);
    transform: translateX(-110%) skewX(var(--skew-accent));
    transition: transform var(--animation-fast) var(--animation-easing);
  }

  .nav-bar__item:hover,
  .nav-bar__item:focus-visible {
    color: var(--color-black);
  }

  .nav-bar__item:hover::before,
  .nav-bar__item:focus-visible::before {
    transform: translateX(0) skewX(0deg);
  }

  /* offset -2px draws the ring INSIDE the border box. On the active item that
     box is already --color-gold, so a gold ring measured 1.00:1 and the current
     page had no perceivable focus indicator at all (its sweep is disabled below
     and its text is already black). Black reads 16.5:1 on the gold fill and
     ~19:1 on the black fill of every other item. */
  .nav-bar__item:focus-visible {
    outline: 2px solid var(--color-black);
    outline-offset: -2px;
  }

  .nav-bar__item--active:focus-visible {
    outline-color: var(--color-black);
  }

  /* Current section — solid gold command */
  .nav-bar__item--active {
    background: var(--color-gold);
    color: var(--color-black);
  }

  .nav-bar__item--active::before {
    display: none;
  }

  .nav-bar__back {
    color: var(--color-gold);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-bar__item::before {
      transition: none;
    }
  }

  .nav-bar__mobile { display: none; }

  @media (max-width: 1200px) {
    .nav-bar { left: var(--space-sm); right: var(--space-sm); bottom: var(--space-sm); }
    .nav-bar__desktop { display: none; }
    .nav-bar__mobile { display: block; position: relative; background: var(--color-black); border: var(--border-medium) solid var(--color-gold); box-shadow: var(--shadow-hard-sm); }
    .nav-bar__mobile summary { display: flex; align-items: center; justify-content: space-between; gap: var(--space-md); min-height: 48px; padding: var(--space-sm) var(--space-md); cursor: pointer; color: var(--color-text); font-family: var(--font-display); list-style: none; }
    .nav-bar__mobile summary::-webkit-details-marker { display: none; }
    .nav-bar__menu-label { color: var(--color-gold); white-space: nowrap; }
    .nav-bar__mobile summary:focus-visible { outline: 3px solid var(--color-gold); outline-offset: -5px; }
    .nav-bar__menu { position: absolute; bottom: calc(100% + 8px); left: -2px; right: -2px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; max-height: 65dvh; overflow-y: auto; background: var(--color-border-strong); border: var(--border-medium) solid var(--color-gold); }
    .nav-bar__item { background: var(--color-black); min-height: 48px; padding: var(--space-sm); }
    .nav-bar__item + .nav-bar__item { border-left: none; }
    .nav-bar__text { white-space: normal; text-align: center; line-height: 1.4; }
    .nav-bar__item--active { background: var(--color-gold); }
    .nav-bar__back { grid-column: 1 / -1; }
  }
</style>

<script>
  function initNavigation() {
    const nav = document.querySelector<HTMLElement>('.nav-bar');
    const menu = nav?.querySelector<HTMLDetailsElement>('details');
    const updateClearance = () => document.documentElement.style.setProperty('--nav-clearance', `${nav ? nav.offsetHeight + 16 : 0}px`);
    updateClearance();
    const observer = new ResizeObserver(updateClearance);
    if (nav) observer.observe(nav);
    const controller = new AbortController();
    const { signal } = controller;
    menu?.addEventListener('click', event => {
      if ((event.target as HTMLElement).closest('a')) menu.open = false;
    }, { signal });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && menu?.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    }, { signal });
    document.addEventListener('click', event => {
      if (menu?.open && !nav?.contains(event.target as Node)) menu.open = false;
    }, { signal });
    document.addEventListener('astro:before-swap', () => { observer.disconnect(); controller.abort(); }, { once: true });
  }
  document.addEventListener('astro:page-load', initNavigation);
</script>
