---
import { SUBSTACK_URL } from '../utils/substack';

interface Props {
  backLink?: string;
  backLabel?: string;
}

interface NavSection {
  href: string;
  label: string;
  /** Path prefixes that mark this item current. Empty for off-site items. */
  match: string[];
  /** Off-site: opens in a new tab and never takes the active state. */
  external?: boolean;
}

const { backLink, backLabel } = Astro.props;
const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';

/* Labels match what each destination calls itself — the nav used to say "VN"
   while the page, its h1 and the homepage tile all said something else, and the
   string "VN" appeared nowhere on the page it pointed to. Keep these in sync with
   the homepage tile labels in index.astro. */
const SECTIONS: NavSection[] = [
  { href: '/', label: 'Home', match: ['/'] },
  { href: '/showcase', label: 'Showcase', match: ['/showcase'] },
  { href: '/novel', label: 'Visual Novel', match: ['/novel'] },
  { href: '/shelf', label: 'Shelf', match: ['/shelf'] },
  { href: '/about', label: 'About', match: ['/about'] },
  { href: '/now', label: 'Now', match: ['/now'] },
  /* Traces was reachable from exactly one link on one page — the homepage bar —
     and that link canceld its own default action for JS users, so the
     server-rendered guestbook could not be reached by a plain click from
     anywhere. It is a site section; it belongs here. */
  { href: '/traces', label: 'Traces', match: ['/traces'] },
  /* Writing lives on Substack, so this is the one off-site item. Without it the
     prose — the point of the site — had no route from /showcase, /shelf or
     /novel, which linked to it zero times. */
  { href: SUBSTACK_URL, label: 'Writing', match: [], external: true },
];

const isActive = (section: NavSection) =>
  section.href === '/'
    ? isHome
    : section.match.some(m => currentPath === m || currentPath.startsWith(`${m}/`));
---

{!isHome && (
  <nav class="nav-bar" aria-label="Site sections">
    <div class="nav-bar__shadow">
      <div class="nav-bar__inner">
        {SECTIONS.map(section => (
          <a
            href={section.href}
            class:list={['nav-bar__item', { 'nav-bar__item--active': isActive(section) }]}
            aria-current={isActive(section) ? 'page' : undefined}
            target={section.external ? '_blank' : undefined}
            rel={section.external ? 'noopener noreferrer' : undefined}
            aria-label={section.external ? `${section.label} — opens Substack in a new tab` : undefined}
          >
            <span class="nav-bar__text">{section.label}</span>
          </a>
        ))}
        {backLink && backLabel && (
          <a href={backLink} class="nav-bar__item nav-bar__back">
            <span class="nav-bar__text">&larr; {backLabel}</span>
          </a>
        )}
      </div>
    </div>
  </nav>
)}

<style>
  .nav-bar {
    position: fixed;
    bottom: var(--space-md);
    left: var(--space-md);
    z-index: 100;
  }

  /* clip-path clips box-shadow — hard gold shadow lives on a drop-shadow wrapper */
  .nav-bar__shadow {
    filter: drop-shadow(4px 4px 0 rgba(var(--color-gold-rgb), 0.3));
  }

  .nav-bar__inner {
    display: flex;
    align-items: stretch;
    background: var(--color-black);
    border: var(--border-medium) solid var(--color-gold);
    clip-path: polygon(
      var(--cut-md) 0,
      100% 0,
      100% calc(100% - var(--cut-md)),
      calc(100% - var(--cut-md)) 100%,
      0 100%,
      0 var(--cut-md)
    );
  }

  .nav-bar__item {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: var(--space-xs) var(--space-md);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-text-muted);
    text-decoration: none;
    overflow: hidden;
    transition: color var(--transition-fast);
  }

  .nav-bar__item + .nav-bar__item {
    border-left: 1px solid rgba(var(--color-gold-rgb), 0.18);
  }

  .nav-bar__text {
    position: relative;
    z-index: 1;
    display: inline-block;
    transform: skewX(var(--skew-display));
    white-space: nowrap;
  }

  /* P4G diagonal gold sweep on hover/focus */
  .nav-bar__item::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-gold);
    transform: translateX(-110%) skewX(var(--skew-accent));
    transition: transform var(--animation-fast) var(--animation-easing);
  }

  .nav-bar__item:hover,
  .nav-bar__item:focus-visible {
    color: var(--color-black);
  }

  .nav-bar__item:hover::before,
  .nav-bar__item:focus-visible::before {
    transform: translateX(0) skewX(0deg);
  }

  /* offset -2px draws the ring INSIDE the border box. On the active item that
     box is already --color-gold, so a gold ring measured 1.00:1 and the current
     page had no perceivable focus indicator at all (its sweep is disabled below
     and its text is already black). Black reads 16.5:1 on the gold fill and
     ~19:1 on the black fill of every other item. */
  .nav-bar__item:focus-visible {
    outline: 2px solid var(--color-black);
    outline-offset: -2px;
  }

  .nav-bar__item--active:focus-visible {
    outline-color: var(--color-black);
  }

  /* Current section — solid gold command */
  .nav-bar__item--active {
    background: var(--color-gold);
    color: var(--color-black);
  }

  .nav-bar__item--active::before {
    display: none;
  }

  .nav-bar__back {
    color: var(--color-gold);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-bar__item::before {
      transition: none;
    }
  }

  /* Wrap below the small-desktop step, not just below tablet. The bar carries
     eight items now (the seven site sections plus Writing, which points at
     Substack) and "Visual Novel" is a wide label; unwrapped it measures roughly
     900px, so at a 769–900px viewport it would have run off the right edge —
     it is `position: fixed; left: …` with no max-width. Wrapping is also what
     the layout already does at this step everywhere else (the bento grid drops
     to 4 columns at 1024px). --nav-clearance is measured, not assumed, so the
     taller bar cannot cover page content. */
  @media (max-width: 1024px) {
    .nav-bar {
      left: var(--space-sm);
      right: var(--space-sm);
      bottom: var(--space-sm);
    }

    /* Wrapped rows: gap + gold-tinted inner background paints hairlines
       between rows and columns without per-item border bookkeeping */
    .nav-bar__inner {
      flex-wrap: wrap;
      gap: 1px;
      background: rgba(var(--color-gold-rgb), 0.18);
    }

    .nav-bar__item {
      flex: 1 1 24%;
      min-height: 44px;
      padding: var(--space-xs) var(--space-2xs);
      font-size: 0.7rem; /* was 0.6rem (~9.6px) — too small for the primary nav */
      background: var(--color-black);
    }

    .nav-bar__item + .nav-bar__item {
      border-left: none;
    }

    .nav-bar__item--active {
      background: var(--color-gold);
    }

    /* The back link carries a folder title, which never fits a quarter-width
       cell (it was clipped mid-word); give it a row of its own. */
    .nav-bar__back {
      flex: 1 0 100%;
    }
  }
</style>

<script>
  // Publishes the nav's real height so pages can pad their bottom edge —
  // the two-row mobile bar must never cover content.
  function setNavClearance() {
    const nav = document.querySelector<HTMLElement>('.nav-bar');
    const clearance = nav ? nav.offsetHeight + 16 : 0;
    document.documentElement.style.setProperty('--nav-clearance', `${clearance}px`);
  }
  setNavClearance();
  document.addEventListener('astro:page-load', setNavClearance);
  window.addEventListener('resize', setNavClearance);
</script>
