---
import { getCollection } from 'astro:content';
import ReadingLayout from '../../layouts/ReadingLayout.astro';
import { formatDate } from '../../utils/dates';
const posts = (await getCollection('now', ({ data }) => !data.draft))
  .sort((a,b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---
<ReadingLayout title="Now archive" description="Past snapshots of what I was focused on.">
  <header class="reading-header">
    <span class="p4g-tab">Now</span>
    <h1 class="p4g-heading">Past updates</h1>
    <p class="reading-description">Past snapshots of what I was focused on.</p>
    <nav class="writing-links" aria-label="Now navigation"><a href="/now">← Current update</a></nav>
  </header>
  <ol class="reading-list" aria-label="Now updates, newest first">
    {posts.map((post,index) => <li><a href={index === 0 ? '/now' : `/now/${post.slug}`}>
      <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
      <div><h2>{post.data.title}</h2>{index === 0 && <span class="current-label">Current</span>}</div>
    </a></li>)}
  </ol>
</ReadingLayout>
<style>
  .current-label { display: inline-block; font: .75rem var(--font-mono); margin-top: var(--space-xs); color: var(--color-gold); }
</style>
