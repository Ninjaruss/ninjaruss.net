---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NavPill from '../components/NavPill.astro';
import EntryBody from '../components/EntryBody.astro';

// This practice journal stays on the site; essays retain their Substack routes.
const journal = await getEntry('notes', 'jp-journal');
if (!journal) throw new Error('Japanese journal content is missing');
const { Content } = await journal.render();
const latestEntry = [...journal.body.matchAll(/^##\s+(\d{4}-\d{2}-\d{2})\s*$/gm)].at(-1)?.[1];
---

<BaseLayout title={journal.data.title} description="Small entries as I learn Japanese.">
  <NavPill />
  <article class="container japanese-journal-page">
    <header class="entry__header">
      <h1 class="entry__title"><span class="p4g-heading">{journal.data.title}</span></h1>
      <span class="p4g-underline" aria-hidden="true"></span>
      <p>Small entries as I learn Japanese. This is practice, mistakes included.</p>
      {latestEntry && <a class="journal-latest" href={`#${latestEntry}`}>Jump to the latest entry ↓</a>}
    </header>
    <EntryBody hasContent={true}>
      <div lang="ja"><Content /></div>
    </EntryBody>
  </article>
</BaseLayout>

<style>
  .japanese-journal-page { max-width: 800px; padding-bottom: calc(var(--nav-clearance, 80px) + var(--space-xl)); }
  .journal-latest { display: inline-flex; align-items: center; min-height: 44px; color: var(--color-gold); }
  .japanese-journal-page :global(h2) { scroll-margin-top: var(--space-lg); }
</style>
