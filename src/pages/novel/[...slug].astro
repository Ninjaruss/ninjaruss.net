---
import { join } from 'path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NavPill from '../../components/NavPill.astro';
import {
  buildNovelTree,
  computeNovelStats,
  countWords,
  flattenFolderFiles,
  findRecentFiles,
  findFirstScene,
  STORY_FOLDER_SLUG,
} from '../../utils/novel';
import type { NovelFile, NovelFolder, NovelTree } from '../../utils/novel';
import { formatDate } from '../../utils/dates';

type View = 'desk' | 'folder' | 'file';

interface Props {
  view: View;
  tree: NovelTree;
  topSlug?: string;
  filePath?: string;
}

export async function getStaticPaths() {
  const novelDir = join(process.cwd(), 'src/content/novel');
  const tree = await buildNovelTree(novelDir);

  const paths: Array<{ params: { slug: string | undefined }; props: Props }> = [
    { params: { slug: undefined }, props: { view: 'desk', tree } },
  ];

  function walk(top: NovelFolder, folder: NovelFolder, prefix: string): void {
    // Folder URLs (top-level and intermediate) all render the top-level folder page
    paths.push({ params: { slug: prefix }, props: { view: 'folder', tree, topSlug: top.slug } });
    for (const file of folder.files) {
      paths.push({
        params: { slug: `${prefix}/${file.slug}` },
        props: { view: 'file', tree, topSlug: top.slug, filePath: file.path.join('/') },
      });
    }
    for (const sub of Object.values(folder.subfolders)) {
      walk(top, sub, `${prefix}/${sub.slug}`);
    }
  }
  for (const top of Object.values(tree)) walk(top, top, top.slug);

  return paths;
}

const { view, tree, topSlug, filePath } = Astro.props;

// Folder URLs stay build-stable but the desk is the only index now —
// send them to the matching desk anchor.
if (view === 'folder' && topSlug) {
  return Astro.redirect(`/novel#${topSlug}`, 301);
}

// ── Shared helpers ─────────────────────────────────────────────────────
function editedLabel(f: NovelFile): string {
  if (f.modified) return f.modified;
  if (f.mtime) return formatDate(new Date(f.mtime));
  return '';
}

function fileUrl(f: NovelFile): string {
  return `/novel/${f.path.join('/')}`;
}

function folderHasContent(f: NovelFolder): boolean {
  return flattenFolderFiles(f).length > 0;
}

// ── Desk data ──────────────────────────────────────────────────────────
const stats = view === 'desk' ? computeNovelStats(tree) : null;
const latestScene = view === 'desk' ? (findRecentFiles(tree, { scenes: true, limit: 1 })[0] ?? null) : null;
const firstScene = view === 'desk' ? findFirstScene(tree) : null;

// Script — chapter-select data (manuscript only). Scene numbers run
// continuously in reading order (same order as the prev/next page-turn).
interface SceneRow { file: NovelFile; num: string; words: number; isLatest: boolean; }
interface ArcGroup { title: string | null; words: number; rows: SceneRow[]; }
const manuscriptFolder = view === 'desk' ? (tree[STORY_FOLDER_SLUG] ?? null) : null;
const latestScenePath = latestScene ? latestScene.path.join('/') : '';
let sceneCounter = 0;
const scriptArcs: ArcGroup[] = manuscriptFolder
  ? [
      ...(manuscriptFolder.files.length > 0
        ? [{ title: null as string | null, files: manuscriptFolder.files }]
        : []),
      ...Object.values(manuscriptFolder.subfolders)
        .filter(folderHasContent)
        .map((sub) => ({ title: sub.title as string | null, files: flattenFolderFiles(sub) })),
    ].map(({ title, files }) => {
      const rows = files.map((f) => ({
        file: f,
        num: String(++sceneCounter).padStart(2, '0'),
        words: countWords(f.body),
        isLatest: f.path.join('/') === latestScenePath,
      }));
      return { title, words: rows.reduce((sum, r) => sum + r.words, 0), rows };
    })
  : [];

// Binder — the outline folders (everything but the manuscript)
interface IndexSub { title: string; files: NovelFile[]; }
interface IndexGroup { slug: string; title: string; rootFiles: NovelFile[]; subs: IndexSub[]; }
const binderGroups: IndexGroup[] = view === 'desk'
  ? Object.values(tree)
      .filter((f) => f.slug !== STORY_FOLDER_SLUG)
      .filter(folderHasContent)
      .map((f) => ({
        slug: f.slug,
        title: f.title,
        rootFiles: f.files,
        subs: Object.values(f.subfolders)
          .filter(folderHasContent)
          .map((sub) => ({ title: sub.title, files: flattenFolderFiles(sub) })),
      }))
  : [];

// ── File data ──────────────────────────────────────────────────────────
const topFolder: NovelFolder | null = topSlug ? (tree[topSlug] ?? null) : null;

let file: NovelFile | null = null;
let prevFile: NovelFile | null = null;
let nextFile: NovelFile | null = null;
let crumbTitles: string[] = [];
if (view === 'file' && topFolder && filePath) {
  const siblings = flattenFolderFiles(topFolder);
  const idx = siblings.findIndex((f) => f.path.join('/') === filePath);
  file = siblings[idx] ?? null;
  prevFile = siblings[idx - 1] ?? null;
  nextFile = siblings[idx + 1] ?? null;
  // Walk folder titles along the file's path (excluding the file's own slug)
  if (file) {
    let cursor: NovelFolder | undefined = topFolder;
    crumbTitles = [topFolder.title];
    for (const seg of file.path.slice(1, -1)) {
      cursor = cursor?.subfolders[seg];
      if (cursor) crumbTitles.push(cursor.title);
    }
  }
}
const isScene = topSlug === STORY_FOLDER_SLUG;

const pageTitle =
  view === 'file' && file ? `${file.title} — Remember Rain` : 'Remember Rain';
---

<BaseLayout
  title={pageTitle}
  description="A visual novel in progress — scenes, characters, world, and story plan."
>
  <NavPill backLink={view === 'file' && topFolder ? `/novel#${topFolder.slug}` : undefined}
           backLabel={view === 'file' && topFolder ? topFolder.title : undefined} />

  <canvas id="bg-canvas" aria-hidden="true"></canvas>

  {view === 'desk' && stats && (
    /* A <div>, not <main>: BaseLayout already wraps every page's slot in
       <main id="main-content">, and a nested <main> is invalid HTML and
       duplicates the landmark — which made landmark navigation ambiguous on the
       site's two largest surfaces. Same reasoning already recorded in
       about.astro. */
    <div class="novel-page novel-desk">
      <header class="novel-header p3r-animate">
        <div class="novel-header__titles">
          <span class="p4g-tab">visual novel</span>
          <h1 class="p4g-heading novel-header__title">Remember Rain</h1>
          <span class="p4g-underline"></span>
        </div>
      </header>

      <nav class="novel-start p3r-animate" style="--stagger-delay: 15ms" aria-label="Start exploring Remember Rain">
        {firstScene && <a href={fileUrl(firstScene)}>Read the draft</a>}
        <a href="#planning">Browse planning · spoilers</a>
      </nav>

      {/* Rain's own first line, then the least amount of frame that can stand
          around it. Earlier passes pitched him in the third person and in an
          analytical register the book never uses — the drafted prose is first
          person and wry ("Fuck it", "They don't know shit") — so the pitch did
          not sound like the thing it was selling. It also ran to 325 words of
          synopsis for a draft of 6,338, and explained the trap rather than
          letting the opening line be it. The quote is verbatim from
          Manuscript/Arc 1/0 Rain intro. The closing line is that scene's own
          ending callback, which is also where the site's motto comes from.

          The middle carries setting, abilities and threat without explaining
          any of them. The setting is Rain at scale, not his opposite — the
          earlier draft had the city genuinely vital and him the only stuck
          thing in it, which inverts the point. World/Locations: "a city
          sustained by circulation increasingly eliminates the irregularity
          produced by things actually changing", and Themes and Motifs files
          movement and stillness together because "motion is not automatically
          progress". So the city is modern, lit and endlessly rebuilt on the
          outside and going still underneath, which is Rain's own condition
          with better engineering; his commute is the city in miniature, which
          is why that paragraph ends on the train rather than on a contrast.
          The correction then presents as the cure for the decay it is
          accelerating, which is why the
          antagonist needs no motive here: earlier drafts spent 100 words
          explaining that he is kind and why he believes it, and explaining a
          threat defuses it. What is left is capability and reach — he does not
          need to touch you, and you would not notice — plus the symptom that
          matters, people having stopped starting things. He is unnamed, and
          the four pitfalls are gone: naming the comfortable endings described
          occurrences a stranger has no frame for. Abilities compress to one
          clause tied to the theft, which is also the thematic point, since the
          man who cannot act irreversibly is pulled toward an object that only
          exists because somebody else did. The Flare and Imprints are
          World/Magic System; the water loop and the correction's symptoms are
          World/Locations; the Ministry stays unnamed. The close carries the seeds rather than the plot.
          Both seeds are about premature completion: Vesper's throughline is
          that he "mistakes understanding for authority to author the person's
          future", against his own seed's "it is never really over until it's
          over"; Rain does the same thing to himself in reverse, since while
          nothing is finished nothing can come back as proof. So one sentence
          holds both — no life is finished until it is over, not his and not
          the ones being completed around him — and the last line is the Rain
          seed's own answer, that he does not need to become his ideal self
          before participating.

          Two things here are constrained by Story Plan/2 Pessimism of
          Strength, and an earlier draft broke both. That document is explicit
          that the distinction the story defends "is between choosing to remain
          and losing the ability to choose otherwise — never between moving and
          staying", and that nothing "licenses measuring a person by how much
          they initiate, and the story should not ask the reader to". So the
          correction's horror cannot be that people stop beginning things — a
          chosen quiet life is not a failure in this stance — it has to be the
          lost capacity to choose otherwise, which is why those people "did not
          decide to stay so much as lose whatever would have made them go".
          Same document: "commitment does not guarantee a good result; it
          allows a choice to acquire consequences", so the close cannot promise
          that beginning is rewarded. It states the opposite. It still names
          the obstacle and not the outcome, so it spoils nothing.
      */}
      <div class="desk-premise p3r-animate">
        <blockquote class="desk-premise__quote">I dreamed and dreamed of the ceiling finally collapsing while rain poured outside. Yet I could not fall.</blockquote>
        <p>Rain is twenty-three. There is an outline he opens every morning and never writes, and a plan to begin living once he is ready. He has never once done a thing he could not take back.</p>
        <p>He lives on an island where it has not stopped raining in his lifetime. The city looks like the future — water hauled up the volcano and sent back down through the streets, everything lit and engineered and endlessly rebuilt. But it circulates; it does not change. All that motion arrives back where it started. Rain rides the same train through it twice a day.</p>
        <p>Then he follows a faint light into an alley he has walked past for years, and takes something he cannot justify wanting. Since the Flare, objects have held the shape of the irreversible things that happened around them; this one was shaped by a decision somebody else went through with. The theft is small. What lands on him by morning is not.</p>
        <p>Lately the stillness has been spreading. It does not arrive as decline; it arrives as relief. Cleaner streets, thinner rain, fewer interruptions, and people who did not decide to stay so much as lose whatever would have made them go. Somebody is doing this on purpose. He does not need to touch you, and you would not notice if he had.</p>
        <p>None of that is the hard part. The hard part is that acting will not prove anything and will not be rewarded — it only lets what he does start to have consequences. No life is finished until it is over, his included. He does not have to become someone first.</p>
        <p class="desk-premise__motto">In spite of it all.</p>
      </div>


      <section class="desk-script p3r-animate" id="manuscript" style="--stagger-delay: 60ms" aria-label="Script">
        <header class="desk-script__header">
          <h2 class="desk-script__heading">Script</h2>
          <span class="desk-script__count">{stats.storyWords.toLocaleString('en-US')} words</span>
        </header>
        {scriptArcs.length === 0 && <p class="desk-empty">No scenes yet.</p>}
        {scriptArcs.map((arc) => (
          <section class="desk-arc">
            {arc.title && (
              <h3 class="desk-arc__header">
                <span>{arc.title}</span>
                <span class="desk-arc__count">{arc.words ? `${arc.words.toLocaleString('en-US')} words` : 'Planned'}</span>
              </h3>
            )}
            <ol class="desk-arc__list">
              {arc.rows.map((row) => (
                <li>
                  <a class="scene-row p4g-sweep" href={fileUrl(row.file)}>
                    <span class="scene-row__num" aria-hidden="true">{row.num}</span>
                    <span class="scene-row__title">{row.file.title}</span>
                    {row.isLatest && <span class="scene-row__latest">latest</span>}
                    <span class:list={['scene-row__words', { 'scene-row__words--planned': row.words === 0 }]}>{row.words ? `${row.words.toLocaleString('en-US')} words` : 'Planned'}</span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </section>
      <nav id="planning" class="desk-binder p3r-animate" style="--stagger-delay: 90ms" aria-label="Planning documents · contains spoilers">
        <h2 class="desk-binder__heading">Planning <span>· contains spoilers</span></h2>
        {binderGroups.map((group) => (
          <section class="binder-panel" id={group.slug}>
            <h2 class="binder-panel__header">{group.title}</h2>
            {group.rootFiles.length > 0 && (
              <ul class="binder-panel__list">
                {group.rootFiles.map((file) => (
                  <li>
                    <a href={fileUrl(file)}>{file.title}</a>
                  </li>
                ))}
              </ul>
            )}
            {group.subs.map((sub) => (
              <div class="binder-panel__sub">
                <h3 class="binder-panel__sublabel">{sub.title}</h3>
                <ul class="binder-panel__list">
                  {sub.files.map((file) => (
                    <li>
                      <a href={fileUrl(file)}>{file.title}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </section>
        ))}
      </nav>

    </div>
  )}

  {view === 'file' && topFolder && file && (
    /* A <div>, not <main>: BaseLayout already wraps every page's slot in
       <main id="main-content">, and a nested <main> is invalid HTML and
       duplicates the landmark — which made landmark navigation ambiguous on the
       site's two largest surfaces. Same reasoning already recorded in
       about.astro. */
    <div class="novel-page novel-reading">
      <nav class="novel-crumb p3r-animate" aria-label="Breadcrumb">
        <a href="/novel">desk</a>
        <span aria-hidden="true">/</span>
        <a href={`/novel#${topFolder.slug}`}>{crumbTitles.join(' / ').toLowerCase()}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{file.title.toLowerCase()}</span>
      </nav>

      <div class:list={['reading-sheet-wrap', { 'reading-sheet-wrap--paper': isScene }]}>
        <article class:list={['reading', isScene ? 'reading--paper' : 'reading--ink']}>
          <div class="reading__meta">
            <span>{topFolder.title}</span>
            {editedLabel(file) && <span>edited {editedLabel(file)}</span>}
          </div>
          <h1 class="reading__title">{file.title}</h1>
          <div class="reading__rule" aria-hidden="true"></div>
          {isScene && countWords(file.body) === 0 && <p>This scene is planned. There is no draft to read yet.</p>}
          <div class="reading__body" set:html={file.body} />
        </article>
      </div>

      {(prevFile || nextFile) && (
        <nav class="page-turn" aria-label="Adjacent files">
          {prevFile ? (
            <a class="page-turn__link page-turn__link--prev" href={fileUrl(prevFile)}>
              <span class="page-turn__dir">← previous</span>
              <span class="page-turn__name">{prevFile.title}</span>
            </a>
          ) : <span></span>}
          {nextFile && (
            <a class="page-turn__link page-turn__link--next" href={fileUrl(nextFile)}>
              <span class="page-turn__dir">next →</span>
              <span class="page-turn__name">{nextFile.title}</span>
            </a>
          )}
        </nav>
      )}
    </div>
  )}
</BaseLayout>

<script>
  // Sepia rain canvas — "rain through a lamplit window".
  // Static single frame under prefers-reduced-motion.
  function initCanvas() {
    const canvas = document.getElementById('bg-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext('2d')!;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let w = 0, h = 0;

    function resize() {
      w = canvas!.width = window.innerWidth;
      h = canvas!.height = window.innerHeight;
      if (reduced) drawScene(false);
    }

    const towers = Array.from({ length: 16 }, (_, i) => ({
      x: (i / 15) * 1.1 - 0.05,
      height: 0.2 + Math.random() * 0.4,
      width: 0.4 + Math.random() * 1.8,
      opacity: 0.03 + Math.random() * 0.04,
    }));
    const struts = Array.from({ length: 5 }, () => ({
      y: 0.45 + Math.random() * 0.45,
      opacity: 0.02 + Math.random() * 0.015,
    }));
    const drops = Array.from({ length: 110 }, () => ({
      x: Math.random(), y: Math.random(),
      speed: (1.8 + Math.random() * 2.2) / 800,
      len: (7 + Math.random() * 16) / 800,
      opacity: 0.06 + Math.random() * 0.14,
      lean: -0.035 + Math.random() * 0.02,
    }));

    function drawScene(withDrops: boolean) {
      ctx.clearRect(0, 0, w, h);
      const grd = ctx.createRadialGradient(w * 0.5, h * 0.92, 0, w * 0.5, h * 0.65, h * 0.7);
      grd.addColorStop(0, 'rgba(190,125,40,0.09)');
      grd.addColorStop(0.5, 'rgba(130,85,25,0.045)');
      grd.addColorStop(1, 'transparent');
      ctx.fillStyle = grd;
      ctx.fillRect(0, 0, w, h);

      towers.forEach((t) => {
        ctx.fillStyle = `rgba(150,115,70,${t.opacity})`;
        ctx.fillRect(t.x * w - t.width / 2, h - t.height * h, t.width, t.height * h);
      });
      struts.forEach((s) => {
        ctx.strokeStyle = `rgba(150,115,70,${s.opacity})`;
        ctx.lineWidth = 0.5;
        ctx.beginPath(); ctx.moveTo(0, s.y * h); ctx.lineTo(w, s.y * h); ctx.stroke();
      });
      if (!withDrops) return;
      drops.forEach((d) => {
        const px = d.x * w, py = d.y * h, plen = d.len * h;
        ctx.strokeStyle = `rgba(215,175,110,${d.opacity})`;
        ctx.lineWidth = 0.55;
        ctx.beginPath(); ctx.moveTo(px, py);
        ctx.lineTo(px + Math.sin(d.lean) * plen, py + plen); ctx.stroke();
        d.y += d.speed;
        if (d.y > 1) { d.y = -d.len; d.x = Math.random(); }
      });
    }

    resize();
    window.addEventListener('resize', resize);

    let rafId = 0;
    if (reduced) {
      drawScene(false);
    } else {
      const loop = () => { drawScene(true); rafId = requestAnimationFrame(loop); };
      rafId = requestAnimationFrame(loop);
    }

    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(rafId);
      window.removeEventListener('resize', resize);
    }, { once: true });
  }

  document.addEventListener('astro:page-load', initCanvas);
</script>

<style is:global>
  @import '../../styles/novel.css';
</style>
