---
import { getCollection } from 'astro:content';
import { readFileSync } from 'fs';
import { join } from 'path';
import ReadingLayout from '../layouts/ReadingLayout.astro';
import { parseCurrentArc } from '../utils/currentArc';
import { STAT_COLORS, hexToRgbTriplet } from '../utils/sessions';

const allNowPosts = await getCollection('now', ({ data }) => !data.draft);
const sortedPosts = allNowPosts.sort((a, b) =>
  b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);
const latestPost = sortedPosts[0];

const { Content } = await latestPost.render();

const lastUpdated = latestPost.data.publishedAt.toLocaleDateString('en-US', {
  timeZone: 'UTC',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

/* The current arc — moved here from /about. Read from the same _quests.md
   section, with the same contract: an absent or incomplete section renders
   no card at all rather than blanks, and an unrecognized Stat degrades to
   neutral gold. */
let questsRaw = '';
try {
  questsRaw = readFileSync(join(process.cwd(), 'src/content/sessions/_quests.md'), 'utf-8');
} catch {
  /* Missing file → no arc card. */
}
const currentArc = parseCurrentArc(questsRaw);

function colorBg(hex: string, a: number): string {
  return `rgba(${hexToRgbTriplet(hex).join(',')},${a})`;
}

const arcColor = currentArc?.stat ? STAT_COLORS[currentArc.stat] : null;
const arcEmblem = currentArc?.stat
  ? `/images/emblems/${currentArc.stat.toLowerCase()}.webp`
  : '/images/emblems/default.svg';
const arcCardStyle = arcColor
  ? `--arc-color:${arcColor};--arc-color-dim:${colorBg(arcColor, 0.35)}`
  : '';
---

<ReadingLayout title="Now" description="What I'm currently focused on." wide>
  <header class="reading-header">
    <span class="p4g-tab">Life lately</span>
    <h1 class="p4g-heading">Now</h1>
    <p class="reading-description">What I’m currently focused on.</p>
    <nav class="writing-links" aria-label="Now navigation">
      <a href="/now/archive">Past updates →</a>
      <a href="/life">About me →</a>
    </nav>
  </header>
  <div class:list={['now-reading', { 'now-reading--focused': !!currentArc }]}>
    {currentArc && <aside class="now-reading__focus">
        <details class="arc-card" style={arcCardStyle} data-now-focus open>
          <summary class="arc-card__top">
            <span class="arc-badge">
              <img src={arcEmblem} alt="" />
            </span>
            <span>
              <span class="arc-kicker">Current arc{currentArc.stat ? ` · ${currentArc.stat}` : ''}</span>
              <span class="arc-title">{currentArc.arc}</span>
            </span>
          </summary>
          <span class="arc-decision-label">Active decision</span>
          <p class="arc-decision-text">{currentArc.decision}</p>
          {currentArc.updated && <span class="arc-updated">updated {currentArc.updated}</span>}
        </details>
    </aside>}
    <article class="now-reading__entry" aria-label={latestPost.data.title}>
      <header class="now-entry-header">
        <p class="writing-dates">Latest update · <time datetime={latestPost.data.publishedAt.toISOString()}>{lastUpdated}</time></p>
        {latestPost.data.title !== 'Now' && <h2>{latestPost.data.title}</h2>}
      </header>
      <div class="prose"><Content /></div>
      <nav class="writing-links reading-footer" aria-label="Past Now entries"><a href="/now/archive">Read past updates →</a></nav>
    </article>
  </div>
</ReadingLayout>
<style>
  .now-reading { min-width: 0; }
  .now-reading__entry { min-width: 0; }
  .now-entry-header { margin-bottom: var(--space-xl); }
  .now-entry-header h2 { font: italic clamp(1.8rem,4vw,2.7rem)/1.2 var(--font-display); margin-top: var(--space-sm); }
  .arc-card { border: 2px solid var(--arc-color, var(--color-gold)); padding: var(--space-lg); background: var(--color-bg-elevated); margin-bottom: var(--space-xl); }
  .arc-card__top { display: flex; align-items: center; gap: var(--space-sm); min-height: 44px; cursor: pointer; list-style: none; }
  .arc-card__top::-webkit-details-marker { display: none; }
  .arc-card__top::after { content: "+"; margin-left: auto; color: var(--arc-color, var(--color-gold)); }
  .arc-card[open] > summary { margin-bottom: var(--space-lg); }
  .arc-card[open] > summary::after { content: "−"; }
  .arc-card__top:focus-visible { outline: 3px solid var(--arc-color, var(--color-gold)); outline-offset: 6px; }
  .arc-badge { flex: 0 0 44px; width: 44px; height: 44px; background: var(--color-black); border: 1px solid var(--arc-color, var(--color-gold)); display: grid; place-items: center; }
  .arc-badge img { width: 32px; height: 32px; object-fit: contain; }
  .arc-kicker, .arc-decision-label, .arc-updated { display: block; font: .75rem/1.6 var(--font-mono); color: var(--arc-color, var(--color-gold)); }
  .arc-title { display: block; font: 1.2rem/1.35 var(--font-display); margin-top: var(--space-xs); }
  .arc-decision-label { color: var(--color-text-muted); margin-bottom: var(--space-xs); }
  .arc-decision-text { line-height: 1.75; margin-bottom: var(--space-md); }
  @media (min-width:1024px) {
    .now-reading--focused { display: grid; grid-template-columns: minmax(0,1fr) 280px; gap: var(--space-2xl); align-items: start; }
    .now-reading__focus { grid-column: 2; grid-row: 1; position: sticky; top: var(--space-lg); }
    .now-reading__entry { grid-column: 1; grid-row: 1; }
  }
</style>


<script>
  function initNowFocus() {
    const card = document.querySelector<HTMLDetailsElement>('[data-now-focus]');
    if (!card || card.dataset.ready) return;
    card.dataset.ready = 'true';
    const desktop = matchMedia('(min-width: 1024px)');
    const adapt = () => { card.open = desktop.matches; };
    adapt();
    desktop.addEventListener('change', adapt);
    document.addEventListener('astro:before-swap', () => desktop.removeEventListener('change', adapt), { once: true });
  }
  initNowFocus();
  document.addEventListener('astro:page-load', initNowFocus);
</script>
