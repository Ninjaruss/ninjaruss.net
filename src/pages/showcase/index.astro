---
import SplitViewLayout from '../../layouts/SplitViewLayout.astro';
import ProjectList from '../../components/ProjectList.astro';
---

<SplitViewLayout
  title="Projects"
  description="Projects framed as inquiries — things I built because I wanted them to exist."
  section="showcase"
  ogImage="/social-default.png"
  showSearch={false}
>
  <Fragment slot="list"><ProjectList /></Fragment>
</SplitViewLayout>

<style>
  .empty-state {
    color: var(--color-muted);
    font-style: italic;
    text-align: center;
    padding: var(--space-xl);
  }
</style>
