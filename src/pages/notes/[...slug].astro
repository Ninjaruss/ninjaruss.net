---
import { getCollection } from 'astro:content';
import ReadingLayout from '../../layouts/ReadingLayout.astro';
import EntryBody from '../../components/EntryBody.astro';
import { publicNotes } from '../../utils/notes';
import { formatDate, shouldShowUpdatedDate } from '../../utils/dates';
import { stripMarkdown } from '../../utils/content';

export async function getStaticPaths() {
  const entries = publicNotes(await getCollection('notes'));
  return entries.map((entry, index) => ({ params: { slug: entry.slug }, props: {
    entry, newer: entries[index - 1], older: entries[index + 1],
  } }));
}
const { entry, newer, older } = Astro.props;
const { Content } = await entry.render();
---
<ReadingLayout title={entry.data.title} description={entry.data.description ?? stripMarkdown(entry.body).slice(0, 160)} image={entry.data.image} article>
  <article>
    <header class="reading-header">
      <nav class="writing-links" aria-label="Writing navigation"><a href="/notes">← All writing</a></nav>
      <h1 class="p4g-heading">{entry.data.title}</h1>
      <p class="writing-dates">
        {entry.data.publishedAt ? <>Published <time datetime={entry.data.publishedAt.toISOString()}>{formatDate(entry.data.publishedAt)}</time></> : 'Undated'}
        {shouldShowUpdatedDate(entry.data.publishedAt, entry.data.updatedAt) && entry.data.updatedAt && <> · Edited <time datetime={entry.data.updatedAt.toISOString()}>{formatDate(entry.data.updatedAt)}</time></>}
      </p>
    </header>
    <EntryBody hasContent={true}><Content /></EntryBody>
    <nav class="reading-neighbors" aria-label="More writing">
      {newer && <a href={`/notes/${newer.slug}`}><span>← Previous note</span> <strong>{newer.data.title}</strong></a>}
      {older && <a href={`/notes/${older.slug}`}><span>Next note →</span> <strong>{older.data.title}</strong></a>}
    </nav>
    <nav class="writing-links reading-footer" aria-label="Writing archive"><a href="/notes">← All writing</a></nav>
  </article>
</ReadingLayout>
