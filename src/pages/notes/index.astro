---
import { getCollection } from 'astro:content';
import WritingLayout from '../../layouts/WritingLayout.astro';
import { publicNotes } from '../../utils/notes';
import { formatDate } from '../../utils/dates';
const entries = publicNotes(await getCollection('notes'));
---
<WritingLayout title="Writing" description="Personal essays, reflections, and notes by Ninjaruss.">
  <header>
    <span class="p4g-tab">Essays &amp; notes</span>
    <h1 class="p4g-heading">Writing</h1>
    <p>Personal essays on life and becoming the person I want to be.</p>
    <nav class="writing-links" aria-label="Follow the writing">
      <a href="/rss.xml">Follow via RSS</a>
      <a href="/now">What I’m up to now</a>
      <a href="/japanese-journal">Japanese practice journal</a>
    </nav>
  </header>
  <ol class="notes-list" aria-label="Writing, newest first">
    {entries.map(entry => <li>
      <a href={`/notes/${entry.slug}`}>
        <h2>{entry.data.title}</h2>
        <span class="writing-dates">{entry.data.publishedAt ? <time datetime={entry.data.publishedAt.toISOString()}>{formatDate(entry.data.publishedAt)}</time> : 'Undated'}</span>
      </a>
    </li>)}
  </ol>
</WritingLayout>
<style>
  .notes-list { list-style: none; margin: 0; padding: 0; }
  .notes-list li { border-top: 1px solid var(--color-border); }
  .notes-list a { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: var(--space-sm) var(--space-lg); padding: var(--space-lg) 0; text-decoration: none; color: var(--color-text); }
  .notes-list h2 { font: clamp(1.1rem, 3vw, 1.4rem) var(--font-display); margin: 0; max-width: 30ch; }
  .notes-list a:hover h2 { color: var(--color-gold); }
</style>
