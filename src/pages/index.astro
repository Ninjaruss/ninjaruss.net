---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BentoGrid from '../components/BentoGrid.astro';
import TracesBar from '../components/TracesBar.astro';
import { publicNotes } from '../utils/notes';
import { formatDate } from '../utils/dates';
import { stripMarkdown } from '../utils/content';

const [notes, now, lFile] = await Promise.all([
  getCollection('notes'),
  getCollection('now', ({ data }) => !data.draft),
  getEntry('showcase', 'l-file'),
]);
const posts = publicNotes(notes).filter(entry => entry.data.publishedAt).slice(0, 3);
const latestNow = now.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())[0];
// Preview the actual update rather than adding a second summary to maintain.
const nowOpening = stripMarkdown(latestNow?.body.split(/\n\s*\n/).find(paragraph => paragraph.trim() && !/^[#<]/.test(paragraph.trim())) ?? '');
const nowExcerpt = nowOpening.match(/^.*?[.!?](?:\s|$)/)?.[0].trim() || nowOpening;
---

<BaseLayout title="Home" displayTitle="in spite of it all — ninjaruss" description="Writing, videos, projects, and Remember Rain — the personal hub of Ninjaruss.">
<div id="personal-hub" aria-label="Illustrated personal hub">
 <div class="intro-row">
 <header class="header">
<div>
<h1>NINJARUSS</h1>
<p class="motto">In spite of it all...</p>
<p class="intro">I’m an otaku, and I want to tell stories of my own. Sometimes a story that’s completely over the top is what makes me want to try harder at the life I already have.</p>
</div>
<nav class="about-links" aria-label="About and contact">
<a href="/life">About</a>
<a href="/life#contact" data-contact>Contact</a>
</nav>
</header>
  <a class="tile now" href="/now">
<span class="chip">Now</span>
<h2>{latestNow?.data.title || 'Personal updates'}</h2>
{latestNow && <p class="now-date"><time datetime={latestNow.data.publishedAt.toISOString()}>{formatDate(latestNow.data.publishedAt)}</time></p>}
{nowExcerpt && <p class="now-excerpt">{nowExcerpt}</p>}
<span class="now-read">Read the update <span aria-hidden="true">→</span></span></a>
 </div>
 <BentoGrid class="grid">
  <section class="tile writing" aria-labelledby="art-writing">
<div class="tile-intro">
<h2 id="art-writing"><a class="tile-link" href="/notes">Writing<span class="arrow" aria-hidden="true">→</span></a></h2>
</div>{posts.map(post => <a class="post" href={`/notes/${post.slug}`}><span>{post.data.title}</span><time datetime={post.data.publishedAt!.toISOString()}>{formatDate(post.data.publishedAt!)}</time>
</a>)}
</section>
  <section class="tile video" aria-labelledby="art-video">
<div class="video-art">
<picture>
<source media="(max-width: 700px)" srcset="/images/identity/ttgl-pointing-480.webp 480w, /images/identity/ttgl-pointing-960.webp 960w" sizes="calc(100vw - 36px)" width="960" height="960">
<img src="/images/identity/ttgl-banner-1440.webp" srcset="/images/identity/ttgl-banner-720.webp 720w, /images/identity/ttgl-banner-1440.webp 1440w" sizes="(max-width: 1280px) 56vw, 714px" width="1440" height="480" alt="Ninjaruss pointing toward the viewer against a gold and black spiral" fetchpriority="high">
</picture>
</div>
<div class="video-caption">
<div>
<h2 id="art-video"><a class="tile-link" href="https://www.youtube.com/@Ninjaruss_">Videos<span class="arrow" aria-hidden="true">↗</span><span class="offsite">on YouTube</span></a></h2>
<p>Videos about anime, learning Japanese, and my life in Japan.</p>
</div>
<nav class="video-actions" aria-label="Videos and livestreams">
<a href="/showcase/marie-video-essay">My Marie video essay →</a>
<a href="https://twitch.tv/ninjaruss_">Twitch livestreams<span class="arrow" aria-hidden="true">↗</span><span class="offsite">external link</span></a>
</nav>
</div>
</section>
  <section class="tile projects" aria-labelledby="art-projects">
<img class="project-emblem" src="/images/emblems/shuriken.svg" alt="" aria-hidden="true">
<div class="tile-intro">
<h2 id="art-projects"><a class="tile-link" href="/showcase">Projects<span class="arrow" aria-hidden="true">→</span></a></h2>
</div>
<div class="project-list">
<a class="project" href="/showcase/utasync">
<img src="/images/showcase/utasync.svg" alt="">
<div>
<strong>Utasync</strong>
<span>Practice Japanese with timed lyrics and song loops</span>
</div>
</a>
<a class="project" href="/showcase/l-file">
<img src="/images/media/usogui.webp" alt="">
<div>
<strong>L-file</strong>
<span>Usogui manga database{lFile?.data.status && ` · ${lFile.data.status}`}</span>
</div>
</a>
</div>
</section>
  <section class="tile novel" aria-labelledby="art-novel">
<div class="rain-field" aria-hidden="true">
<i>
</i>
<i>
</i>
<i>
</i>
<i>
</i>
<i>
</i>
<i>
</i>
</div>
<span class="chip">Visual novel · In progress</span>
<div class="tile-intro">
<h2 id="art-novel"><a class="tile-link" href="/novel">Remember Rain<span class="arrow" aria-hidden="true">→</span></a></h2>
</div>
<p class="premise">Rain has spent his life protecting the dream of writing something that inspires someone — by never testing it. A finished attempt could prove him ordinary, and an unfinished one never can. Then he steps off his commute on impulse, steals a resonant object, and is blamed for disappearances caused by a man who can take wanting itself. He has to act without proof that acting will make him exceptional, or safe.</p>
</section>
  <a class="tile japanese-journal" href="/japanese-journal">
<img class="journal-emblem" src="/images/emblems/torii.svg" alt="" aria-hidden="true">
<h2>Japanese journal</h2>
<p>Short entries I write in Japanese as I learn, mistakes included.</p>
</a>
  <a class="tile shelf" href="/shelf">
<div>
<h2>Shelf</h2>
<p>Stories, characters, and music that stick with me.</p>
</div>
<div class="posters" aria-hidden="true">
<img src="/images/media/persona-4-golden.webp" alt="">
<img src="/images/media/usogui.webp" alt="">
<img src="/images/media/ttgl.webp" alt="" loading="lazy">
</div>
</a>
 </BentoGrid>
 <div class="guestbook-row"><TracesBar /></div>
 <footer class="footer">
<nav class="footer-site" aria-label="Pages on this site">
<a href="/notes">Writing</a>
<a href="/showcase">Projects</a>
<a href="/novel">Remember Rain</a>
<a href="/shelf">Shelf</a>
<a href="/japanese-journal">Japanese journal</a>
<a href="/now">Now</a>
<a href="/traces">Traces</a>
<a href="/life">About</a>
<a href="/life#contact" data-contact>Contact</a>
</nav>
<nav class="footer-elsewhere" aria-label="Elsewhere on the web">
<a href="https://www.youtube.com/@Ninjaruss_">YouTube<span class="arrow" aria-hidden="true">↗</span><span class="offsite">external link</span></a>
<a href="https://twitch.tv/ninjaruss_">Twitch<span class="arrow" aria-hidden="true">↗</span><span class="offsite">external link</span></a>
<a href="https://myanimelist.net/animelist/Ninjaruss_">MyAnimeList<span class="arrow" aria-hidden="true">↗</span><span class="offsite">external link</span></a>
<a href="https://open.spotify.com/playlist/6PYIeR2dXsbTrk47TqetSD">Spotify<span class="arrow" aria-hidden="true">↗</span><span class="offsite">external link</span></a>
</nav>
</footer>
</div>
</BaseLayout>

<script>
  function setupContact() {
    const address = ['mailbox', ['ninjaruss', 'net'].join('.')].join('@');
    document.querySelectorAll<HTMLAnchorElement>('[data-contact]').forEach(link => {
      const arm = () => { link.href = `mailto:${address}`; };
      link.addEventListener('pointerenter', arm, { once: true });
      link.addEventListener('focus', arm, { once: true });
      link.addEventListener('touchstart', arm, { once: true, passive: true });
    });
  }
  setupContact();
  document.addEventListener('astro:page-load', setupContact);
</script>

<style is:global>
#personal-hub {
  --gold: var(--color-gold);
  --bg: var(--color-bg-deep);
  --surface: var(--color-bg-elevated);
  --ink: var(--color-black);
  --text: var(--color-text);
  --muted: var(--color-text-muted);
  --line: var(--color-border-strong);
  color-scheme: dark;
  background-color: var(--bg);
  background-image: radial-gradient(#28251a 1px, transparent 1px);
  background-size: 22px 22px;
  color: var(--text);
  padding: 24px;
  font: 16px/1.6 var(--font-body);
}
#personal-hub * {
  box-sizing: border-box;
  min-width: 0;
}
#personal-hub h1,
#personal-hub h2,
#personal-hub p {
  margin: 0;
}
#personal-hub a {
  color: inherit;
  text-decoration: none;
}
#personal-hub a:hover {
  text-decoration: underline;
  text-underline-offset: 4px;
}
#personal-hub a:focus-visible {
  outline: 3px solid var(--gold);
  outline-offset: 4px;
}
#personal-hub .writing a:focus-visible {
  outline-color: var(--ink);
}
#personal-hub .intro-row {
  display: grid;
  grid-template-columns: minmax(0, 2fr) minmax(300px, 1fr);
  gap: 14px;
  margin-bottom: 14px;
}
#personal-hub .header {
  display: grid;
  align-content: start;
  gap: 14px;
  padding: 24px 28px;
  border: 3px solid var(--gold);
  background: var(--bg);
  box-shadow: var(--shadow-hard);
}
#personal-hub h1 {
  font: italic clamp(30px, 5vw, 56px)/1.15 var(--font-display);
  color: var(--gold);
  letter-spacing: -1.2px;
}
#personal-hub .motto {
  margin-top: 7px;
  font-style: italic;
}
#personal-hub .intro {
  margin-top: 12px;
  max-width: 65ch;
}
#personal-hub .about-links {
  display: flex;
  gap: 20px;
  flex-wrap: wrap;
}
#personal-hub .about-links a {
  min-height: 44px;
  display: flex;
  align-items: center;
}
#personal-hub .grid {
  display: grid;
  grid-template-columns: repeat(12, minmax(0, 1fr));
  gap: 14px;
  grid-auto-rows: auto;
}
#personal-hub .guestbook-row { margin-top: 18px; }
#personal-hub .tile {
  animation: none;
  position: relative;
  background: var(--surface);
  border: 2px solid var(--line);
  box-shadow: var(--shadow-hard);
}
#personal-hub .tile:after {
  content: "";
  position: absolute;
  bottom: -1px;
  right: -1px;
  width: 16px;
  height: 16px;
  background: var(--bg);
  clip-path: polygon(100% 0, 100% 100%, 0 100%);
  pointer-events: none;
  z-index: 3;
}
#personal-hub .tile h2 {
  color: inherit;
  font: italic 27px/1.25 var(--font-display);
}
#personal-hub .chip {
  display: inline-flex;
  align-self: flex-start;
  padding: 4px 14px 4px 9px;
  background: var(--gold);
  color: var(--ink);
  font: 700 13px/1.5 var(--font-body);
  clip-path: polygon(0 0, 100% 0, calc(100% - 8px) 100%, 0 100%);
}
#personal-hub .tile-intro {
  margin: 6px 0 14px;
}
#personal-hub .tile-intro p {
  color: var(--muted);
  margin-top: 5px;
  font-size: 15px;
}
#personal-hub .writing {
  container-type: inline-size;
  grid-column: span 5;
  background: var(--gold);
  color: var(--ink);
  border-color: var(--gold);
  padding: 24px;
  display: flex;
  flex-direction: column;
}
#personal-hub .post {
  display: block;
  flex: 1;
  align-content: center;
  padding: 14px 0;
  border-top: 1px solid #958721;
  font-size: 17px;
  font-weight: 700;
  line-height: 1.4;
  min-height: 44px;
}
#personal-hub .post time {
  display: block;
  margin-top: 5px;
  font-size: 14px;
  font-weight: 400;
}
#personal-hub .tile h2 a {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  min-height: 44px;
  color: inherit;
  font: inherit;
}
#personal-hub .arrow { color: var(--gold); font: 600 20px/1 var(--font-body); }
#personal-hub .writing .arrow { color: var(--ink); }
/* Each card has exactly one destination, and the whole card goes there: the
   hover lift promises a click target, so the body of the card has to honour it.
   Inner links are raised above the overlay and keep their own destinations. */
#personal-hub .tile-link::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;
}
#personal-hub :is(.post, .project, .video-actions) {
  position: relative;
  z-index: 2;
}
/* Says "this leaves the site" to screen readers; the glyph says it visually. */
#personal-hub .offsite {
  position: absolute;
  width: 1px;
  height: 1px;
  margin: -1px;
  padding: 0;
  border: 0;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}
@container (min-width: 420px) {
  #personal-hub .post { display: grid; grid-template-columns: minmax(0,1fr) auto; align-items: baseline; gap: 16px; padding: 12px 0; }
  #personal-hub .post time { margin-top: 0; white-space: nowrap; font-size: 13px; }
}
#personal-hub .video {
  grid-column: span 7;
  display: flex;
  flex-direction: column;
}
#personal-hub .video-art {
  display: block;
  position: relative;
  background: var(--gold);
}
#personal-hub .video-art img {
  display: block;
  width: 100%;
  height: auto;
  aspect-ratio: 3/1;
  object-fit: cover;
  object-position: 63% center;
}
#personal-hub .video-caption {
  padding: 18px 24px 20px;
  background: var(--surface);
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 4px;
}
#personal-hub .video-caption h2 {
  font-size: 25px;
}
#personal-hub .video-caption a {
  color: var(--muted);
  min-height: 44px;
  display: inline-flex;
  align-items: center;
  font-weight: 700;
}
#personal-hub .video-caption h2 a { color: var(--text); }
#personal-hub .projects {
  display: flex;
  flex-direction: column;
  grid-column: span 5;
  padding: 24px;
  overflow: hidden;
}
#personal-hub .project-list {
  display: flex;
  flex-direction: column;
  flex: 1;
  position: relative;
  z-index: 1;
}
#personal-hub .project {
  display: flex;
  flex: 1;
  align-items: center;
  gap: 15px;
  border-top: 1px solid var(--line);
  padding: 11px 0;
  min-height: 68px;
}
#personal-hub .project img {
  width: 46px;
  height: 46px;
  object-fit: contain;
  flex-shrink: 0;
}
#personal-hub .project strong {
  display: block;
  font-size: 18px;
}
#personal-hub .project span {
  color: var(--muted);
  display: block;
  font-size: 14px;
}
#personal-hub .project-emblem {
  position: absolute;
  right: -10px;
  top: 35px;
  width: 225px;
  height: 225px;
  object-fit: contain;
  opacity: 0.1;
  transform: rotate(12deg);
  pointer-events: none;
}
#personal-hub .novel {
  grid-column: span 7;
  padding: 24px;
  display: flex;
  flex-direction: column;
  background: #111719;
}
#personal-hub .rain-field {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
}
#personal-hub .rain-field i {
  position: absolute;
  width: 1px;
  height: 65px;
  background: #57605a;
  transform: rotate(14deg);
  opacity: 0.25;
}
#personal-hub .rain-field i:nth-child(1) {
  left: 12%;
  top: 10%;
}
#personal-hub .rain-field i:nth-child(2) {
  left: 25%;
  top: 67%;
  height: 85px;
}
#personal-hub .rain-field i:nth-child(3) {
  left: 47%;
  top: 5%;
  height: 110px;
}
#personal-hub .rain-field i:nth-child(4) {
  left: 68%;
  top: 40%;
}
#personal-hub .rain-field i:nth-child(5) {
  left: 88%;
  top: 4%;
  height: 120px;
}
#personal-hub .rain-field i:nth-child(6) {
  left: 91%;
  top: 76%;
}
#personal-hub .novel:before {
  content: "";
  position: absolute;
  inset: auto 0 0;
  height: 40%;
  background: linear-gradient(transparent, #1d2625);
  pointer-events: none;
}
/* No z-index here: these are positioned and come after .rain-field in the DOM,
   so they already paint above it — and keeping them at auto lets the card's
   stretched link (z-index 1) sit on top of the premise instead of under it. */
#personal-hub .novel > :not(.rain-field):not(.tile-intro) {
  position: relative;
}
#personal-hub .novel .premise {
  margin: 8px 0 20px;
  max-width: none;
}
#personal-hub .shelf {
  grid-column: span 7;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  align-items: center;
  gap: 20px;
  padding: 24px;
}
#personal-hub .shelf h2 {
  margin-top: 10px;
}
#personal-hub .shelf p {
  color: var(--muted);
  font-size: 15px;
  margin-top: 7px;
}
#personal-hub .posters {
  height: 125px;
  display: flex;
  gap: 8px;
  align-items: center;
  overflow: hidden;
  padding: 8px;
}
#personal-hub .posters img {
  height: 110px;
  width: 76px;
  object-fit: cover;
  flex-shrink: 0;
  border: 2px solid #b3a249;
  transform: rotate(-5deg);
}
#personal-hub .posters img:nth-child(even) {
  transform: rotate(5deg) translateY(3px);
}
#personal-hub .now,
#personal-hub .japanese-journal {
  padding: 24px;
}
#personal-hub .now {
  border-color: var(--gold);
  display: flex;
  flex-direction: column;
  text-decoration: none;
}
#personal-hub .now h2,
#personal-hub .japanese-journal h2 {
  margin: 10px 0 7px;
}
#personal-hub .now p,
#personal-hub .japanese-journal p {
  color: var(--muted);
  font-size: 15px;
}
#personal-hub .now h2 { color: var(--gold); }
#personal-hub .now .now-date { font-size: 13px; }
#personal-hub .now .now-excerpt { color: var(--text); margin-top: 14px; line-height: 1.6; }
#personal-hub .now-read { display: flex; justify-content: space-between; gap: 16px; margin-top: auto; padding-top: 18px; color: var(--gold); font-weight: 600; }
#personal-hub .now:hover { text-decoration: none; }
#personal-hub .now:hover .now-read { text-decoration: underline; text-underline-offset: 4px; }
#personal-hub .japanese-journal {
  grid-column: span 5;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
#personal-hub .japanese-journal > :not(.journal-emblem) { position: relative; }
#personal-hub .journal-emblem {
  position: absolute;
  right: -12px;
  bottom: -12px;
  width: 130px;
  height: 130px;
  opacity: 0.08;
  pointer-events: none;
}
/* The page used to end in two outbound links and nothing else. Anyone who
   scrolls the whole hub now lands on the full map of it. */
#personal-hub .footer {
  display: grid;
  gap: 2px 32px;
  margin-top: 26px;
  padding-top: 14px;
  border-top: 2px solid var(--line);
}
#personal-hub .footer nav {
  display: flex;
  flex-wrap: wrap;
  gap: 0 22px;
}
#personal-hub .footer a {
  min-height: 44px;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  color: var(--muted);
  font-size: 14px;
}
#personal-hub .footer-site a {
  color: var(--text);
  font-weight: 700;
}
#personal-hub .footer .arrow {
  font-size: 13px;
  color: inherit;
}
@media (min-width: 701px) and (max-width: 1023px) {
  #personal-hub .grid > * { grid-column: span 6; }
  #personal-hub .video-art img { aspect-ratio: 16/9; }
  #personal-hub .shelf { grid-template-columns: minmax(0, 1fr); gap: 10px; }
}
@media (max-width: 700px) {
  #personal-hub {
    padding: 16px;
  }
  #personal-hub .intro-row {
    grid-template-columns: minmax(0, 1fr);
  }
  #personal-hub .header {
    padding: 18px;
  }
  #personal-hub h1 {
    font-size: 29px;
  }
  #personal-hub .grid {
    grid-template-columns: minmax(0, 1fr);
  }
  #personal-hub .grid > * {
    grid-column: auto;
  }
  #personal-hub .writing,
  #personal-hub .projects,
  #personal-hub .novel,
  #personal-hub .shelf,
  #personal-hub .now,
  #personal-hub .japanese-journal {
    padding: 20px;
  }
  #personal-hub .video-art img {
    height: auto;
    aspect-ratio: 16/9;
    object-position: center 35%;
  }
  #personal-hub .tile h2 {
    font-size: 25px;
  }
  #personal-hub .shelf {
    grid-template-columns: minmax(0, 1fr);
    gap: 10px;
  }
  #personal-hub .posters {
    padding: 8px 0;
  }
}

#personal-hub {
  max-width: 1280px;
  margin: auto;
  overflow-wrap: anywhere;
}
#personal-hub .novel a:focus-visible {
  outline-color: var(--gold);
}
#personal-hub .video-actions {
  display: flex;
  gap: 4px 20px;
  flex-wrap: wrap;
}
#personal-hub .video-caption {
  flex: 1;
  align-content: start;
}
#personal-hub .post time {
  color: inherit;
}

/* Native pointer on the hub; the rest of the site retains its cursor treatment. */
html.has-custom-cursor:has(#personal-hub),
html.has-custom-cursor:has(#personal-hub) * {
  cursor: auto !important;
}
html.has-custom-cursor:has(#personal-hub) a {
  cursor: pointer !important;
}
html:has(#personal-hub) #cursor {
  display: none;
}
/* One selection response across the hub. Inner links keep their own focus rings. */
#personal-hub :is(.tile, .traces) {
  transition: transform var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base);
}
#personal-hub :is(.tile, .traces):is(:focus-visible, :has(:focus-visible)) {
  transform: translateY(-3px);
  border-color: var(--gold);
  box-shadow: var(--shadow-hard-hover);
}
#personal-hub .tile:is(:focus-visible, :has(:focus-visible)):after {
  background: var(--gold);
}
