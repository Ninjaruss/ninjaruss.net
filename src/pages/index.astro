---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BentoGrid from '../components/BentoGrid.astro';
import { fetchSubstackPosts } from '../utils/substack';
import { formatDate } from '../utils/dates';

const posts = (await fetchSubstackPosts(3)).filter(post => !Number.isNaN(Date.parse(post.pubDate)));
const now = await getCollection('now', ({ data }) => !data.draft);
const latestNow = now.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())[0];
---

<BaseLayout title="Home" displayTitle="in spite of it all — ninjaruss" description="Writing, videos, projects, and Remember Rain — the personal hub of Ninjaruss.">
<div id="personal-hub" aria-label="Illustrated personal hub">
 <header class="header">
<div>
<h1>NINJARUSS</h1>
<p class="motto">In spite of it all...</p>
<p class="intro">Writing, videos, Japanese, and things I build along the way.</p>
</div>
<nav class="about-links" aria-label="About and contact">
<a href="/about">About me</a>
<a href="/about" data-contact>Contact</a>
</nav>
</header>
 <section class="traces" aria-label="Traces guestbook">
<a class="traces-title" href="/traces">Traces <span>Guestbook</span>
</a>
<p class="traces-message">Leave a trace — one line.</p>
<a class="sign" href="/traces">Leave a trace</a>
</section>
 <BentoGrid class="grid">
  <section class="tile writing" aria-labelledby="art-writing">
<span class="chip">Substack</span>
<div class="tile-intro">
<h2 id="art-writing">Writing</h2>
<p>Notes on life, Japanese, and making things.</p>
</div>{posts.map(post => <a class="post" href={post.link}>{post.title}<time datetime={new Date(post.pubDate).toISOString()}>{formatDate(new Date(post.pubDate))}</time>
</a>)}
{posts.length === 0 && <p class="tile-intro">My writing lives on Substack.</p>}
<a class="go" href="https://ninjaruss.substack.com">Read on Substack</a>
</section>
  <section class="tile video" aria-labelledby="art-video">
<a class="video-art" href="https://www.youtube.com/@Ninjaruss_" aria-label="Ninjaruss on YouTube">
<img src="/images/logos/yt-avatar-640.jpg" srcset="/images/logos/yt-avatar-640.jpg 640w, /images/logos/yt-avatar-1024.jpg 1024w" sizes="(max-width:700px) 100vw, 700px" width="1024" height="576" alt="Ninjaruss holding a Persona card">
<span class="chip">YouTube</span>
</a>
<div class="video-caption">
<div>
<h2 id="art-video">Watch Ninjaruss</h2>
<p>Videos on YouTube and livestreams on Twitch.</p>
</div>
<nav class="video-actions" aria-label="Videos and livestreams">
<a href="https://www.youtube.com/@Ninjaruss_">YouTube videos</a>
<a href="https://twitch.tv/ninjaruss_">Twitch livestreams</a>
</nav>
</div>
</section>
  <section class="tile projects" aria-labelledby="art-projects">
<img class="project-emblem" src="/images/emblems/shuriken.svg" alt="" aria-hidden="true">
<span class="chip">Showcase</span>
<div class="tile-intro">
<h2 id="art-projects">Things I build</h2>
<p>Apps &amp; experiments.</p>
</div>
<div class="project-list">
<a class="project" href="/showcase/utasync">
<img src="/images/showcase/utasync.svg" alt="">
<div>
<strong>Utasync</strong>
<span>Learn Japanese through music</span>
</div>
</a>
<a class="project" href="/showcase/l-file">
<img src="/images/media/usogui.webp" alt="">
<div>
<strong>L-file</strong>
<span>Usogui database · Hosted site offline</span>
</div>
</a>
<a class="go" href="/showcase">Explore the projects</a>
</div>
</section>
  <section class="tile novel" aria-labelledby="art-novel">
<div class="rain-field" aria-hidden="true">
<i>
</i>
<i>
</i>
<i>
</i>
<i>
</i>
<i>
</i>
<i>
</i>
</div>
<span class="chip">Visual novel</span>
<div class="tile-intro">
<h2 id="art-novel">Remember Rain</h2>
<p>A work in progress.</p>
</div>
<p class="premise">Rain dreams of writing a story that will inspire someone. Following a ghost makes him a fugitive, pulling him into supernatural horrors that threaten the refuges he turns to for escape. He keeps reaching for his dreams without knowing what pursuing them will cost.</p>
<p class="draft">Manuscript, characters, and planning documents</p>
<a class="go" href="/novel">Explore Remember Rain</a>
</section>
  <a class="tile shelf" href="/shelf">
<div>
<span class="chip">Shelf</span>
<h2>Media log</h2>
<p>Stories, characters, and music that stick with me.</p>
</div>
<div class="posters" aria-hidden="true">
<img src="/images/media/persona-4-golden.webp" alt="">
<img src="/images/media/usogui.webp" alt="">
<img src="/images/media/ttgl.webp" alt="" loading="lazy">
</div>
</a>
  <a class="tile now" href="/now">
<span class="chip">Now</span>
<h2>Where I'm at</h2>
<p>Current focus and personal updates.</p>{latestNow && <p class="now-date">{formatDate(latestNow.data.publishedAt)}</p>}</a>
 </BentoGrid>
 <footer class="footer">
<nav aria-label="Elsewhere">
<a href="https://myanimelist.net/animelist/Ninjaruss_">MyAnimeList</a>
<a href="https://open.spotify.com/playlist/6PYIeR2dXsbTrk47TqetSD">Spotify</a>
<a href="https://twitch.tv/ninjaruss_">Twitch</a>
</nav>
<a href="/about" data-contact>Email me</a>
</footer>
</div>
</BaseLayout>

<script>
  function setupContact() {
    const address = ['mailbox', ['ninjaruss', 'net'].join('.')].join('@');
    document.querySelectorAll<HTMLAnchorElement>('[data-contact]').forEach(link => {
      const arm = () => { link.href = `mailto:${address}`; };
      link.addEventListener('pointerenter', arm, { once: true });
      link.addEventListener('focus', arm, { once: true });
      link.addEventListener('touchstart', arm, { once: true, passive: true });
    });
  }
  setupContact();
  document.addEventListener('astro:page-load', setupContact);
</script>

<style is:global>
#personal-hub {
  --gold: var(--color-gold);
  --bg: var(--color-bg-deep);
  --surface: var(--color-bg-elevated);
  --ink: var(--color-black);
  --text: var(--color-text);
  --muted: var(--color-text-muted);
  --line: var(--color-border-strong);
  color-scheme: dark;
  background-color: var(--bg);
  background-image: radial-gradient(#28251a 1px, transparent 1px);
  background-size: 22px 22px;
  color: var(--text);
  padding: 24px;
  font: 16px/1.6 var(--font-body);
}
#personal-hub * {
  box-sizing: border-box;
  min-width: 0;
}
#personal-hub h1,
#personal-hub h2,
#personal-hub p {
  margin: 0;
}
#personal-hub a {
  color: inherit;
  text-decoration: none;
}
#personal-hub a:hover {
  text-decoration: underline;
  text-underline-offset: 4px;
}
#personal-hub a:focus-visible {
  outline: 3px solid var(--gold);
  outline-offset: 4px;
}
#personal-hub .writing a:focus-visible {
  outline-color: var(--ink);
}
#personal-hub .header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 18px;
  padding: 24px 28px;
  border: 3px solid var(--gold);
  background: var(--bg);
  box-shadow: var(--shadow-hard);
  margin-bottom: 14px;
}
#personal-hub h1 {
  font: italic clamp(30px, 5vw, 56px)/1.15 var(--font-display);
  color: var(--gold);
  letter-spacing: -1.2px;
}
#personal-hub .motto {
  margin-top: 7px;
  font-style: italic;
}
#personal-hub .intro {
  color: var(--muted);
  margin-top: 8px;
  max-width: 55ch;
}
#personal-hub .about-links {
  display: flex;
  gap: 20px;
  flex-wrap: wrap;
}
#personal-hub .about-links a {
  min-height: 44px;
  display: flex;
  align-items: center;
}
#personal-hub .traces {
  background: #191919;
  border: 1px solid var(--line);
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
  align-items: center;
  padding: 8px 14px;
  margin-bottom: 18px;
}
#personal-hub .traces-title {
  color: var(--gold);
  font-weight: 700;
  min-height: 44px;
  display: flex;
  align-items: center;
  gap: 10px;
}
#personal-hub .traces-title span {
  color: var(--muted);
  font-size: 14px;
  font-weight: 400;
}
#personal-hub .traces-message {
  flex: 1 1 220px;
  color: var(--muted);
  font: 14px/1.6 var(--font-mono);
}
#personal-hub .sign {
  background: var(--gold);
  color: var(--ink);
  padding: 8px 16px;
  min-height: 44px;
  font-weight: 700;
  display: flex;
  align-items: center;
}
#personal-hub .sign:focus-visible {
  outline-color: var(--text);
}
#personal-hub .grid {
  display: grid;
  grid-template-columns: repeat(12, minmax(0, 1fr));
  gap: 14px;
  grid-auto-rows: auto;
}
#personal-hub .tile {
  animation: none;
  position: relative;
  background: var(--surface);
  border: 2px solid var(--line);
  box-shadow: var(--shadow-hard);
}
#personal-hub .tile:after {
  content: "";
  position: absolute;
  bottom: -1px;
  right: -1px;
  width: 16px;
  height: 16px;
  background: var(--bg);
  clip-path: polygon(100% 0, 100% 100%, 0 100%);
  pointer-events: none;
}
#personal-hub .tile h2 {
  color: inherit;
  font: italic 27px/1.25 var(--font-display);
}
#personal-hub .chip {
  display: inline-flex;
  align-self: flex-start;
  padding: 4px 14px 4px 9px;
  background: var(--gold);
  color: var(--ink);
  font: 700 13px/1.5 var(--font-body);
  clip-path: polygon(0 0, 100% 0, calc(100% - 8px) 100%, 0 100%);
}
#personal-hub .tile-intro {
  margin: 10px 0 18px;
}
#personal-hub .tile-intro p {
  color: var(--muted);
  margin-top: 5px;
  font-size: 15px;
}
#personal-hub .writing {
  grid-column: span 5;
  background: var(--gold);
  color: var(--ink);
  border-color: var(--gold);
  padding: 24px;
  display: flex;
  flex-direction: column;
}
#personal-hub .writing .chip {
  background: var(--ink);
  color: var(--gold);
}
#personal-hub .writing .tile-intro p {
  color: var(--ink);
}
#personal-hub .post {
  display: block;
  padding: 14px 0;
  border-top: 1px solid #958721;
  font-size: 17px;
  font-weight: 700;
  line-height: 1.4;
}
#personal-hub .post time {
  display: block;
  margin-top: 5px;
  font-size: 14px;
  font-weight: 400;
}
#personal-hub .go {
  display: inline-flex;
  min-height: 44px;
  align-items: center;
  font-weight: 700;
  margin-top: auto;
  padding-top: 12px;
  align-self: flex-start;
}
#personal-hub .video {
  grid-column: span 7;
  display: flex;
  flex-direction: column;
}
#personal-hub .video-art {
  display: block;
  position: relative;
  background: var(--gold);
}
#personal-hub .video-art img {
  display: block;
  width: 100%;
  height: auto;
  aspect-ratio: 16/9;
  object-fit: cover;
  object-position: center;
}
#personal-hub .video-art .chip {
  position: absolute;
  top: 12px;
  left: 12px;
}
#personal-hub .video-caption {
  padding: 16px 22px;
  background: var(--surface);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
}
#personal-hub .video-caption h2 {
  font-size: 25px;
}
#personal-hub .video-caption p {
  color: var(--muted);
  font-size: 15px;
  margin-top: 4px;
}
#personal-hub .video-caption a {
  color: var(--gold);
  min-height: 44px;
  display: inline-flex;
  align-items: center;
  font-weight: 700;
}
#personal-hub .projects {
  display: flex;
  flex-direction: column;
  grid-column: span 7;
  padding: 24px;
  overflow: hidden;
}
#personal-hub .projects .tile-intro {
  position: relative;
  z-index: 1;
}
#personal-hub .project-list {
  display: flex;
  flex-direction: column;
  flex: 1;
  position: relative;
  z-index: 1;
}
#personal-hub .project {
  display: flex;
  align-items: center;
  gap: 15px;
  border-top: 1px solid var(--line);
  padding: 11px 0;
  min-height: 68px;
}
#personal-hub .project img {
  width: 46px;
  height: 46px;
  object-fit: contain;
  flex-shrink: 0;
}
#personal-hub .project strong {
  display: block;
  font-size: 18px;
}
#personal-hub .project span {
  color: var(--muted);
  display: block;
  font-size: 14px;
}
#personal-hub .project-emblem {
  position: absolute;
  right: -10px;
  top: 35px;
  width: 225px;
  height: 225px;
  object-fit: contain;
  opacity: 0.1;
  transform: rotate(12deg);
  pointer-events: none;
}
#personal-hub .novel {
  grid-column: span 5;
  padding: 24px;
  display: flex;
  flex-direction: column;
  background: #111719;
}
#personal-hub .rain-field {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
}
#personal-hub .rain-field i {
  position: absolute;
  width: 1px;
  height: 65px;
  background: #57605a;
  transform: rotate(14deg);
  opacity: 0.25;
}
#personal-hub .rain-field i:nth-child(1) {
  left: 12%;
  top: 10%;
}
#personal-hub .rain-field i:nth-child(2) {
  left: 25%;
  top: 67%;
  height: 85px;
}
#personal-hub .rain-field i:nth-child(3) {
  left: 47%;
  top: 5%;
  height: 110px;
}
#personal-hub .rain-field i:nth-child(4) {
  left: 68%;
  top: 40%;
}
#personal-hub .rain-field i:nth-child(5) {
  left: 88%;
  top: 4%;
  height: 120px;
}
#personal-hub .rain-field i:nth-child(6) {
  left: 91%;
  top: 76%;
}
#personal-hub .novel:before {
  content: "";
  position: absolute;
  inset: auto 0 0;
  height: 40%;
  background: linear-gradient(transparent, #1d2625);
  pointer-events: none;
}
#personal-hub .novel > :not(.rain-field) {
  position: relative;
  z-index: 1;
}
#personal-hub .novel .premise {
  margin: 8px 0 20px;
  max-width: 34ch;
}
#personal-hub .novel .go {
  color: var(--gold);
}
#personal-hub .novel .draft {
  color: var(--muted);
  font-size: 14px;
  border-top: 1px solid var(--line);
  padding-top: 12px;
}
#personal-hub .shelf {
  grid-column: span 8;
  display: grid;
  grid-template-columns: 210px minmax(0, 1fr);
  align-items: center;
  gap: 20px;
  padding: 22px;
}
#personal-hub .shelf h2 {
  margin-top: 10px;
}
#personal-hub .shelf p {
  color: var(--muted);
  font-size: 15px;
  margin-top: 7px;
}
#personal-hub .posters {
  height: 125px;
  display: flex;
  gap: 8px;
  align-items: center;
  overflow: hidden;
  padding: 8px;
}
#personal-hub .posters img {
  height: 110px;
  width: 76px;
  object-fit: cover;
  flex-shrink: 0;
  border: 2px solid #b3a249;
  transform: rotate(-5deg);
}
#personal-hub .posters img:nth-child(even) {
  transform: rotate(5deg) translateY(3px);
}
#personal-hub .now {
  grid-column: span 4;
  padding: 22px;
  border-color: var(--gold);
}
#personal-hub .now h2 {
  margin: 10px 0 7px;
}
#personal-hub .now p {
  color: var(--muted);
  font-size: 15px;
}
#personal-hub .footer {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
  margin-top: 18px;
}
#personal-hub .footer nav {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
}
#personal-hub .footer a {
  min-height: 44px;
  display: flex;
  align-items: center;
  color: var(--muted);
  font-size: 14px;
}
@media (max-width: 700px) {
  #personal-hub {
    padding: 16px;
  }
  #personal-hub .header {
    padding: 18px;
  }
  #personal-hub h1 {
    font-size: 29px;
  }
  #personal-hub .grid {
    grid-template-columns: minmax(0, 1fr);
  }
  #personal-hub .grid > * {
    grid-column: auto;
  }
  #personal-hub .writing,
  #personal-hub .projects,
  #personal-hub .novel {
    padding: 22px;
  }
  #personal-hub .video-art img {
    height: auto;
    aspect-ratio: 16/9;
  }
  #personal-hub .tile h2 {
    font-size: 25px;
  }
  #personal-hub .traces-message {
    flex-basis: 100%;
  }
  #personal-hub .shelf {
    grid-template-columns: minmax(0, 1fr);
    gap: 10px;
  }
  #personal-hub .posters {
    padding: 8px 0;
  }
}

#personal-hub {
  max-width: 1280px;
  margin: auto;
  overflow-wrap: anywhere;
}
#personal-hub .novel a:focus-visible {
  outline-color: var(--gold);
}
#personal-hub .video-actions {
  display: flex;
  gap: 20px;
  flex-wrap: wrap;
}
#personal-hub .video-caption {
  flex: 1;
  align-content: start;
}
#personal-hub .video-caption p {
  max-width: 55ch;
}
#personal-hub .premise {
  max-width: 42ch;
}
#personal-hub .post time {
  color: inherit;
}
#personal-hub .traces-message {
  font-family: var(--font-body);
}

/* Native pointer on the hub; the rest of the site retains its cursor treatment. */
html.has-custom-cursor:has(#personal-hub),
html.has-custom-cursor:has(#personal-hub) * {
  cursor: auto !important;
}
html.has-custom-cursor:has(#personal-hub) a {
  cursor: pointer !important;
}
html:has(#personal-hub) #cursor {
  display: none;
}
/* One selection response across the hub. Inner links keep their own focus rings. */
#personal-hub :is(.tile, .traces) {
  transition: transform var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base);
}
#personal-hub :is(.tile, .traces):is(:focus-visible, :has(:focus-visible)) {
  transform: translateY(-3px);
  border-color: var(--gold);
  box-shadow: var(--shadow-hard-hover);
}
#personal-hub .tile:is(:focus-visible, :has(:focus-visible)):after {
  background: var(--gold);
}
#personal-hub .writing:is(:focus-visible, :has(:focus-visible)) { border-color: var(--ink); }
#personal-hub .writing:is(:focus-visible, :has(:focus-visible)):after { background: var(--ink); }
@media (hover:hover) and (pointer:fine) {
  #personal-hub :is(.tile, .traces):hover {
    transform: translateY(-3px);
    border-color: var(--gold);
    box-shadow: var(--shadow-hard-hover);
  }
  #personal-hub .tile:hover:after { background: var(--gold); }
  #personal-hub .writing:hover { border-color: var(--ink); }
  #personal-hub .writing:hover:after { background: var(--ink); }
}
@media (prefers-reduced-motion:reduce) {
  #personal-hub :is(.tile, .traces) { transition:none; transform:none !important; }
}
</style>
