---
import { getCollection } from 'astro:content';
import { join } from 'path';
import BaseLayout from '../layouts/BaseLayout.astro';
import BentoGrid from '../components/BentoGrid.astro';
import BentoTile from '../components/BentoTile.astro';
import { buildNovelTree, computeNovelStats, flattenFolderFiles } from '../utils/novel';
import { parseCurrentArc } from '../utils/currentArc';
import { stripMarkdown } from '../utils/content';
import { formatDate } from '../utils/dates';
import { readFileSync } from 'fs';
import { parseProtagonist, DEFAULT_PROTAGONIST } from '../utils/protagonist';

// Query all content collections. Notes/showcase are dated feeds; shelf is not.
const notes = await getCollection('notes', ({ data }) => !data.draft && data.publishedAt);
// The collage is a sample of the shelf, not a dated feed — requiring
// `publishedAt` here hid 25 of 29 entries and left the tile 4 covers wide.
// `effectiveDate` already sorts undated entries last.
const media = await getCollection('shelf', ({ data }) => !data.draft);
const showcase = await getCollection('showcase', ({ data }) => !data.draft && data.publishedAt);

// Query now collection for latest entry
const allNow = await getCollection('now', ({ data }) => !data.draft);
const latestNow = allNow.sort((a, b) =>
  new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime()
)[0];

// Format month and year for now tile
const nowDate = latestNow?.data.publishedAt;
const nowMonthYearUTC = nowDate
  ? nowDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' })
  : '';
const nowMonthYearLocal = nowDate
  ? nowDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })
  : '';

const DEFAULT_EMBLEM = '/images/emblems/default.svg';

const effectiveDate = (e: { data: { updatedAt?: Date; publishedAt?: Date } }) =>
  new Date(e.data.updatedAt || e.data.publishedAt || 0).getTime();

// Recent entries with emblems for core tile thumbnails
const recentShowcase = showcase
  .filter(e => e.data.publishedAt)
  .sort((a, b) => effectiveDate(b) - effectiveDate(a))
  .slice(0, 3)
  .map(e => ({ href: `/showcase/${e.slug}`, emblem: e.data.emblem ?? DEFAULT_EMBLEM, title: e.data.title }));

const recentMedia = [...media]
  .sort((a, b) => effectiveDate(b) - effectiveDate(a))
  .slice(0, 8)
  .map(e => ({ href: `/shelf/${e.slug}`, emblem: e.data.emblem ?? DEFAULT_EMBLEM, title: e.data.title }));

const shortDate = (ms: number) =>
  new Date(ms).toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' }).toLowerCase();

type JournalRow = { href: string; title: string; type: 'note' | 'showcase'; date: string };
const recentJournal: JournalRow[] = [
  ...notes.map(e => ({ href: `/notes/${e.slug}`, title: e.data.title, type: 'note' as const, d: effectiveDate(e) })),
  ...showcase.map(e => ({ href: `/showcase/${e.slug}`, title: e.data.title, type: 'showcase' as const, d: effectiveDate(e) })),
]
  .sort((a, b) => b.d - a.d)
  .slice(0, 5)
  .map(({ href, title, type, d }) => ({ href, title, type, date: shortDate(d) }));

// Latest tile pool — the latest 2 notes and latest 1 showcase, interleaved
// (note, showcase, note) so the client-side cycle alternates types.
const byDateDesc = (a: (typeof notes)[number], b: (typeof notes)[number]) =>
  effectiveDate(b) - effectiveDate(a);
const latestNotes = [...notes].sort(byDateDesc).slice(0, 2);
const latestShowcase = [...showcase].sort(byDateDesc).slice(0, 1);
const latestPool = [latestNotes[0], latestShowcase[0], latestNotes[1]].filter(Boolean);

// Novel — find most recently modified file date from MetaData.txt
const novelDir = join(process.cwd(), 'src/content/novel');
const novelTree = await buildNovelTree(novelDir);
let novelLastModified: Date | null = null;
let novelRecentFileTitle: string | null = null;
let novelRecentFolderTitle: string | null = null;
for (const folder of Object.values(novelTree)) {
  // flattenFolderFiles recurses the whole subtree, so files nested more than one
  // level deep (e.g. Manuscript/Arc 1/Scene) are considered, not just direct children.
  for (const file of flattenFolderFiles(folder)) {
    if (file.modified) {
      const d = new Date(file.modified);
      if (!isNaN(d.getTime()) && (!novelLastModified || d > novelLastModified)) {
        novelLastModified = d;
        novelRecentFileTitle = file.title;
        novelRecentFolderTitle = folder.title;
      }
    }
  }
}
const novelStats = computeNovelStats(novelTree);

// About tile data — current arc teaser, read the same way /about reads it.
let questsRaw = '';
try {
  questsRaw = readFileSync(join(process.cwd(), 'src/content/sessions/_quests.md'), 'utf-8');
} catch { /* missing file → no teaser */ }
const currentArc = parseCurrentArc(questsRaw);
// The arc's stat colour stays on /about, where the arc card is the subject
// and carries the stat emblem. Here it was the only non-gold accent on the
// page and #a855f7 measured 4.40:1 at 11px — under AA. Gold on both counts.
const arcColor = 'var(--color-gold)';

/* Name for the About tile — same source /about reads. */
let protagonist = DEFAULT_PROTAGONIST;
try {
  const protagonistRaw = readFileSync(join(process.cwd(), 'src/content/sessions/_protagonist.md'), 'utf-8');
  protagonist = parseProtagonist(protagonistRaw);
} catch {
  /* Missing file → defaults. */
}

// Prepare data for client-side cycling. The date is formatted at build time —
// absolute only, never time-since (no-shame invariant).
const latestEntries = latestPool.map(entry => ({
  title: entry.data.title,
  href: `/${entry.collection}/${entry.slug}`,
  date: formatDate(entry.data.updatedAt ?? entry.data.publishedAt!),
  emblem: entry.data.emblem ?? DEFAULT_EMBLEM,
  excerpt: stripMarkdown(entry.body ?? '').slice(0, 140),
}));

---

<BaseLayout title="Home" description="Notes, media, and showcases.">
  <div class="container" id="page-container">
    <BentoGrid>
      {/* Hero band — the row-1 tiles plus the Traces bar, wrapped as one
          full-width grid item. The bar needs to be ~40px tall, but the bento
          grid's implicit rows are minmax(100px, auto), so it can't simply be
          another row of the outer grid. The inner element reuses the
          .bento-grid class so it inherits the same 6/4/2/1-column responsive
          steps rather than duplicating those breakpoints. */}
      <div class="hero-band">
      <div class="bento-grid">
      <!-- Row 1: Title (4×1) + YouTube (1×1) + Now (1×1) -->
      <div class="title-tile p3r-animate-left">
        <div class="title-tile__inner">
          <div class="title-tile__rule title-tile__rule--top" aria-hidden="true"></div>
          <h1 class="title-tile__name"><span class="title-tile__name-inner">Ninjaruss</span></h1>
          <div class="title-tile__rule title-tile__rule--bottom" aria-hidden="true"></div>
        </div>
        <p class="title-tile__description">In spite of it all...</p>
      </div>

      <a
        id="yt-tile"
        href="https://www.youtube.com/@Ninjaruss_"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Ninjaruss on YouTube"
        class="image-tile image-tile--youtube p3r-animate"
        style="--stagger-delay: 100ms;"
      >
        <!-- Full-bleed channel avatar -->
        {/* object-fit: cover into a tall-ish slot means the 16:9 source is
            scaled by height, so the widest render (~684px at the 768 stacking
            breakpoint) needs more than the 640 variant on retina. */}
        <img
          class="yt-tile__avatar"
          src="/images/logos/yt-avatar-640.jpg"
          srcset="/images/logos/yt-avatar-640.jpg 640w, /images/logos/yt-avatar-1024.jpg 1024w"
          sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 177px"
          alt="Ninjaruss YouTube channel"
        />
        <span class="yt-tile__chip" aria-hidden="true">YouTube</span>

        <!-- Red tint on hover -->
        <div class="yt-tile__tint" aria-hidden="true"></div>

        <!-- Slide-up strip: YouTube branding -->
        <div class="yt-tile__strip" aria-hidden="true">
          <svg class="yt-tile__strip-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M23.495 6.205a3.007 3.007 0 0 0-2.088-2.088c-1.87-.501-9.396-.501-9.396-.501s-7.507-.010-9.396.501A3.007 3.007 0 0 0 .527 6.205a31.247 31.247 0 0 0-.522 5.805 31.247 31.247 0 0 0 .522 5.783 3.007 3.007 0 0 0 2.088 2.088c1.868.502 9.396.502 9.396.502s7.506 0 9.396-.502a3.007 3.007 0 0 0 2.088-2.088 31.247 31.247 0 0 0 .5-5.783 31.247 31.247 0 0 0-.5-5.805zM9.609 15.601V8.408l6.264 3.602z"/>
          </svg>
          <div class="yt-tile__strip-text">
            <div class="yt-tile__strip-name">Ninjaruss</div>
            <div class="yt-tile__strip-sub">YouTube</div>
          </div>
        </div>

        <!-- Live overlay: shown via .is-twitch-live class -->
        <div class="yt-tile__live-overlay" aria-hidden="true">
          <img
            class="yt-tile__preview"
            src="https://static-cdn.jtvnw.net/previews-ttv/live_user_ninjaruss_-440x248.jpg"
            alt="Live stream preview"
          />
          <div class="yt-tile__live-badge">LIVE</div>

          <!-- Slide-up strip: Twitch/live branding -->
          <div class="yt-tile__strip yt-tile__strip--live" aria-hidden="true">
            <svg class="yt-tile__strip-icon yt-tile__strip-icon--twitch" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714z"/>
            </svg>
            <div class="yt-tile__strip-text">
              <div class="yt-tile__strip-name">Ninjaruss</div>
              <div class="yt-tile__strip-sub">Watching live →</div>
            </div>
          </div>
        </div>
      </a>

      <!-- Now tile — row 1 col 6 -->
      <BentoTile
        href="/now"
        variant="highlight"
        label="Now"
        title={latestNow?.data.title ?? 'Current Focus'}
        description="Where am I at right now?"
        class="home-now-tile"
      >
        <span class="now-date" title={`Local: ${nowMonthYearLocal}`}>
          <span class="now-dot" aria-hidden="true"></span>
          {nowMonthYearUTC}
          {nowMonthYearLocal !== nowMonthYearUTC ? ` — ${nowMonthYearLocal} locally` : ''}
        </span>
      </BentoTile>

      </div>

      {/* Player-style bar flush under the hero row: the count doubles as the
          "there is something here" signal and the whole bar is the affordance
          to add one. Spans the full grid width as its own auto-placed row. */}
      <a href="/traces" class="traces-bar" id="traces-tab">
        <span class="traces-bar__count" id="traces-bar-count">Traces</span>
        <span class="traces-bar__field">Leave a trace — one line</span>
        <span class="traces-bar__send">Sign</span>
      </a>
      </div>

      <!-- Rows 2-3: Journal (4×2, slash split) + Novel (1×2) + Stream (1×2) -->
      <div class="bento-tile bento-tile--full bento-tile--highlight bento-tile--core bento-tile--span-4x2 journal-tile" data-tile-href="/journal">
        <div class="journal-tile__notes">
          <a href="/journal?types=note" class="journal-tile__head">
            <div class="bento-tile__header">
              <span class="bento-tile__label">Journal</span>
              <h3 class="bento-tile__title">Notes</h3>
            </div>
          </a>
          {recentJournal.length > 0 && (
            <div class="journal-tile__list">
              {recentJournal.map(row => (
                <a class="journal-tile__row" href={row.href} title={row.title}>
                  <span class="journal-tile__row-title">{row.title}</span>
                  <span class="journal-tile__date">{row.date}</span>
                </a>
              ))}
            </div>
          )}
        </div>
        {recentShowcase.length > 0 && (
          <div class="journal-tile__showcases">
            <a href="/journal?types=showcase" class="journal-tile__showcase-tab">Showcases</a>
            <div class="journal-tile__projects">
              {recentShowcase.map((entry, i) => (
                <a
                  href={entry.href}
                  class:list={['journal-tile__project', { 'journal-tile__project--recent': i === 0 }]}
                  title={entry.title}
                >
                  <img src={entry.emblem} alt="" loading="lazy" />
                  <span class="journal-tile__project-title">{entry.title}</span>
                </a>
              ))}
            </div>
          </div>
        )}
        <span class="bento-tile__corner" aria-hidden="true"></span>
      </div>

      <a
        href="/novel"
        class="bento-tile bento-tile--full bento-tile--small bento-tile--dark bento-tile--interactive bento-tile--span-1x2 novel-tile"
        id="novel-tile"
        data-scene-modified={novelStats.lastSceneModified ?? ''}
        data-outline-modified={novelStats.lastOutlineModified ?? ''}
      >
        <div class="novel-rain" aria-hidden="true">
          {Array.from({ length: 14 }, (_, i) => i).map(i => (
            <span class="novel-rain__drop" style={`--i: ${i}; --len: ${14 + (i % 3) * 8}px;`}></span>
          ))}
        </div>
        <div class="bento-tile__header">
          <span class="bento-tile__label">Visual Novel</span>
          <h3 class="bento-tile__title">Remember Rain</h3>
        </div>
        {novelRecentFolderTitle && novelRecentFileTitle && (
          <p class="novel-tile__recent">
            <span class="novel-tile__folder">{novelRecentFolderTitle}</span>
            <span class="novel-tile__sep">›</span>
            <span class="novel-tile__file">{novelRecentFileTitle}</span>
          </p>
        )}
        <p class="novel-tile__waits">the rain waits.</p>
        <div class="novel-tile__words">
          <span class="novel-tile__story">{novelStats.storyWords.toLocaleString('en-US')}</span>
          <span class="novel-tile__story-label">script words</span>
          <span class="novel-tile__outline">{novelStats.outlineWords.toLocaleString('en-US')} outline</span>
        </div>
        <span class="bento-tile__corner" aria-hidden="true"></span>
      </a>

      <a
        id="stream-tile"
        href="/about"
        class="bento-tile bento-tile--dark bento-tile--interactive stream-tile"
        style={`--st-lead: ${arcColor};`}
      >
        {/* Reads as a profile card first — a stranger should learn there is a
            person here (face, name, epithet), with the current arc underneath
            as evidence. The stat colour accents the arc's rule and label only;
            it used to tint the decision prose itself, which put an off-palette
            purple/green paragraph in the middle of a gold-and-black page. */}
        <div class="bento-tile__header">
          <span class="bento-tile__label">About</span>
        </div>

        <div class="st-id">
          {protagonist.portrait && (
            <img class="st-portrait" src={protagonist.portrait} alt="" loading="lazy" width="64" height="64" />
          )}
          <h3 class="st-name">{protagonist.name}</h3>
          {protagonist.epithet && <p class="st-epithet">{protagonist.epithet}</p>}
        </div>

        <div class="st-body">
          {currentArc ? (
            <>
              <span class="st-arc">{currentArc.arc}</span>
              <p class="st-teaser">{currentArc.decision}</p>
            </>
          ) : (
            <p class="st-teaser st-teaser--empty">The story hasn't started yet.</p>
          )}
        </div>

        <div class="st-footer">
          <span id="st-live-badge" class="st-live-badge" hidden>LIVE</span>
          <span class="st-cta">About<span aria-hidden="true"> →</span></span>
        </div>
        <span class="bento-tile__corner" aria-hidden="true"></span>
      </a>

      <!-- Rows 4-5: Media (2×2) + Latest (2×1) + MAL/Spotify (stacked 1×1) -->
      <BentoTile
        href="/shelf"
        variant="dark"
        label="Shelf"
        title="Media Log"
        class="bento-tile--core bento-tile--span-2x2 media-tile"
      >
        {recentMedia.length > 0 && (
          <div class="tile-poster-strip">
            {recentMedia.map(entry => (
              <div class="tile-poster" aria-hidden="true">
                <img src={entry.emblem} alt="" class="tile-poster__img" loading="lazy" />
              </div>
            ))}
          </div>
        )}
      </BentoTile>

      {latestEntries.length > 0 && (
        <a
          id="latest-tile"
          href={latestEntries[0].href}
          class="bento-tile bento-tile--full bento-tile--small bento-tile--dark bento-tile--span-2x2"
          data-entries={JSON.stringify(latestEntries)}
        >
          <div class="latest-tile__inner">
            <div class="latest-tile__text">
              <div class="bento-tile__header">
                <span class="bento-tile__label">Latest</span>
                <h3 class="bento-tile__title" id="latest-title">{latestEntries[0].title}</h3>
              </div>
              <p class="latest-tile__excerpt" id="latest-excerpt"></p>
              <div class="bento-tile__footer">
                <span class="latest-date" id="latest-date">{latestEntries[0].date}</span>
              </div>
            </div>
            <div class="latest-tile__emblem-wrap">
              <img
                id="latest-emblem"
                src={latestEntries[0].emblem}
                alt=""
                class="latest-tile__emblem"
                aria-hidden="true"
              />
            </div>
          </div>
          <span class="latest-tile__sweep" aria-hidden="true"></span>
          <span class="bento-tile__corner" aria-hidden="true"></span>
        </a>
      )}

      <a
        href="https://myanimelist.net/animelist/Ninjaruss_?status=7&order=4&order2=0"
        target="_blank"
        rel="noopener noreferrer"
        class="logo-tile logo-tile--mal p4g-sweep p3r-animate"
        style="--stagger-delay: 100ms;"
      >
        <span class="logo-tile__kicker" aria-hidden="true"><span>Watchlist</span></span>
        <img
          src="/images/logos/myanimelist.svg"
          alt="MyAnimeList"
          class="logo-tile__img"
        />
        <span class="logo-tile__label">MyAnimeList</span>
        <p class="logo-tile__description">Anime ratings and watch history.</p>
      </a>

      <a
        href="https://open.spotify.com/playlist/6PYIeR2dXsbTrk47TqetSD?si=2b68cabcfc26451c"
        target="_blank"
        rel="noopener noreferrer"
        class="logo-tile logo-tile--spotify p4g-sweep p3r-animate"
        style="--stagger-delay: 150ms;"
      >
        <span class="logo-tile__kicker" aria-hidden="true"><span>Listening</span></span>
        <img
          src="/images/logos/spotify.svg"
          alt="Spotify Playlist"
          class="logo-tile__img"
        />
        <span class="logo-tile__label">Spotify</span>
        <p class="logo-tile__description">A running playlist.</p>
      </a>

      <!-- Row 5 — email (2×1) fills the cols under MAL/Spotify (quote tile removed).
           The mailto: is assembled client-side on first interaction so the address
           never appears in the static HTML (bot-scrape mitigation). The static href
           is a real no-JS fallback (the /about Connect block), not a dead #anchor — with
           JS the click is always intercepted to open the mailto. -->
      <a href="/about" id="mail-tile" class="logo-tile logo-tile--mail p4g-sweep bento-tile--span-2x1 p3r-animate" style="--stagger-delay: 200ms;">
        <span class="logo-tile__kicker" aria-hidden="true"><span>Contact</span></span>
        <svg class="logo-tile__img" viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <rect x="2.5" y="5" width="19" height="14" rx="1.5"/>
          <path d="M3 6.5l9 6.5 9-6.5"/>
        </svg>
        <span class="logo-tile__label">Email</span>
        <p class="logo-tile__description">Connect with me directly.</p>
      </a>

    </BentoGrid>

    {/* Danmaku overlay — absolutely positioned over the hero row only (its
        height is synced to the title tile by JS). pointer-events: none so the
        tiles underneath stay fully clickable; individual bullets re-enable it
        for themselves. Sits inside .container, which is already relative. */}
    <div class="traces-sky" id="traces-sky" aria-hidden="true"></div>
    <p class="traces-park" id="traces-park" hidden></p>
  </div>

  <dialog id="traces-modal" class="traces-modal">
    <div class="traces-modal__header">
      <span class="p4g-tab">Traces</span>
      <button type="button" class="traces-modal__close" id="traces-modal-close" aria-label="Close">✕</button>
    </div>
    <div class="traces-modal__body" id="traces-modal-body">
      <p class="traces-modal__loading">Loading…</p>
    </div>
  </dialog>
</BaseLayout>

<style>
  .container {
    padding-top: var(--space-sm);
    padding-bottom: var(--space-md);
    position: relative;
  }

  .container::before {
    content: '';
    position: absolute;
    /* Drawn inside the container's own box: a negative inset hung the ring
       3px past the right edge and that was the page's horizontal overflow. */
    inset: 0;
    border-radius: var(--radius-lg);
    padding: 3px;
    background: linear-gradient(90deg, var(--color-live) 0%, #ff6a1a 35%, var(--color-gold) 65%, var(--color-live) 100%);
    background-size: 300% 100%;
    /* Mask trick: show only the 3px padding ring, hide the center */
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: destination-out;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 600ms ease;
    pointer-events: none;
    z-index: 100;
  }

  .container.is-live::before {
    opacity: 1;
    animation: live-border-flow 4s linear infinite;
  }

  @keyframes live-border-flow {
    0%   { background-position: 0% 0%; }
    100% { background-position: 300% 0%; }
  }

  /* Absolute entry date for the Latest tile (never time-since) */
  .latest-date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    /* Tile-internal dates are lowercase across the grid (the journal tile's
       "aug 1" rows set the pattern); formatDate's own output is untouched. */
    text-transform: lowercase;
    color: var(--color-gold-dim);
    letter-spacing: 0.06em;
    white-space: nowrap;
    border-left: 2px solid var(--color-gold-dim);
    padding-left: 6px;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  #latest-tile:hover .latest-date,
  #latest-tile:focus-visible .latest-date {
    color: var(--color-gold);
    border-color: var(--color-gold);
  }

  /* Logo Tiles (MyAnimeList, Spotify) */
  .logo-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    /* extra top padding clears the corner tab so centered content never sits under it */
    padding: calc(var(--space-md) + 1.5rem) var(--space-md) var(--space-md);
    background: var(--color-bg-elevated);
    border: var(--border-medium) solid var(--color-border);
    text-decoration: none;
    transition: all var(--transition-base);
    min-height: 80px;
    position: relative;
    border-radius: 0;
    /* corner cut — clip-path clips box-shadow (and same-element drop-shadow) — hover feedback is the sweep + lift instead */
    clip-path: polygon(
      0 0,
      100% 0,
      100% calc(100% - var(--cut-md)),
      calc(100% - var(--cut-md)) 100%,
      0 100%
    );
  }

  /* Flush inset corner tab — matches the shared .p4g-tab used on every other tile */
  .logo-tile__kicker {
    position: absolute;
    top: 0;
    left: 0;
    padding: var(--space-2xs) calc(var(--space-sm) + var(--cut-sm)) var(--space-2xs) var(--space-sm);
    background: var(--color-gold);
    color: var(--color-black);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    clip-path: polygon(0 0, 100% 0, calc(100% - var(--cut-sm)) 100%, 0 100%);
    z-index: 1;
  }

  .logo-tile__kicker > span {
    display: inline-block;
  }

  .logo-tile:hover,
  .logo-tile:focus-visible {
    transform: translate(-4px, -4px);
    border-color: var(--color-gold);
  }

  /* Sweep paints the tile gold — flip text to black for contrast */
  .logo-tile:hover .logo-tile__label,
  .logo-tile:focus-visible .logo-tile__label,
  .logo-tile:hover .logo-tile__description,
  .logo-tile:focus-visible .logo-tile__description {
    color: var(--color-black);
  }

  .logo-tile--mail {
    color: var(--color-gold-dim);
  }

  .logo-tile--mail:hover,
  .logo-tile--mail:focus-visible {
    color: var(--color-black);
  }

  /* No outline ring: clip-path would clip it — :focus-visible shows via the gold sweep + lift instead */

  .logo-tile__img {
    width: 48px;
    height: 48px;
    object-fit: contain;
  }

  .logo-tile__label {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    text-align: center;
  }

  .logo-tile__description {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-top: var(--space-xs);
    line-height: 1.4;
    text-align: center;

    /* Always visible, clamped to keep the 1×1 tile tidy; brightens on hover */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    opacity: 0.6;
    transition: opacity 200ms ease-out;
  }

  .logo-tile:hover .logo-tile__description,
  .logo-tile:focus-visible .logo-tile__description {
    opacity: 1;
  }

  /* ─── Title Tile ─────────────────────────────────────── */
  .title-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background-color: var(--color-black);
    /* Dot grid atmosphere */
    background-image: radial-gradient(circle, rgba(var(--color-gold-rgb), 0.07) 1px, transparent 1px);
    background-size: 22px 22px;
    border: var(--border-thick) solid var(--color-gold);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
    grid-column: span 4;
    grid-row: span 1;
    box-shadow:
      var(--shadow-glow),
      inset 0 0 60px rgba(var(--color-gold-rgb), 0.04);
    overflow: hidden;
    opacity: 1;
    transition: opacity var(--transition-base);
  }

  .title-tile__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    width: 100%;
    max-width: 320px;
  }

  /* Animated gold rules — shimmer sweep after initial reveal */
  .title-tile__rule {
    height: 2px;
    width: 100%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--color-gold) 20%,
      var(--color-gold-orange) 50%,
      var(--color-gold) 80%,
      transparent 100%
    );
    background-size: 200% 100%;
    border-radius: 2px;
  }

  .title-tile__rule--top {
    animation:
      p3r-wipe-reveal 500ms var(--animation-easing) 0ms backwards,
      rule-shimmer 5s ease-in-out 1.2s infinite;
  }

  .title-tile__rule--bottom {
    animation:
      p3r-wipe-reveal 500ms var(--animation-easing) 300ms backwards,
      rule-shimmer 5s ease-in-out 2s infinite;
  }

  @keyframes rule-shimmer {
    0%, 100% { background-position: 200% 0; opacity: 0.7; }
    50% { background-position: -100% 0; opacity: 1; }
  }

  .title-tile__name {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    color: var(--color-gold);
    letter-spacing: 0.02em;
    text-shadow:
      0 0 30px rgba(var(--color-gold-rgb), 0.6),
      0 0 60px rgba(var(--color-gold-rgb), 0.3);
    animation: p3r-animate-left 500ms var(--animation-easing) 100ms backwards;
  }

  .title-tile__name-inner {
    display: inline-block;
    transform: skewX(var(--skew-display));
  }

  /* Tagline: always subtly visible, sharpens on hover */
  .title-tile__description {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-top: var(--space-sm);
    line-height: 1.4;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    opacity: 0.45;
    transition: opacity 300ms ease-out;
  }

  /* Container tile: the only focusable is the "About" link inside it. */
  .title-tile:hover .title-tile__description,
  .title-tile:has(:focus-visible) .title-tile__description {
    opacity: 1;
  }

  /* ─── Journal Tile ────────────────────────────────────── */
  /* Journal tile — slash split: gold notes field / black showcases field.
     The black field is a ::before overlay clipped diagonally; both content
     columns are positioned to paint above it. */
  .journal-tile {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    gap: var(--space-md);
  }

  .journal-tile::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-bg-base);
    clip-path: polygon(66% 0, 100% 0, 100% 100%, 58% 100%);
    transition: clip-path var(--animation-base) var(--animation-easing);
    pointer-events: none;
  }

  /* The tile is a div — keyboard focus lands on its inner links, so the seam
     shift keys off `:has(:focus-visible)` rather than `:focus-visible`. */
  .journal-tile:hover::before,
  .journal-tile:has(:focus-visible)::before {
    clip-path: polygon(64% 0, 100% 0, 100% 100%, 56% 100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .journal-tile::before {
      transition: none;
    }
    .journal-tile:hover::before,
    .journal-tile:has(:focus-visible)::before {
      clip-path: polygon(66% 0, 100% 0, 100% 100%, 58% 100%);
    }
  }

  .journal-tile__notes,
  .journal-tile__showcases {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* Push showcase content clear of the seam so the diagonal never cuts across
     the chip or the first row — content sits fully on the black field. */
  .journal-tile__showcases {
    padding-left: var(--space-xl);
  }

  /* Corner triangle sits on the black field now — gold, not the highlight
     black (which would vanish). Extra class specificity beats bento.css. */
  .journal-tile.bento-tile--highlight .bento-tile__corner {
    background: var(--color-gold);
  }

  /* Showcases field — gold kicker tab + emblem/title project rows */
  /* 44px touch target without a 44px-tall gold slab: the box is 44 high and
     the chip is painted as a centred 22px band, so it still reads the same
     weight as the JOURNAL tab across the seam. A background-*colour* would
     fill the whole box, hence the flat gradient. */
  .journal-tile__showcase-tab {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    background-image: linear-gradient(var(--color-gold), var(--color-gold));
    background-repeat: no-repeat;
    background-position: center;
    /* 2em of the 11px label, so browser text-zoom scales the band with the
       type instead of leaving it stranded at a fixed 22px. */
    background-size: 100% 2em;
    color: var(--color-black);
    font-family: var(--font-display);
    font-size: var(--text-floor);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    text-decoration: none;
    transform: skewX(var(--skew-accent));
    transition: background-image var(--transition-fast), color var(--transition-fast);
  }

  .journal-tile__showcase-tab:hover,
  .journal-tile__showcase-tab:focus-visible {
    background-image: linear-gradient(var(--color-text), var(--color-text));
  }

  .journal-tile__projects {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    margin-top: var(--space-sm);
  }

  .journal-tile__project {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-2xs) var(--space-xs);
    text-decoration: none;
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    transition: background var(--transition-fast), color var(--transition-fast);
  }

  /* Mirror of the note rows' hover: gold-on-black side inverts to gold bg */
  .journal-tile__project:hover,
  .journal-tile__project:focus-visible {
    background: var(--color-gold);
    color: var(--color-black);
  }

  .journal-tile__project img {
    width: 42px;
    height: 42px;
    object-fit: cover;
    display: block;
    flex-shrink: 0;
    border: 2px solid var(--color-border-strong);
  }

  .journal-tile__project--recent img {
    border-color: var(--color-gold);
  }

  .journal-tile__project-title {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 1024px) {
    .journal-tile {
      grid-template-columns: 1fr;
    }

    /* The tile-relative diagonal can't track stacked content heights —
       paint the black field on the showcases block itself instead. */
    .journal-tile::before,
    .journal-tile:hover::before,
    .journal-tile:has(:focus-visible)::before {
      display: none;
    }

    .journal-tile__showcases {
      margin: 0 calc(-1 * var(--space-md)) calc(-1 * var(--space-md));
      padding: var(--space-md);
      padding-top: calc(var(--space-md) + 16px);
      background: var(--color-bg-base);
      clip-path: polygon(0 16px, 100% 0, 100% 100%, 0 100%);
    }
  }

  .journal-tile__head {
    display: flex;
    align-items: center;
    /* 44px touch floor — the heading keeps its own type size */
    min-height: 44px;
    text-decoration: none;
    color: inherit;
  }

  .journal-tile__head:hover .bento-tile__title,
  .journal-tile__head:focus-visible .bento-tile__title {
    text-decoration: underline;
    text-decoration-thickness: 3px;
  }

  .journal-tile__list {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    padding-right: var(--space-md);
  }

  .journal-tile__row {
    display: flex;
    align-items: center;
    min-height: 44px;
    gap: var(--space-xs);
    padding: var(--space-2xs) var(--space-xs);
    border-top: 1px solid rgba(0, 0, 0, 0.15);
    text-decoration: none;
    color: var(--color-black);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    transition: background var(--transition-fast);
  }

  .journal-tile__row:hover,
  .journal-tile__row:focus-visible {
    background: rgba(0, 0, 0, 0.85);
    color: var(--color-gold);
  }

  .journal-tile__row-title {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .journal-tile__date {
    flex-shrink: 0;
    margin-left: auto;
    font-size: var(--text-floor);
    letter-spacing: var(--tracking-label);
    opacity: 0.55;
  }

  /* ─── Media Tile ──────────────────────────────────────── */
  .media-tile {
    background-image: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 3px,
      rgba(var(--color-gold-rgb), 0.025) 3px,
      rgba(var(--color-gold-rgb), 0.025) 4px
    );
  }

  :global(.media-tile .bento-tile__footer) {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    flex: 1;
    margin-top: 0;
    justify-content: center;
  }

  .tile-poster-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-xs);
    align-items: center;
    clip-path: polygon(0 12%, 100% 0, 100% 100%, 0 100%);
  }

  .tile-poster {
    aspect-ratio: 2/3;
    overflow: hidden;
    border-radius: 3px;
    background: var(--color-bg-elevated);
  }

  .tile-poster__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0.75;
    transition: opacity 200ms;
  }

  .media-tile:hover .tile-poster__img,
  .media-tile:focus-visible .tile-poster__img {
    opacity: 0.9;
  }

  /* ─── Now Tile ────────────────────────────────────────── */
  .now-date {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-black);
    text-transform: lowercase;
  }

  /* Radar ping dot */
  .now-dot {
    position: relative;
    display: inline-block;
    width: 9px;
    height: 9px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--color-black);
  }

  /* Two expanding rings for radar ping effect */
  .now-dot::before,
  .now-dot::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 1.5px solid var(--color-black);
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .now-dot {
      animation: dot-breathe 2s ease-in-out infinite;
    }

    .now-dot::before {
      animation: radar-ping 2.4s ease-out 0.2s infinite;
    }

    .now-dot::after {
      animation: radar-ping 2.4s ease-out 1.2s infinite;
    }

  }

  @keyframes dot-breathe {
    0%, 100% { opacity: 0.9; transform: scale(1); }
    50% { opacity: 0.55; transform: scale(0.75); }
  }

  @keyframes radar-ping {
    0% { transform: scale(0.6); opacity: 0.7; }
    100% { transform: scale(3); opacity: 0; }
  }

  @keyframes now-pulse {
    0%, 100% { opacity: 0.7; transform: scale(1); }
    50% { opacity: 0.3; transform: scale(0.65); }
  }

  /* ─── Stream Tile ────────────────────────────────────── */
  .stream-tile {
    grid-row: span 2;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition:
      border-color var(--transition-fast),
      box-shadow var(--transition-fast),
      transform var(--transition-fast);
  }

  .stream-tile:hover,
  .stream-tile:focus-visible {
    border-color: var(--color-gold);
    box-shadow: var(--shadow-hard);
    transform: translate(-4px, -4px);
  }

  .stream-tile.is-live {
    border-color: var(--color-live);
    background: #181212;
    box-shadow: 4px 4px 0 rgba(var(--color-live-rgb), .35), 0 0 28px rgba(var(--color-live-rgb), .12);
    animation: stream-tile-pulse 2.5s ease-in-out infinite;
  }

  @keyframes stream-tile-pulse {
    0%, 100% { box-shadow: 4px 4px 0 rgba(var(--color-live-rgb), .35), 0 0 24px rgba(var(--color-live-rgb), .12); }
    50%       { box-shadow: 4px 4px 0 rgba(var(--color-live-rgb), .5),  0 0 40px rgba(var(--color-live-rgb), .22); }
  }

  /* CRT inset glow — always present, warms to red when live */
  .stream-tile::after {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 22px rgba(var(--color-gold-rgb), 0.04);
    pointer-events: none;
    z-index: 2;
    border-radius: inherit;
    transition: box-shadow 300ms;
  }

  .stream-tile:hover::after,
  .stream-tile:focus-visible::after {
    box-shadow: inset 0 0 28px rgba(var(--color-gold-rgb), 0.08);
  }

  .stream-tile.is-live::after {
    box-shadow: inset 0 0 22px rgba(var(--color-live-rgb), 0.1);
  }

  /* Identity block — face first, then name, then epithet. A profile card
     with no face was the weakest thing about the old tile: it was a kicker,
     a name and a floating paragraph. */
  .st-id {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-xs) var(--space-sm) 0;
    text-align: center;
  }

  .st-portrait {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center top;
    border: var(--border-thin) solid var(--st-lead);
    background: var(--color-surface-2);
    margin-bottom: var(--space-2xs);
  }

  .st-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-base);
    line-height: 1.1;
    color: var(--color-gold);
    letter-spacing: 0.03em;
  }

  .st-epithet {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-floor);
    line-height: 1.35;
    color: var(--color-text-subtle);
    text-wrap: balance;
  }

  .st-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2xs);
    padding: var(--space-sm) var(--space-sm) var(--space-xs);
  }

  /* The stat colour lives here — a short label over a hairline — instead of
     tinting the paragraph below it. */
  .st-arc {
    font-family: var(--font-mono);
    font-size: var(--text-floor);
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--st-lead);
    padding-bottom: var(--space-2xs);
    border-bottom: 1px solid color-mix(in srgb, var(--st-lead) 45%, transparent);
    text-align: center;
  }

  .st-teaser {
    margin: 0;
    text-align: center;
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--color-text-muted);
    letter-spacing: 0.01em;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    overflow: hidden;
  }

  .st-teaser--empty {
    color: var(--color-text-subtle);
    font-style: italic;
  }

  .st-footer {
    padding: 7px 11px;
    border-top: 1px solid var(--color-surface-1);
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    background: var(--color-black);
  }

  .st-cta {
    margin-left: auto;
    font-size: var(--text-floor);
    letter-spacing: .16em;
    text-transform: uppercase;
    color: rgba(var(--color-gold-rgb), .55);
    font-family: var(--font-mono);
    transition: color var(--transition-fast);
  }

  .stream-tile:hover .st-cta,
  .stream-tile:focus-visible .st-cta {
    color: rgba(var(--color-gold-rgb), .75);
  }

  .st-live-badge {
    font-size: var(--text-floor);
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--color-live);
    border: 1px solid rgba(var(--color-live-rgb), .4);
    border-radius: 3px;
    padding: 2px 5px;
    animation: st-badge-breathe 1.5s ease-in-out infinite;
  }

  .st-live-badge[hidden] { display: none; }

  @keyframes st-badge-breathe {
    0%, 100% { opacity: 1; }
    50%       { opacity: .45; }
  }

  /* ─── YouTube / Live Tile ────────────────────────────── */
  .image-tile--youtube {
    grid-column: span 1;
    grid-row: span 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: var(--border-thick) solid var(--color-border-strong);
    background: var(--color-bg-elevated);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast),
      border-color var(--transition-fast);
    box-shadow: var(--shadow-hard);
  }

  .image-tile--youtube:hover,
  .image-tile--youtube:focus-visible {
    transform: translate(-4px, -4px);
    box-shadow: var(--shadow-hard-hover);
    border-color: #ff0000;
  }

  .image-tile--youtube:active {
    transform: translate(0, 0);
    box-shadow: var(--shadow-hard-sm);
  }

  /* Full-bleed avatar */
  .yt-tile__avatar {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .yt-tile__chip {
    position: absolute;
    top: var(--space-xs);
    left: var(--space-xs);
    z-index: 2;
    padding: 2px 8px 2px 6px;
    background: var(--color-gold);
    color: var(--color-black);
    font-family: var(--font-display);
    font-size: var(--text-floor);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    clip-path: polygon(0 0, 100% 0, calc(100% - 5px) 100%, 0 100%);
  }

  /* Red tint overlay on hover */
  .yt-tile__tint {
    position: absolute;
    inset: 0;
    background: rgba(255, 0, 0, 0.1);
    opacity: 0;
    transition: opacity 0.2s;
    pointer-events: none;
    z-index: 1;
  }
  .image-tile--youtube:hover .yt-tile__tint,
  .image-tile--youtube:focus-visible .yt-tile__tint {
    opacity: 1;
  }

  /* Slide-up strip */
  .yt-tile__strip {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 10px 12px 11px;
    background: linear-gradient(to top, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.6) 70%, transparent 100%);
    display: flex;
    align-items: center;
    gap: 8px;
    transform: translateY(100%);
    transition: transform 0.26s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 2;
  }
  .image-tile--youtube:hover .yt-tile__strip,
  .image-tile--youtube:focus-visible .yt-tile__strip {
    transform: translateY(0);
  }
  .image-tile--youtube.is-twitch-live .yt-tile__strip:not(.yt-tile__strip--live) {
    transform: translateY(100%);
    pointer-events: none;
  }

  .yt-tile__strip-icon {
    width: 16px;
    height: 16px;
    color: #ff0000; /* YouTube brand red */
    flex-shrink: 0;
    filter: drop-shadow(0 0 4px rgba(255, 0, 0, 0.6));
  }
  .yt-tile__strip-icon--twitch {
    color: #9146ff;
    filter: drop-shadow(0 0 4px rgba(145, 70, 255, 0.6));
  }

  .yt-tile__strip-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .yt-tile__strip-name {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
    color: #fff;
    letter-spacing: .1em;
    text-transform: uppercase;
    line-height: 1.2;
  }
  .yt-tile__strip-sub {
    font-family: var(--font-mono);
    font-size: var(--text-floor);
    color: #aaa;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .yt-tile__strip--live .yt-tile__strip-sub {
    color: #ff9090;
  }

  /* Live overlay — hidden until .is-twitch-live */
  .yt-tile__live-overlay {
    position: absolute;
    inset: 0;
    z-index: 3;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--transition-base);
  }

  .image-tile--youtube.is-twitch-live .yt-tile__live-overlay {
    opacity: 1;
    pointer-events: auto;
  }

  .yt-tile__preview {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .yt-tile__live-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    background: var(--color-live);
    color: #fff;
    font-family: var(--font-mono);
    font-size: var(--text-floor);
    font-weight: 700;
    letter-spacing: .14em;
    padding: 3px 7px;
    border-radius: 3px;
    animation: yt-live-pulse 1.5s ease-in-out infinite;
  }

  @keyframes yt-live-pulse {
    0%, 100% { opacity: 1; }
    50%       { opacity: .5; }
  }

  /* Latest tile — flex row for text + emblem layout */
  .latest-tile__inner {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    justify-content: space-between;
    flex: 1;
    gap: var(--space-sm);
  }

  /* Cycle transition: a skewed gold panel sweeps across the tile — the same
     P4G move as the journal-entry hover (`.list-item::before`). It sweeps in to
     cover the tile, the script swaps the entry behind it, then it sweeps out to
     reveal the new one. */
  .latest-tile__sweep {
    position: absolute;
    inset: -2px;
    background: var(--color-gold);
    transform: translateX(-110%) skewX(var(--skew-accent));
    z-index: 4;
    pointer-events: none;
    opacity: 0;
  }

  #latest-tile.is-cycling .latest-tile__sweep {
    animation: latest-sweep 760ms var(--animation-easing);
  }

  @keyframes latest-sweep {
    0%   { transform: translateX(-110%) skewX(var(--skew-accent)); opacity: 1; }
    48%  { transform: translateX(0)     skewX(var(--skew-accent)); opacity: 1; }
    52%  { transform: translateX(0)     skewX(var(--skew-accent)); opacity: 1; }
    100% { transform: translateX(110%)  skewX(var(--skew-accent)); opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    #latest-tile.is-cycling .latest-tile__sweep {
      animation: none;
    }
  }

  .latest-tile__text {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1;
    min-width: 0;
  }

  .latest-tile__excerpt {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-top: var(--space-xs);
  }

  .latest-tile__emblem-wrap {
    flex-shrink: 0;
    position: relative;
    width: 34%;
    margin: calc(-1 * var(--space-md));
    margin-left: 0;
    padding: var(--space-md) var(--space-md) var(--space-md) var(--space-lg);
    clip-path: polygon(24% 0, 100% 0, 100% 100%, 6% 100%);
    background: rgba(0, 0, 0, 0.45);
    display: flex;
    align-items: center;
  }

  /* Gold hairline tracing the seam; -4deg measured against the rendered
     clip edge (24%→6% over the tile's height) so the line hugs it */
  .latest-tile__emblem-wrap::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 15%;
    width: 2px;
    background: var(--color-gold);
    transform: skewX(-4deg);
    opacity: 0.7;
  }

  .latest-tile__emblem {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    max-height: 100%;
    border-radius: var(--radius-sm);
    object-fit: cover;
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg-surface);
    opacity: 0.85;
    transition:
      opacity var(--transition-fast),
      border-color var(--transition-fast);
  }

  /* Novel tile — rain gauge: reward recent writing, never count absence */
  .novel-tile {
    position: relative;
    overflow: hidden;
    gap: var(--space-md);
  }

  .novel-rain {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 600ms ease;
  }

  .novel-tile.is-raining .novel-rain,
  .novel-tile.is-misting .novel-rain {
    opacity: var(--rain-strength, 0.5);
  }

  .novel-rain__drop {
    position: absolute;
    top: -30px;
    /* --x / --dur / --delay / --drop-op are randomized per drop by
       initializeNovelRain(); the calc() fallbacks keep an even, deterministic
       spread when JS hasn't run. */
    left: var(--x, calc(3% + var(--i) * 7%));
    width: 1px;
    height: var(--len, 22px);
    opacity: var(--drop-op, 1);
    background: linear-gradient(to bottom, transparent, rgba(157, 184, 204, 0.8));
    animation: novel-rain-fall var(--dur, 1.5s) linear infinite;
    animation-delay: var(--delay, calc(var(--i) * 0.13s));
  }

  .novel-tile.is-misting .novel-rain__drop {
    height: 9px;
    animation-duration: 2.6s;
  }

  @keyframes novel-rain-fall {
    to { transform: translateY(400px); }
  }

  .novel-tile__waits {
    display: none;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-style: italic;
    color: var(--color-text-muted);
    margin: auto 0;
  }

  .novel-tile.is-waiting .novel-tile__waits {
    display: block;
  }

  .novel-tile__words {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 2px;
    position: relative;
    z-index: 1;
  }

  .novel-tile__story {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-gold);
    line-height: 1;
  }

  .novel-tile__story-label {
    font-family: var(--font-mono);
    font-size: var(--text-floor);
    color: var(--color-gold-dim);
    text-transform: lowercase;
    letter-spacing: 0.06em;
  }

  .novel-tile__outline {
    font-family: var(--font-mono);
    font-size: var(--text-floor);
    color: var(--color-text-muted);
    margin-top: var(--space-2xs);
  }

  @media (prefers-reduced-motion: reduce) {
    .novel-rain__drop {
      animation: none;
      top: auto;
      bottom: 20%;
      height: 6px;
      opacity: 0.5;
    }
  }

  .novel-tile__recent {
    margin: 0;
    font-size: 0.7rem;
    color: var(--color-text-muted, rgba(245, 245, 245, 0.45));
    display: flex;
    align-items: center;
    gap: 0.3em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .novel-tile__sep {
    opacity: 0.5;
  }

  .novel-tile__file {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Tile border + corner triangle carry the hover highlight; emblem only brightens */
  #latest-tile:hover .latest-tile__emblem,
  #latest-tile:focus-visible .latest-tile__emblem {
    opacity: 1;
  }

  /* Reduced Motion Support */
  @media (prefers-reduced-motion: reduce) {
    .logo-tile__description {
      transition: opacity 100ms ease-out 0ms;
    }

    .logo-tile:hover .logo-tile__description,
    .logo-tile:focus-visible .logo-tile__description {
      transition-delay: 0ms;
    }

    .title-tile__rule--top,
    .title-tile__rule--bottom,
    .title-tile__name {
      animation: none;
    }

    .tile-poster__img,
    .latest-tile__emblem {
      transition: none;
    }

    .stream-tile.is-live    { animation: none; }
    .stream-tile::after     { transition: none; }
    .st-live-badge          { animation: none; }
    .container.is-live::before  { animation: none; background-position: 0% 0%; }
    .yt-tile__live-badge { animation: none; }
    .image-tile--youtube { transition: none; }
    .yt-tile__strip { transition: none; }
    .yt-tile__tint  { transition: none; }
  }

  /* 769–1024px is the only range where the grid is 4 columns but the title
     still spans 4 — it filled its own row and left YouTube + Now sitting in
     2 of the next row's 4 cells, half the row empty. Widen the pair instead
     of shrinking the title, so the wordmark keeps its full-bleed hero row.
     (≤768px already handles itself in the 2-column block below.) */
  @media (min-width: 769px) and (max-width: 1024px) {
    .image-tile--youtube,
    :global(.home-now-tile) {
      grid-column: span 2;
    }
  }

  @media (max-width: 768px) {
    .title-tile {
      grid-column: span 2;
      padding: var(--space-lg);
    }

    .title-tile__name {
      font-size: clamp(1.8rem, 8vw, 2.5rem);
    }

    .image-tile--youtube {
      grid-column: span 2;
      min-height: 200px;
    }

    /* Now fills the rest of its row so the following span-2 Journal tile
       doesn't wrap and leave a blank cell beside it. */
    :global(.home-now-tile) {
      grid-column: span 2;
    }

    .latest-tile__inner {
      flex-direction: column;
    }

    .latest-tile__emblem-wrap {
      width: auto;
      margin: 0 calc(-1 * var(--space-md)) calc(-1 * var(--space-md));
      clip-path: polygon(0 22%, 100% 0, 100% 100%, 0 100%);
      justify-content: center;
      padding: var(--space-md);
    }

    .latest-tile__emblem-wrap::before {
      display: none;
    }

    .latest-tile__emblem {
      max-width: 120px;
    }
  }

  @media (max-width: 480px) {
    .title-tile {
      grid-column: span 1;
      order: -1; /* keep the name/h1 first */
    }

    .title-tile__name {
      font-size: clamp(1.5rem, 6vw, 2rem);
    }

    /* Single column: float owned content (Journal/Now/Novel/Latest…)
       above the external service tiles, and let the YouTube tile read as a
       signal rather than a full-height hero. Grid honors `order` for
       auto-placement just like flex. */
    .image-tile--youtube {
      grid-column: span 1;
      min-height: 150px;
      order: 2;
    }

    .logo-tile {
      order: 2;
    }
  }

  /* ── Traces: danmaku over the hero ────────────────────────
     Comments fly right-to-left across the hero row itself rather than
     living in a strip of their own — that overlay-on-content behaviour is
     what makes danmaku read as danmaku. Motion is deliberately BOUNDED:
     one burst on arrival, then it settles and only the parked line remains
     (see initializeTracesHero). The homepage already spends a lot of its
     motion budget (novel rain, Latest cycling, live pulse), so a
     permanently looping overlay was too much on top of that. */
  .hero-band {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    /* `.bento-grid > *` carries the p3r-entrance-scale stagger, and this band
       is both a child of the outer grid and the parent of an inner one — so
       without this the tiles scale inside a band that is itself scaling, and
       the two transforms compound. The tiles keep their own entrance. */
    animation: none;
  }

  .traces-sky {
    position: absolute;
    top: var(--traces-sky-top, 0);
    left: var(--space-lg);
    right: var(--space-lg);
    height: var(--traces-sky-h, 0);
    overflow: hidden;
    pointer-events: none;
    z-index: 3;
    border-radius: var(--radius-lg);
  }

  /* Created client-side, so :global() — these never receive Astro's scoped
     data-astro-cid-* attribute. The heavy text-shadow is the danmaku
     signature and it is load-bearing here, not decoration: a bullet has to
     stay legible crossing from the black title tile onto the solid-gold Now
     tile in the same pass. */
  :global(.traces-bullet) {
    position: absolute;
    left: 0;
    white-space: nowrap;
    display: inline-flex;
    align-items: baseline;
    gap: 0.5em;
    padding: 0;
    background: none;
    border: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-white, #fff);
    text-shadow: 0 0 3px #000, 1px 1px 0 #000, -1px 1px 0 #000, 0 -1px 0 #000;
    cursor: pointer;
    pointer-events: auto;
    animation: traces-fly var(--bullet-duration, 12s) linear 1 both;
  }

  @keyframes traces-fly {
    from { transform: translateX(100%); }
    to   { transform: translateX(calc(-1 * var(--bullet-width, 400px))); }
  }

  :global(.traces-bullet__name) {
    color: var(--color-gold);
    font-weight: 700;
  }

  :global(.traces-bullet__time) {
    font-size: var(--text-floor);
    opacity: 0.65;
  }

  /* An older message from someone who has posted since — smaller and
     dimmer, so age is legible at a glance. */
  :global(.traces-bullet--echo) {
    font-size: var(--text-floor);
    opacity: 0.62;
  }

  /* The resting state. After the burst settles this is the only Traces
     motion left, and it only ever cross-fades in place — peripheral vision
     is tuned to translation, not opacity, which is why this can rotate
     through the whole backlog without reading as a busy page (same reason
     the Latest tile can cycle every 7s). */
  .traces-park {
    position: absolute;
    left: calc(var(--space-lg) + var(--space-md));
    top: calc(var(--traces-sky-top, 0px) + var(--traces-sky-h, 0px) - 1.9em);
    z-index: 4;
    margin: 0;
    max-width: min(48ch, calc(100% - 2 * var(--space-lg) - var(--space-2xl)));
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding-left: var(--space-xs);
    border-left: 2px solid var(--color-gold);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-shadow: 0 0 4px #000, 0 0 2px #000;
    transition: opacity 450ms ease;
  }

  .traces-park[hidden] { display: none; }

  /* :global() — the park's spans are built client-side in renderTracesPark,
     so they never receive Astro's scoped data-astro-cid-* attribute and a
     scoped selector silently never matches them. */
  :global(.traces-park__name) {
    color: var(--color-gold);
    font-weight: 700;
    /* em, not --space-2xs (2px): at this size that read as no gap at all
       and ran the name straight into the message. */
    margin-right: 0.5em;
  }

  :global(.traces-park__time) {
    font-size: var(--text-floor);
    opacity: 0.6;
    margin-left: 0.6em;
  }

  /* Player-chrome bar, flush under the hero. Auto-placed as its own grid
     row spanning all six columns. This is the affordance the pure-overlay
     versions lacked — on bilibili the input bar is what invites the
     comment in the first place. */
  .traces-bar {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 40px;
    padding: var(--space-2xs) var(--space-2xs) var(--space-2xs) var(--space-md);
    background: var(--color-bg-elevated);
    border: var(--border-thin) solid var(--color-surface-3);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .traces-bar:hover,
  .traces-bar:focus-visible {
    border-color: var(--color-gold-dim);
    background: var(--color-surface-2);
  }

  .traces-bar__count {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--text-floor);
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--color-gold);
    padding-right: var(--space-sm);
    border-right: 1px solid var(--color-surface-3);
  }

  .traces-bar__field {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }

  .traces-bar__send {
    flex-shrink: 0;
    padding: var(--space-2xs) var(--space-md);
    background: var(--color-gold);
    color: var(--color-black);
    font-family: var(--font-display);
    font-size: var(--text-floor);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    border-radius: var(--radius-sm);
  }

  .traces-bar:hover .traces-bar__send,
  .traces-bar:focus-visible .traces-bar__send {
    background: var(--color-gold-orange);
  }

  @media (max-width: 768px) {
    .traces-bar__field {
      display: none;
    }

    .traces-bar__count {
      flex: 1;
      border-right: 0;
    }
  }

  /* Flying text is the one thing this feature cannot do under reduced
     motion, so JS skips the burst and the rotation entirely and leaves the
     parked line static on the newest message. */
  @media (prefers-reduced-motion: reduce) {
    .traces-park {
      transition: none;
    }
  }

  .traces-modal {
    width: min(600px, 92vw);
    max-height: 85vh;
    margin: auto;
    padding: 0;
    background: var(--color-bg-base);
    border: var(--border-medium) solid var(--color-gold-dim);
    border-radius: var(--radius-md);
    color: var(--color-text);
  }

  .traces-modal::backdrop {
    background: rgba(0, 0, 0, 0.7);
  }

  .traces-modal__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-md) var(--space-lg);
    border-bottom: var(--border-thin) solid var(--color-border);
  }

  .traces-modal__close {
    min-width: 44px;
    min-height: 44px;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .traces-modal__close:hover,
  .traces-modal__close:focus-visible {
    color: var(--color-gold);
  }

  .traces-modal__body {
    padding: var(--space-lg);
    overflow-y: auto;
    max-height: calc(85vh - 60px);
  }

  /* :global() — the initial markup has this class on a static <p>, but
     openTracesModal() also re-injects it via body.innerHTML for the
     loading/error states, creating untagged elements each time. */
  :global(.traces-modal__loading) {
    color: var(--color-text-muted);
    font-style: italic;
    text-align: center;
    padding: var(--space-xl);
  }

  /* Empty state — same treatment as traces.astro's own .empty-state, but
     :global() + scoped under the modal body since this element is created
     client-side (renderTracesModalBody's innerHTML). */
  :global(.traces-modal__body .empty-state) {
    color: var(--color-text-muted);
    font-style: italic;
    text-align: center;
    padding: var(--space-xl);
  }

  /* The modal reuses the /traces page's form/list class names so styling
     stays in one place conceptually — copy the relevant blocks from
     traces.astro's <style> block here as well (form rows, submit button,
     list items) scoped under .traces-modal__body. All :global() — this
     entire subtree is built client-side via innerHTML/createElement in
     renderTracesModalBody/buildTraceListItem, so none of it ever receives
     Astro's scoped data-astro-cid-* attribute. */
  :global(.traces-modal__body .traces-form) {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-lg);
    border-bottom: var(--border-thin) solid var(--color-border);
  }

  :global(.traces-modal__body .traces-form__row) {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  :global(.traces-modal__body .traces-form__row label) {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--color-text-muted);
  }

  :global(.traces-modal__body .traces-form__row input) {
    min-height: 44px;
    padding: var(--space-sm) var(--space-md);
    background: var(--color-bg-elevated);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-size: var(--text-base);
  }

  :global(.traces-modal__body .traces-form__honeypot) {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  :global(.traces-modal__body .traces-form__submit) {
    align-self: flex-start;
    min-height: 44px;
    padding: var(--space-sm) var(--space-xl);
    background: var(--color-gold);
    color: var(--color-black);
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    border-radius: var(--radius-sm);
  }

  :global(.traces-modal__body .traces-form__status) {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    min-height: 1.5em;
  }

  :global(.traces-modal__body .traces-form__status[data-tone='error']) {
    color: var(--color-live);
  }

  :global(.traces-modal__body .traces-list) {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  :global(.traces-modal__body .traces-list__item) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-lg);
    background: var(--color-bg-elevated);
    border: var(--border-thin) solid var(--color-border);
    border-radius: var(--radius-md);
  }

  :global(.traces-modal__body .traces-list__item.is-highlighted) {
    border-color: var(--color-gold);
  }

  :global(.traces-modal__body .traces-list__name) {
    font-family: var(--font-display);
    color: var(--color-gold);
  }

  :global(.traces-modal__body .traces-list__message) {
    color: var(--color-text);
    flex: 1;
  }

  :global(.traces-modal__body .traces-list__date) {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
  }
</style>

<script>
  import { initBotId } from 'botid/client/core';
  import { formatTraceTimestamp, formatTraceTimestampCompact } from '../utils/tracesFormat';

  initBotId({
    protect: [{ path: '/api/traces', method: 'POST' }],
  });

  let liveInterval: ReturnType<typeof setInterval> | undefined;

  async function checkLiveStatus(): Promise<void> {
    try {
      const res = await fetch('/api/live-status');
      if (!res.ok) { applyLiveState(false, false); return; }
      const { live, twitch } = await res.json() as { live: boolean; twitch: boolean; youtube: boolean };
      applyLiveState(live, twitch);
    } catch {
      applyLiveState(false, false);
    }
  }

  function applyLiveState(isLive: boolean, twitchLive: boolean): void {
    const streamTile = document.getElementById('stream-tile') as HTMLAnchorElement | null;
    const container  = document.getElementById('page-container');
    const liveBadge  = document.getElementById('st-live-badge') as HTMLElement | null;
    const ytTile     = document.getElementById('yt-tile') as HTMLAnchorElement | null;

    streamTile?.classList.toggle('is-live', isLive);
    container?.classList.toggle('is-live', isLive);

    if (liveBadge) liveBadge.hidden = !isLive;

    if (ytTile) {
      ytTile.classList.toggle('is-twitch-live', twitchLive);
      ytTile.href = twitchLive
        ? 'https://twitch.tv/ninjaruss_'
        : 'https://www.youtube.com/@Ninjaruss_';
      ytTile.setAttribute('aria-label', twitchLive
        ? 'Watch Ninjaruss live on Twitch'
        : 'Ninjaruss on YouTube');
    }
  }

  function startLivePolling(): void {
    stopLivePolling();
    checkLiveStatus();
    liveInterval = setInterval(checkLiveStatus, 300_000);
  }

  function stopLivePolling(): void {
    if (liveInterval !== undefined) {
      clearInterval(liveInterval);
      liveInterval = undefined;
    }
  }

  // Latest tile — cycles through the latest notes/showcase entries.
  // Runs on initial load and after view transitions.
  let latestCycleTimer: number | undefined;

  function initializeLatestTile() {
    clearInterval(latestCycleTimer);
    const latestTile = document.getElementById('latest-tile') as HTMLAnchorElement | null;
    if (!latestTile) return;
    const entries = JSON.parse(latestTile.dataset.entries || '[]');
    if (entries.length === 0) return;

    const render = (entry: { href: string; title: string; excerpt?: string; emblem?: string; date?: string }) => {
      latestTile.href = entry.href;
      const titleEl = document.getElementById('latest-title');
      if (titleEl) titleEl.textContent = entry.title;

      const excerptEl = document.getElementById('latest-excerpt');
      if (excerptEl) excerptEl.textContent = entry.excerpt || '';

      const emblemEl = document.getElementById('latest-emblem') as HTMLImageElement | null;
      if (emblemEl && entry.emblem) emblemEl.src = entry.emblem;

      // Absolute date, formatted at build time — the tile never counts elapsed days.
      const dateEl = document.getElementById('latest-date');
      if (dateEl) dateEl.textContent = entry.date || '';
    };

    render(entries[0]);

    if (entries.length > 1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let index = 0;
      latestCycleTimer = window.setInterval(() => {
        index = (index + 1) % entries.length;
        // Gold panel sweeps across; swap the entry at the midpoint while the
        // panel covers the tile, then let it sweep out to reveal the new one.
        latestTile.classList.add('is-cycling');
        window.setTimeout(() => render(entries[index]), 365);
        window.setTimeout(() => latestTile.classList.remove('is-cycling'), 800);
      }, 7000);
    }
  }

  // Email tile — assemble the mailto only on first interaction so the
  // address never sits in the served HTML for scrapers.
  function initializeMailTile() {
    const tile = document.getElementById('mail-tile') as HTMLAnchorElement | null;
    if (!tile || tile.dataset.mailBound) return;   // guard: runs on both initial load and astro:page-load
    tile.dataset.mailBound = 'true';
    const addr = ['mailbox', ['ninjaruss', 'net'].join('.')].join('@');
    const arm = () => tile.setAttribute('href', 'mailto:' + addr);
    tile.addEventListener('pointerenter', arm, { once: true });
    tile.addEventListener('focus', arm, { once: true });
    tile.addEventListener('touchstart', arm, { once: true, passive: true });
    tile.addEventListener('click', (e) => {
      if (tile.getAttribute('href')?.startsWith('mailto:')) return;
      e.preventDefault();
      window.location.href = 'mailto:' + addr;
    });
  }

  // Whole-tile navigation for the journal tile: clicking any non-link area
  // routes to the journal. Entry links (rows, tabs, projects) handle their own
  // navigation and are left alone. A plain location assignment is used
  // deliberately — it's guaranteed to fire on a real click regardless of the
  // view-transition router's trusted-event gating.
  function initializeJournalTileNav() {
    const tile = document.querySelector('.journal-tile') as HTMLElement | null;
    if (!tile || tile.dataset.navBound) return;
    tile.dataset.navBound = 'true';
    const href = tile.dataset.tileHref || '/journal';
    tile.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) return;
      window.location.href = href;
    });
  }

  // Novel rain gauge — full rain for recent scene work, mist for outline-only,
  // still "the rain waits." past 14 quiet days. Reward accretion; never count absence.
  function initializeNovelRain() {
    const tile = document.getElementById('novel-tile');
    if (!tile) return;
    tile.classList.remove('is-raining', 'is-misting', 'is-waiting');

    const daysSince = (iso: string | undefined): number | null => {
      if (!iso) return null;
      const d = new Date(iso);
      if (isNaN(d.getTime())) return null;
      const today = new Date();
      const todayUTC = Date.UTC(today.getFullYear(), today.getMonth(), today.getDate());
      const dUTC = Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate());
      return Math.floor((todayUTC - dUTC) / 86_400_000);
    };

    const WINDOW = 14;
    const sceneDays = daysSince((tile as HTMLElement).dataset.sceneModified);
    const outlineDays = daysSince((tile as HTMLElement).dataset.outlineModified);

    // Give each drop its own position, fall speed, delay, length and opacity so
    // the rain reads as organic rather than a uniform comb of columns. Re-rolled
    // on each init (initial load + astro:page-load), so it varies every visit.
    // A small jitter around an even base keeps drops from clumping or gapping.
    const randomizeDrops = () => {
      const drops = tile.querySelectorAll<HTMLElement>('.novel-rain__drop');
      const n = drops.length || 1;
      drops.forEach((drop, i) => {
        const base = (i + 0.5) / n;                          // even slot center 0..1
        const x = Math.min(0.98, Math.max(0.02, base + (Math.random() - 0.5) * (1.4 / n)));
        drop.style.setProperty('--x', `${(x * 100).toFixed(2)}%`);
        drop.style.setProperty('--len', `${(9 + Math.random() * 26).toFixed(1)}px`);
        drop.style.setProperty('--dur', `${(0.95 + Math.random() * 1.4).toFixed(2)}s`);
        drop.style.setProperty('--delay', `${(Math.random() * 2).toFixed(2)}s`);
        drop.style.setProperty('--drop-op', (0.4 + Math.random() * 0.6).toFixed(2));
      });
    };

    if (sceneDays !== null && sceneDays <= WINDOW) {
      tile.classList.add('is-raining');
      (tile as HTMLElement).style.setProperty('--rain-strength', String(Math.max(0.2, 1 - sceneDays / WINDOW)));
      randomizeDrops();
    } else if (outlineDays !== null && outlineDays <= WINDOW) {
      tile.classList.add('is-misting');
      (tile as HTMLElement).style.setProperty('--rain-strength', String(Math.max(0.15, 0.5 * (1 - outlineDays / WINDOW))));
      randomizeDrops();
    } else {
      tile.classList.add('is-waiting');
    }
  }

  // Mouse-tracking 3D tilt for all tile types
  function initializeTilt() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!window.matchMedia('(hover: hover)').matches) return;

    const SELECTOR = '.bento-tile--interactive, .logo-tile, .image-tile, .title-tile';
    const MAX_TILT = 6;

    document.querySelectorAll<HTMLElement>(SELECTOR).forEach(tile => {
      if (tile.dataset.tiltBound) return;   // guard: runs on both initial load and astro:page-load
      tile.dataset.tiltBound = 'true';
      let rafId: number;

      tile.addEventListener('mousemove', (e) => {
        cancelAnimationFrame(rafId);
        rafId = requestAnimationFrame(() => {
          const rect = tile.getBoundingClientRect();
          const cx = rect.left + rect.width / 2;
          const cy = rect.top + rect.height / 2;
          const rx = ((e.clientY - cy) / (rect.height / 2)) * -MAX_TILT;
          const ry = ((e.clientX - cx) / (rect.width / 2)) * MAX_TILT;
          tile.style.transform = `perspective(700px) rotateX(${rx}deg) rotateY(${ry}deg) translate(-4px, -4px)`;
        });
      });

      tile.addEventListener('mouseleave', () => {
        cancelAnimationFrame(rafId);
        tile.style.transform = '';
      });
    });
  }


  interface TraceEntry {
    id: number;
    name: string;
    message: string;
    createdAt: string;
  }

  interface TracesSpawnItem {
    entry: TraceEntry;
    isEcho: boolean;
  }

  const TRACES_FETCH_LIMIT = 30;
  const TRACES_BURST_MAX = 4;          // bullets in the arrival burst
  const TRACES_BURST_GAP_MS = 1100;    // stagger between them
  const TRACES_HOVER_GAP_MS = 1500;    // cadence while hovering the hero
  const TRACES_PARK_ROTATE_MS = 7000;  // parked-line cross-fade interval
  const TRACES_PARK_FADE_MS = 450;
  const TRACES_BULLET_MIN_MS = 8000;
  const TRACES_BULLET_MS_PER_CHAR = 90;

  let tracesQueue: TracesSpawnItem[] = [];
  let tracesBurstTimers: number[] = [];
  let tracesParkTimer: number | undefined;
  let tracesHoverTimer: number | undefined;
  let tracesParkIndex = 0;
  let tracesHoverIndex = 0;
  let tracesSkyObserver: ResizeObserver | undefined;

  function tracesReduceMotion(): boolean {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  // Groups by (trimmed, lowercased) name — "same person" can only be
  // approximated that way since names are free text, not accounts. Each
  // group's newest message is a "primary"; their older ones follow as
  // "echoes", so a person's history stays together wherever this queue is
  // consumed (the burst, the hover stream, the parked rotation).
  function buildTracesSpawnQueue(entries: TraceEntry[]): TracesSpawnItem[] {
    const groups = new Map<string, TraceEntry[]>();
    for (const entry of entries) {
      const key = entry.name.trim().toLowerCase();
      const list = groups.get(key);
      if (list) list.push(entry); else groups.set(key, [entry]);
    }

    const byNewest = (a: TraceEntry, b: TraceEntry) =>
      new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime();
    const ordered = [...groups.values()]
      .map(list => [...list].sort(byNewest))
      .sort((a, b) => byNewest(a[0], b[0]));

    const queue: TracesSpawnItem[] = [];
    for (const group of ordered) {
      queue.push({ entry: group[0], isEcho: false });
      for (const echo of group.slice(1)) queue.push({ entry: echo, isEcho: true });
    }
    return queue;
  }

  function spawnTracesBullet(item: TracesSpawnItem): void {
    const sky = document.getElementById('traces-sky');
    if (!sky) return;

    const bullet = document.createElement('button');
    bullet.type = 'button';
    bullet.className = 'traces-bullet' + (item.isEcho ? ' traces-bullet--echo' : '');
    bullet.tabIndex = -1;   // the bar and the modal are the keyboard path in
    bullet.dataset.traceId = String(item.entry.id);

    const nameEl = document.createElement('span');
    nameEl.className = 'traces-bullet__name';
    nameEl.textContent = item.entry.name;
    const msgEl = document.createElement('span');
    msgEl.textContent = item.entry.message;
    const timeEl = document.createElement('span');
    timeEl.className = 'traces-bullet__time';
    timeEl.textContent = formatTraceTimestampCompact(item.entry.createdAt);
    bullet.append(nameEl, msgEl, timeEl);

    // Random lane + length-scaled duration, so a burst never looks like a
    // queue draining at a fixed rate.
    bullet.style.top = `${(6 + Math.random() * 74).toFixed(1)}%`;
    const duration = Math.max(
      TRACES_BULLET_MIN_MS,
      item.entry.message.length * TRACES_BULLET_MS_PER_CHAR,
    );
    bullet.style.setProperty('--bullet-duration', `${duration}ms`);
    bullet.addEventListener('click', () => openTracesModal(item.entry.id));
    bullet.addEventListener('animationend', () => bullet.remove());

    sky.appendChild(bullet);
    // The fly keyframe ends at -1 × the bullet's own width, which is only
    // measurable once it is in the DOM.
    bullet.style.setProperty('--bullet-width', `${bullet.offsetWidth}px`);
  }

  function renderTracesPark(item: TracesSpawnItem): void {
    const park = document.getElementById('traces-park');
    if (!park) return;
    park.replaceChildren();
    const nameEl = document.createElement('span');
    nameEl.className = 'traces-park__name';
    nameEl.textContent = item.entry.name;
    const msgEl = document.createElement('span');
    msgEl.textContent = item.entry.message;
    const timeEl = document.createElement('span');
    timeEl.className = 'traces-park__time';
    timeEl.textContent = formatTraceTimestampCompact(item.entry.createdAt);
    park.append(nameEl, msgEl, timeEl);
    park.dataset.traceId = String(item.entry.id);
    park.removeAttribute('hidden');
  }

  function startTracesParkRotation(): void {
    clearInterval(tracesParkTimer);
    if (tracesQueue.length === 0) return;
    renderTracesPark(tracesQueue[0]);
    if (tracesQueue.length <= 1 || tracesReduceMotion()) return;

    tracesParkTimer = window.setInterval(() => {
      const park = document.getElementById('traces-park');
      if (!park) return;
      park.style.opacity = '0';
      window.setTimeout(() => {
        tracesParkIndex = (tracesParkIndex + 1) % tracesQueue.length;
        renderTracesPark(tracesQueue[tracesParkIndex]);
        park.style.opacity = '1';
      }, TRACES_PARK_FADE_MS);
    }, TRACES_PARK_ROTATE_MS);
  }

  function stopTracesBurst(): void {
    tracesBurstTimers.forEach(t => clearTimeout(t));
    tracesBurstTimers = [];
  }

  // One bounded wave on arrival. Cancelled if the visitor scrolls past the
  // hero mid-burst — they have moved on, so finishing it is just noise
  // behind them — and fired at most once per session so hopping home from
  // /journal does not replay it every time.
  function runTracesBurst(): void {
    if (tracesReduceMotion()) return;
    try {
      if (sessionStorage.getItem('traces-burst') === 'done') return;
      sessionStorage.setItem('traces-burst', 'done');
    } catch { /* private mode — just play it */ }

    const count = Math.min(TRACES_BURST_MAX, tracesQueue.length);
    for (let i = 0; i < count; i++) {
      tracesBurstTimers.push(window.setTimeout(() => spawnTracesBullet(tracesQueue[i]), i * TRACES_BURST_GAP_MS));
    }

    const sky = document.getElementById('traces-sky');
    if (sky && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(entries => {
        if (!entries[0].isIntersecting) { stopTracesBurst(); io.disconnect(); }
      });
      io.observe(sky);
    }
  }

  // Hovering the hero pulls the flight back on demand — anyone hovering the
  // nameplate has stopped scanning the page, so it is the one moment dense
  // motion is welcome rather than intrusive.
  function bindTracesHover(): void {
    const hero = document.getElementById('traces-sky')?.parentElement;
    if (!hero || tracesReduceMotion()) return;

    hero.addEventListener('mouseenter', () => {
      if (tracesHoverTimer || tracesQueue.length === 0) return;
      const tick = () => spawnTracesBullet(tracesQueue[tracesHoverIndex++ % tracesQueue.length]);
      tick();
      tracesHoverTimer = window.setInterval(tick, TRACES_HOVER_GAP_MS);
    });
    hero.addEventListener('mouseleave', () => {
      clearInterval(tracesHoverTimer);
      tracesHoverTimer = undefined;
    });
  }

  // The sky is absolutely positioned and has to cover exactly the hero row,
  // whose height is content-driven — so it is measured from the title tile
  // rather than guessed. Same "publish a measured height as a CSS var"
  // pattern the NavPill uses for --nav-clearance.
  function syncTracesSkyHeight(): void {
    const title = document.querySelector<HTMLElement>('.title-tile');
    const container = document.getElementById('page-container');
    if (!title || !container) return;
    // offsetTop/offsetHeight, NOT getBoundingClientRect: the title tile runs
    // a translate-based entrance animation (.p3r-animate-left) and a rect
    // measured mid-flight bakes that transform into the sky's position.
    // Both offset* values are transform-immune, and offsetTop is already
    // relative to .container (the nearest positioned ancestor) measured from
    // the same padding edge that `top` resolves against.
    const apply = () => {
      container.style.setProperty('--traces-sky-top', `${title.offsetTop}px`);
      container.style.setProperty('--traces-sky-h', `${title.offsetHeight}px`);
    };
    apply();
    tracesSkyObserver?.disconnect();
    if ('ResizeObserver' in window) {
      tracesSkyObserver = new ResizeObserver(apply);
      tracesSkyObserver.observe(title);
      tracesSkyObserver.observe(container);
    }
    // The first measurement runs before webfonts land, which changes the
    // tile's height — re-measure once each settles rather than trusting the
    // observer alone to catch it.
    window.addEventListener('load', apply, { once: true });
    window.addEventListener('resize', apply);
    document.fonts?.ready.then(apply).catch(() => {});
  }

  function stopTracesHero(): void {
    stopTracesBurst();
    clearInterval(tracesParkTimer);
    clearInterval(tracesHoverTimer);
    tracesParkTimer = undefined;
    tracesHoverTimer = undefined;
    tracesParkIndex = 0;
    tracesHoverIndex = 0;
    tracesQueue = [];
    tracesSkyObserver?.disconnect();
    tracesSkyObserver = undefined;
    document.querySelectorAll('.traces-bullet').forEach(b => b.remove());
  }

  async function initializeTracesHero(): Promise<void> {
    const sky = document.getElementById('traces-sky');
    if (!sky || sky.dataset.bound === 'true') return;
    sky.dataset.bound = 'true';

    syncTracesSkyHeight();

    let entries: TraceEntry[];
    let total = 0;
    try {
      const res = await fetch(`/api/traces?limit=${TRACES_FETCH_LIMIT}`);
      if (!res.ok) return;
      const data = await res.json() as { entries: TraceEntry[]; total?: number };
      entries = data.entries;
      total = data.total ?? data.entries.length;
    } catch {
      return;
    }

    const countEl = document.getElementById('traces-bar-count');
    if (countEl) countEl.textContent = total === 1 ? '1 trace' : `${total} traces`;

    if (entries.length === 0) return;

    tracesQueue = buildTracesSpawnQueue(entries);
    startTracesParkRotation();
    bindTracesHover();
    runTracesBurst();
  }

  function bindTracesModal(): void {
    const tab = document.getElementById('traces-tab');
    const modal = document.getElementById('traces-modal') as HTMLDialogElement | null;
    const closeBtn = document.getElementById('traces-modal-close');
    if (!tab || !modal || !closeBtn) return;
    if (modal.dataset.bound === 'true') return;
    modal.dataset.bound = 'true';

    tab.addEventListener('click', (e) => {
      const evt = e as MouseEvent;
      if (evt.metaKey || evt.ctrlKey || evt.shiftKey || evt.altKey || evt.button !== 0) return;
      e.preventDefault();
      // Land on whichever message the parked line is currently showing, so
      // opening the modal continues from what the visitor was just reading.
      const parkedId = Number(document.getElementById('traces-park')?.dataset.traceId);
      openTracesModal(Number.isNaN(parkedId) ? undefined : parkedId);
    });

    closeBtn.addEventListener('click', () => modal.close());

    // Click on the backdrop (the dialog element itself, outside its content box) closes it.
    modal.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });
  }

  async function openTracesModal(scrollToId?: number): Promise<void> {
    const modal = document.getElementById('traces-modal') as HTMLDialogElement | null;
    const body = document.getElementById('traces-modal-body');
    if (!modal || !body) return;

    modal.showModal();

    if (body.dataset.loaded !== 'true') {
      body.innerHTML = '<p class="traces-modal__loading">Loading…</p>';
      try {
        const res = await fetch('/api/traces');
        const data = await res.json() as { entries: TraceEntry[] };
        renderTracesModalBody(body, data.entries);
        body.dataset.loaded = 'true';
      } catch {
        body.innerHTML = '<p class="traces-modal__loading">Couldn\'t load — try again.</p>';
        return;
      }
    }

    if (scrollToId !== undefined) {
      body.querySelectorAll('.is-highlighted').forEach(el => el.classList.remove('is-highlighted'));
      const target = body.querySelector(`[data-trace-id="${scrollToId}"]`);
      target?.scrollIntoView({ block: 'nearest' });
      target?.classList.add('is-highlighted');
    }
  }

  function renderTracesModalBody(body: HTMLElement, entries: TraceEntry[]): void {
    body.innerHTML = `
      <form id="traces-modal-form" class="traces-form">
        <div class="traces-form__row">
          <label for="tr-modal-name">Name</label>
          <input id="tr-modal-name" name="name" type="text" maxlength="40" required />
        </div>
        <div class="traces-form__row">
          <label for="tr-modal-message">Message</label>
          <input id="tr-modal-message" name="message" type="text" maxlength="100" placeholder="leave a trace — one line" required />
        </div>
        <div class="traces-form__honeypot" aria-hidden="true">
          <label for="tr-modal-website">Website</label>
          <input id="tr-modal-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <button type="submit" class="traces-form__submit p4g-sweep"><span>Sign</span></button>
        <p id="traces-modal-status" class="traces-form__status" role="status"></p>
      </form>
      <ul id="traces-modal-list" class="traces-list"></ul>
    `;

    const list = body.querySelector('#traces-modal-list') as HTMLElement;
    for (const entry of entries) {
      list.appendChild(buildTraceListItem(entry));
    }
    if (entries.length === 0) {
      list.outerHTML = '<p class="empty-state">No one\'s signed yet — be the first.</p>';
    }

    const form = body.querySelector('#traces-modal-form') as HTMLFormElement;
    const status = body.querySelector('#traces-modal-status') as HTMLElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      const formData = new FormData(form);
      const payload = {
        name: formData.get('name'),
        message: formData.get('message'),
        website: formData.get('website'),
      };

      if (submitBtn) submitBtn.disabled = true;
      status.textContent = '';
      status.removeAttribute('data-tone');

      try {
        const res = await fetch('/api/traces', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          status.textContent = (data as { error?: string }).error || 'Something went wrong.';
          status.dataset.tone = 'error';
          return;
        }

        const entry = await res.json() as { id: number; name: string; message: string; createdAt: string };
        const emptyState = body.querySelector('.empty-state');
        let listEl = body.querySelector('#traces-modal-list') as HTMLElement | null;
        if (emptyState && !listEl) {
          listEl = document.createElement('ul');
          listEl.id = 'traces-modal-list';
          listEl.className = 'traces-list';
          emptyState.replaceWith(listEl);
        }
        listEl?.prepend(buildTraceListItem(entry));

        form.reset();
        status.textContent = 'Signed — thanks for leaving a trace.';
      } catch {
        status.textContent = 'Network error — please try again.';
        status.dataset.tone = 'error';
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  }

  function buildTraceListItem(entry: { id: number; name: string; message: string; createdAt: string }): HTMLLIElement {
    const li = document.createElement('li');
    li.className = 'traces-list__item';
    li.dataset.traceId = String(entry.id);
    const name = document.createElement('span');
    name.className = 'traces-list__name';
    name.textContent = entry.name;
    const message = document.createElement('span');
    message.className = 'traces-list__message';
    message.textContent = entry.message;
    const date = document.createElement('span');
    date.className = 'traces-list__date';
    date.textContent = formatTraceTimestamp(entry.createdAt);
    li.append(name, message, date);
    return li;
  }

  // Run on initial page load
  initializeLatestTile();
  initializeNovelRain();
  initializeTilt();
  initializeMailTile();
  initializeJournalTileNav();
  startLivePolling();
  initializeTracesHero();
  bindTracesModal();

  // Run after each view transition navigation
  document.addEventListener('astro:page-load', () => {
    initializeLatestTile();
    initializeNovelRain();
    initializeTilt();
    initializeMailTile();
    initializeJournalTileNav();
    startLivePolling();
    initializeTracesHero();
    bindTracesModal();
  });

  // Clean up intervals before navigating away
  document.addEventListener('astro:before-preparation', () => {
    stopLivePolling();
    clearInterval(latestCycleTimer);
    stopTracesHero();
  });
</script>
