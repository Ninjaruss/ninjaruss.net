</style>

<script>
  let liveInterval: ReturnType<typeof setInterval> | undefined;

  async function checkLiveStatus(): Promise<void> {
    try {
      const res = await fetch('/api/live-status');
      if (!res.ok) { applyLiveState(false, false); return; }
      const { live, twitch } = await res.json() as { live: boolean; twitch: boolean; youtube: boolean };
      applyLiveState(live, twitch);
    } catch {
      applyLiveState(false, false);
    }
  }

  function applyLiveState(isLive: boolean, twitchLive: boolean): void {
    const streamTile = document.getElementById('stream-tile') as HTMLAnchorElement | null;
    const container  = document.getElementById('page-container');
    const liveBadge  = document.getElementById('st-live-badge') as HTMLElement | null;
    const ytTile     = document.getElementById('yt-tile') as HTMLAnchorElement | null;

    streamTile?.classList.toggle('is-live', isLive);
    container?.classList.toggle('is-live', isLive);

    if (liveBadge) liveBadge.hidden = !isLive;

    if (ytTile) {
      ytTile.classList.toggle('is-twitch-live', twitchLive);
      ytTile.href = twitchLive
        ? 'https://twitch.tv/ninjaruss_'
        : 'https://www.youtube.com/@Ninjaruss_';
      ytTile.setAttribute('aria-label', twitchLive
        ? 'Watch Ninjaruss live on Twitch'
        : 'Ninjaruss on YouTube');
    }
  }

  function startLivePolling(): void {
    stopLivePolling();
    checkLiveStatus();
    liveInterval = setInterval(checkLiveStatus, 300_000);
  }

  function stopLivePolling(): void {
    if (liveInterval !== undefined) {
      clearInterval(liveInterval);
      liveInterval = undefined;
    }
  }

  // Latest tile — cycles through the latest notes/showcase entries.
  // Runs on initial load and after view transitions.
  let latestCycleTimer: number | undefined;

  function initializeLatestTile() {
    clearInterval(latestCycleTimer);
    const latestTile = document.getElementById('latest-tile') as HTMLAnchorElement | null;
    if (!latestTile) return;
    const entries = JSON.parse(latestTile.dataset.entries || '[]');
    if (entries.length === 0) return;

    const render = (entry: { href: string; title: string; excerpt?: string; emblem?: string; date?: string }) => {
      latestTile.href = entry.href;
      const titleEl = document.getElementById('latest-title');
      if (titleEl) titleEl.textContent = entry.title;

      const excerptEl = document.getElementById('latest-excerpt');
      if (excerptEl) excerptEl.textContent = entry.excerpt || '';

      const emblemEl = document.getElementById('latest-emblem') as HTMLImageElement | null;
      if (emblemEl && entry.emblem) emblemEl.src = entry.emblem;

      // Absolute date, formatted at build time — the tile never counts elapsed days.
      const dateEl = document.getElementById('latest-date');
      if (dateEl) dateEl.textContent = entry.date || '';
    };

    render(entries[0]);

    if (entries.length > 1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let index = 0;
      latestCycleTimer = window.setInterval(() => {
        index = (index + 1) % entries.length;
        // Gold panel sweeps across; swap the entry at the midpoint while the
        // panel covers the tile, then let it sweep out to reveal the new one.
        latestTile.classList.add('is-cycling');
        window.setTimeout(() => render(entries[index]), 365);
        window.setTimeout(() => latestTile.classList.remove('is-cycling'), 800);
      }, 7000);
    }
  }

  // Codex tile — rotates one synthesis line at a time behind the gold sweep.
  let codexCycleTimer: number | undefined;

  function initializeCodexTile() {
    clearInterval(codexCycleTimer);
    const tile = document.getElementById('codex-tile');
    if (!tile) return;
    const lines: string[] = JSON.parse((tile as HTMLElement).dataset.lines || '[]');
    const lineEl = document.getElementById('codex-line');
    if (!lineEl || lines.length < 2) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let index = 0;
    codexCycleTimer = window.setInterval(() => {
      index = (index + 1) % lines.length;
      tile.classList.add('is-cycling');
      window.setTimeout(() => { lineEl.textContent = lines[index]; }, 365);
      window.setTimeout(() => tile.classList.remove('is-cycling'), 800);
    }, 8000);
  }

  // Email tile — assemble the mailto only on first interaction so the
  // address never sits in the served HTML for scrapers.
  function initializeMailTile() {
    const tile = document.getElementById('mail-tile') as HTMLAnchorElement | null;
    if (!tile || tile.dataset.mailBound) return;   // guard: runs on both initial load and astro:page-load
    tile.dataset.mailBound = 'true';
    const addr = ['mailbox', ['ninjaruss', 'net'].join('.')].join('@');
    const arm = () => tile.setAttribute('href', 'mailto:' + addr);
    tile.addEventListener('pointerenter', arm, { once: true });
    tile.addEventListener('focus', arm, { once: true });
    tile.addEventListener('touchstart', arm, { once: true, passive: true });
    tile.addEventListener('click', (e) => {
      if (tile.getAttribute('href')?.startsWith('mailto:')) return;
      e.preventDefault();
      window.location.href = 'mailto:' + addr;
    });
  }

  // Whole-tile navigation for the journal tile: clicking any non-link area
  // routes to the journal. Entry links (rows, tabs, projects) handle their own
  // navigation and are left alone. A plain location assignment is used
  // deliberately — it's guaranteed to fire on a real click regardless of the
  // view-transition router's trusted-event gating.
  function initializeJournalTileNav() {
    const tile = document.querySelector('.journal-tile') as HTMLElement | null;
    if (!tile || tile.dataset.navBound) return;
    tile.dataset.navBound = 'true';
    const href = tile.dataset.tileHref || '/journal';
    tile.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) return;
      window.location.href = href;
    });
  }

  // Novel rain gauge — full rain for recent scene work, mist for outline-only,
  // still "the rain waits." past 14 quiet days. Reward accretion; never count absence.
  function initializeNovelRain() {
    const tile = document.getElementById('novel-tile');
    if (!tile) return;
    tile.classList.remove('is-raining', 'is-misting', 'is-waiting');

    const daysSince = (iso: string | undefined): number | null => {
      if (!iso) return null;
      const d = new Date(iso);
      if (isNaN(d.getTime())) return null;
      const today = new Date();
      const todayUTC = Date.UTC(today.getFullYear(), today.getMonth(), today.getDate());
      const dUTC = Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate());
      return Math.floor((todayUTC - dUTC) / 86_400_000);
    };

    const WINDOW = 14;
    const sceneDays = daysSince((tile as HTMLElement).dataset.sceneModified);
    const outlineDays = daysSince((tile as HTMLElement).dataset.outlineModified);

    // Give each drop its own position, fall speed, delay, length and opacity so
    // the rain reads as organic rather than a uniform comb of columns. Re-rolled
    // on each init (initial load + astro:page-load), so it varies every visit.
    // A small jitter around an even base keeps drops from clumping or gapping.
    const randomizeDrops = () => {
      const drops = tile.querySelectorAll<HTMLElement>('.novel-rain__drop');
      const n = drops.length || 1;
      drops.forEach((drop, i) => {
        const base = (i + 0.5) / n;                          // even slot center 0..1
        const x = Math.min(0.98, Math.max(0.02, base + (Math.random() - 0.5) * (1.4 / n)));
        drop.style.setProperty('--x', `${(x * 100).toFixed(2)}%`);
        drop.style.setProperty('--len', `${(9 + Math.random() * 26).toFixed(1)}px`);
        drop.style.setProperty('--dur', `${(0.95 + Math.random() * 1.4).toFixed(2)}s`);
        drop.style.setProperty('--delay', `${(Math.random() * 2).toFixed(2)}s`);
        drop.style.setProperty('--drop-op', (0.4 + Math.random() * 0.6).toFixed(2));
      });
    };

    if (sceneDays !== null && sceneDays <= WINDOW) {
      tile.classList.add('is-raining');
      (tile as HTMLElement).style.setProperty('--rain-strength', String(Math.max(0.2, 1 - sceneDays / WINDOW)));
      randomizeDrops();
    } else if (outlineDays !== null && outlineDays <= WINDOW) {
      tile.classList.add('is-misting');
      (tile as HTMLElement).style.setProperty('--rain-strength', String(Math.max(0.15, 0.5 * (1 - outlineDays / WINDOW))));
      randomizeDrops();
    } else {
      tile.classList.add('is-waiting');
    }
  }

  // Mouse-tracking 3D tilt for all tile types
  function initializeTilt() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!window.matchMedia('(hover: hover)').matches) return;

    const SELECTOR = '.bento-tile--interactive, .logo-tile, .image-tile, .title-tile';
    const MAX_TILT = 6;

    document.querySelectorAll<HTMLElement>(SELECTOR).forEach(tile => {
      if (tile.dataset.tiltBound) return;   // guard: runs on both initial load and astro:page-load
      tile.dataset.tiltBound = 'true';
      let rafId: number;

      tile.addEventListener('mousemove', (e) => {
        cancelAnimationFrame(rafId);
        rafId = requestAnimationFrame(() => {
          const rect = tile.getBoundingClientRect();
          const cx = rect.left + rect.width / 2;
          const cy = rect.top + rect.height / 2;
          const rx = ((e.clientY - cy) / (rect.height / 2)) * -MAX_TILT;
          const ry = ((e.clientX - cx) / (rect.width / 2)) * MAX_TILT;
          tile.style.transform = `perspective(700px) rotateX(${rx}deg) rotateY(${ry}deg) translate(-4px, -4px)`;
        });
      });

      tile.addEventListener('mouseleave', () => {
        cancelAnimationFrame(rafId);
        tile.style.transform = '';
      });
    });
  }


  // Run on initial page load
  initializeLatestTile();
  initializeCodexTile();
  initializeNovelRain();
  initializeTilt();
  initializeMailTile();
  initializeJournalTileNav();
  startLivePolling();

  // Run after each view transition navigation
  document.addEventListener('astro:page-load', () => {
    initializeLatestTile();
    initializeCodexTile();
    initializeNovelRain();
    initializeTilt();
    initializeMailTile();
    initializeJournalTileNav();
    startLivePolling();
  });

  // Clean up intervals before navigating away
  document.addEventListener('astro:before-preparation', () => {
    stopLivePolling();
    clearInterval(latestCycleTimer);
    clearInterval(codexCycleTimer);
  });
</script>
